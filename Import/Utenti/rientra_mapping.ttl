###############################################################
#  rientra_mapping.ttl  —  Rientr@ R2RML Mapping
#  GENERATO AUTOMATICAMENTE da rientra_import.py
#  Ontologia sorgente: Rientra.rdf
#  Standard: W3C R2RML (https://www.w3.org/TR/r2rml/)
#
#  Rigenera con:
#    python rientra_import.py --generate-mapping --ontology Rientra.rdf
###############################################################

@prefix rr:    <http://www.w3.org/ns/r2rml#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

@prefix foaf:  <http://www.stiima.cnr.it/FOAF-excerpt#> .
@prefix hc:    <http://www.stiima.cnr.it/RientraHC#> .
@prefix icf:   <http://www.stiima.cnr.it/ICF-exc-coreset#> .
@prefix pcb:   <http://www.stiima.cnr.it/Person-CommonBox#> .
@prefix rie:   <http://www.stiima.cnr.it/RientraOnt3Merged#> .

# ─────────────────────────────────────────────────────────────
#  MAP 1 — person → FOAF:Person
# ─────────────────────────────────────────────────────────────
<#PersonMap>
    rr:logicalTable [ rr:tableName "person" ] ;

    rr:subjectMap [
        rr:template "http://www.stiima.cnr.it/Person-CommonBox#{person_id}" ;
        rr:class foaf:Person ;
        rr:class owl:NamedIndividual
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#TIN> ;
        rr:objectMap [ rr:column "TIN" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#city> ;
        rr:objectMap [ rr:column "city" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#country> ;
        rr:objectMap [ rr:column "country" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#first_name> ;
        rr:objectMap [ rr:column "first_name" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#surname> ;
        rr:objectMap [ rr:column "surname" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#ZIPcode> ;
        rr:objectMap [
            rr:column   "zip_code" ;
            rr:datatype xsd:int
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/FOAF-excerpt#birthday> ;
        rr:objectMap [
            rr:column   "birthday" ;
            rr:datatype xsd:dateTime
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate <http://www.stiima.cnr.it/RientraOnt3Merged#isSelected> ;
        rr:objectMap [ rr:constant "false"^^xsd:boolean ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:isInHealthCondition ;
        rr:objectMap [
            rr:template "http://www.stiima.cnr.it/Person-CommonBox#HC{person_id}" ;
            rr:termType rr:IRI
        ]
    ] .


# ─────────────────────────────────────────────────────────────
#  MAP 2 — person → HC:Health_Condition
# ─────────────────────────────────────────────────────────────
<#HealthConditionMap>
    rr:logicalTable [ rr:tableName "person" ] ;

    rr:subjectMap [
        rr:template "http://www.stiima.cnr.it/Person-CommonBox#HC{person_id}" ;
        rr:class hc:Health_Condition ;
        rr:class owl:NamedIndividual
    ] .


# ─────────────────────────────────────────────────────────────
#  MAP 3 — hc_descriptor → HC:HC_Descriptor
#  Una TriplesMap per prefisso ICF (b/d/s) per instradare
#  il qualifier alla property corretta (BFqual/AP1qual/BS1qual)
# ─────────────────────────────────────────────────────────────

<#DescriptorMapB>
    rr:logicalTable [ rr:tableName "v_desc_b" ] ;

    rr:subjectMap [
        rr:template "http://www.stiima.cnr.it/RientraHC#des_{person_id}_{icf_code}" ;
        rr:class hc:HC_Descriptor ;
        rr:class owl:NamedIndividual
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:involvesICFCode ;
        rr:objectMap [
            rr:template "http://www.stiima.cnr.it/ICF-exc-coreset#{icf_code}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:BFqual ;
        rr:objectMap [
            rr:column   "qualifier" ;
            rr:datatype xsd:N31283d983fc24f848e79361320500b5a
        ]
    ] .


<#DescriptorMapD>
    rr:logicalTable [ rr:tableName "v_desc_d" ] ;

    rr:subjectMap [
        rr:template "http://www.stiima.cnr.it/RientraHC#des_{person_id}_{icf_code}" ;
        rr:class hc:HC_Descriptor ;
        rr:class owl:NamedIndividual
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:involvesICFCode ;
        rr:objectMap [
            rr:template "http://www.stiima.cnr.it/ICF-exc-coreset#{icf_code}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:AP1qual ;
        rr:objectMap [
            rr:column   "qualifier" ;
            rr:datatype xsd:Nb1d1c9c46f4a4999923345fdec6ab1c2
        ]
    ] .


<#DescriptorMapS>
    rr:logicalTable [ rr:tableName "v_desc_s" ] ;

    rr:subjectMap [
        rr:template "http://www.stiima.cnr.it/RientraHC#des_{person_id}_{icf_code}" ;
        rr:class hc:HC_Descriptor ;
        rr:class owl:NamedIndividual
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:involvesICFCode ;
        rr:objectMap [
            rr:template "http://www.stiima.cnr.it/ICF-exc-coreset#{icf_code}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:BS1qual ;
        rr:objectMap [
            rr:column   "qualifier" ;
            rr:datatype xsd:Nba69cdeba7ea42899aa196280729fae7
        ]
    ] .


# ─────────────────────────────────────────────────────────────
#  MAP 4 — v_hc_links → isDescribedBy
#  Collega Health_Condition ai suoi HC_Descriptor
# ─────────────────────────────────────────────────────────────
<#DescriptorLinkMap>
    rr:logicalTable [ rr:tableName "v_hc_links" ] ;

    rr:subjectMap [
        rr:template "http://www.stiima.cnr.it/Person-CommonBox#HC{person_id}" ;
        rr:termType rr:IRI
    ] ;

    rr:predicateObjectMap [
        rr:predicate hc:isDescribedBy ;
        rr:objectMap [
            rr:template "http://www.stiima.cnr.it/RientraHC#des_{person_id}_{icf_code}" ;
            rr:termType rr:IRI
        ]
    ] .
