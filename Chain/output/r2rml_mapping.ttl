rientra:activityPart1stQual a owl:DatatypeProperty ;
    rdfs:label "activity participation 1st qualifier"@en ;
    rdfs:comment "Qualificatore 1 per Activities and Participation: performance with assistance."@it ;
    rdfs:domain rientra:HCDescriptor ;
    rdfs:range xsd:integer .

rientra:assessedOnDate a owl:DatatypeProperty ;
    rdfs:label "assessed on date"@en ;
    rdfs:domain rientra:HealthCondition ;
    rdfs:range xsd:date .

rientra:bodyFunctionQual a owl:DatatypeProperty ;
    rdfs:label "body function qualifier"@en ;
    rdfs:comment "Qualificatore ICF 1: magnitudine della compromissione (0=nessuna, 4=completa)."@it ;
    rdfs:domain rientra:HCDescriptor ;
    rdfs:range xsd:integer .

rientra:evaluatesJob a owl:ObjectProperty ;
    rdfs:label "evaluates job"@en ;
    rdfs:domain rientra:JobEvaluation ;
    rdfs:range rientra:Job .

rientra:evaluatesWorker a owl:ObjectProperty ;
    rdfs:label "evaluates worker"@en ;
    rdfs:domain rientra:JobEvaluation ;
    rdfs:range rientra:Wheelchair_user .

rientra:evaluatorRole a owl:DatatypeProperty ;
    rdfs:label "evaluator role"@en ;
    rdfs:domain rientra:JobEvaluation ;
    rdfs:range xsd:string .

rientra:hasCategory a owl:DatatypeProperty ;
    rdfs:label "has category"@en ;
    rdfs:comment "Categoria O*NET: 'Skill' o 'Ability'."@it ;
    rdfs:domain rientra:Job_Descriptor ;
    rdfs:range xsd:string .

rientra:hasComponent a owl:DatatypeProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "Componente ICF: b=body functions, s=structures, d=activities, e=environment."@it ;
    rdfs:domain rientra:ICF_Code ;
    rdfs:range xsd:string .

rientra:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

rientra:hasDescriptorName a owl:DatatypeProperty ;
    rdfs:label "has descriptor name"@en ;
    rdfs:domain rientra:Job_Descriptor ;
    rdfs:range xsd:string .

rientra:hasICFCode a owl:DatatypeProperty ;
    rdfs:label "has ICF code"@en ;
    rdfs:comment "Il codice ICF come stringa (es. 'b730')."@it ;
    rdfs:domain rientra:ICF_Code ;
    rdfs:range xsd:string .

rientra:hasImportanceAnchor a owl:DatatypeProperty ;
    rdfs:label "has importance anchor"@en ;
    rdfs:comment "Anchor O*NET: 0=Not important, 1=Somewhat, 2=Important, 3=Very important."@it ;
    rdfs:domain rientra:Job_Descriptor ;
    rdfs:range xsd:integer .

rientra:hasJobNameInDB a owl:DatatypeProperty ;
    rdfs:label "has job name in DB"@en ;
    rdfs:comment "Nome della professione come appare nel DB istituzionale (può differire dal nome O*NET)."@it ;
    rdfs:domain rientra:Job ;
    rdfs:range xsd:string .

rientra:hasNotes a owl:DatatypeProperty ;
    rdfs:label "has notes"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

rientra:hasONETCode a owl:DatatypeProperty ;
    rdfs:label "has O*NET code"@en ;
    rdfs:comment "Codice O*NET della professione (es. '25-4011.00'). Può essere NULL se non noto."@it ;
    rdfs:domain rientra:Job ;
    rdfs:range xsd:string .

rientra:hasScore a owl:DatatypeProperty ;
    rdfs:label "has score"@en ;
    rdfs:comment "Score di importanza O*NET (0-100)."@it ;
    rdfs:domain rientra:Job_Descriptor ;
    rdfs:range xsd:integer .

rientra:hasSuitability a owl:DatatypeProperty ;
    rdfs:label "has suitability"@en ;
    rdfs:comment "Esito: 'suitable', 'suitable_with_precautions', 'not_suitable'."@it ;
    rdfs:domain rientra:JobEvaluation ;
    rdfs:range xsd:string .

rientra:involvesICFCode a owl:ObjectProperty ;
    rdfs:label "involves ICF code"@en ;
    rdfs:comment "Collega un HCDescriptor al codice ICF corrispondente."@it ;
    rdfs:domain rientra:HCDescriptor ;
    rdfs:range rientra:ICF_Code .

rientra:isDescribedBy a owl:ObjectProperty ;
    rdfs:label "is described by"@en ;
    rdfs:comment "Collega una HealthCondition ai suoi HCDescriptor."@it ;
    rdfs:domain rientra:HealthCondition ;
    rdfs:range rientra:HCDescriptor .

rientra:isDescriptorOf a owl:ObjectProperty ;
    rdfs:label "is descriptor of"@en ;
    rdfs:comment "Collega un Job_Descriptor alla professione a cui appartiene."@it ;
    rdfs:domain rientra:Job_Descriptor ;
    rdfs:range rientra:Job .

rientra:isHealthConditionOf a owl:ObjectProperty ;
    rdfs:label "is health condition of"@en ;
    rdfs:comment "Collega una HealthCondition al WU a cui appartiene."@it ;
    rdfs:domain rientra:HealthCondition ;
    rdfs:range rientra:Wheelchair_user .

rientra:matchedToONETJob a owl:ObjectProperty ;
    rdfs:label "matched to O*NET job"@en ;
    rdfs:comment "Collega un Job del DB al corrispondente Job nell'ontologia O*NET (risultato del matching)."@it ;
    rdfs:domain rientra:Job ;
    rdfs:range rientra:Job .

rientra:matchedViaLabel a owl:DatatypeProperty ;
    rdfs:label "matched via label"@en ;
    rdfs:comment "La label O*NET che ha prodotto il match migliore."@it ;
    rdfs:domain rientra:Job ;
    rdfs:range xsd:string .

rientra:matchingScore a owl:DatatypeProperty ;
    rdfs:label "matching score"@en ;
    rdfs:comment "Score di similarità prodotto dall'algoritmo di matching (0-1)."@it ;
    rdfs:domain rientra:Job ;
    rdfs:range xsd:decimal .

rientra:ICF_b130 a rientra:ICF_Code ;
    rdfs:label "Energy and drive functions"@en ;
    rientra:hasComponent "b" ;
    rientra:hasDescription "General mental functions of physiological mechanisms."^^xsd:string ;
    rientra:hasICFCode "b130" .

rientra:ICF_b140 a rientra:ICF_Code ;
    rdfs:label "Attention functions"@en ;
    rientra:hasComponent "b" ;
    rientra:hasDescription "Mental functions of focusing on an external stimulus."^^xsd:string ;
    rientra:hasICFCode "b140" .

rientra:ICF_b147 a rientra:ICF_Code ;
    rdfs:label "Psychomotor functions"@en ;
    rientra:hasComponent "b" ;
    rientra:hasDescription "Specific mental functions of control over motor events."^^xsd:string ;
    rientra:hasICFCode "b147" .

rientra:ICF_d170 a rientra:ICF_Code ;
    rdfs:label "Writing"@en ;
    rientra:hasComponent "d" ;
    rientra:hasDescription "Using symbols to convey information."^^xsd:string ;
    rientra:hasICFCode "d170" .

rientra:ICF_d430 a rientra:ICF_Code ;
    rdfs:label "Lifting and carrying objects"@en ;
    rientra:hasComponent "d" ;
    rientra:hasDescription "Raising up an object or taking it from one place to another."^^xsd:string ;
    rientra:hasICFCode "d430" .

rientra:ICF_d440 a rientra:ICF_Code ;
    rdfs:label "Fine hand use"@en ;
    rientra:hasComponent "d" ;
    rientra:hasDescription "Coordinated actions of handling objects with fingers."^^xsd:string ;
    rientra:hasICFCode "d440" .

rientra:ICF_d445 a rientra:ICF_Code ;
    rdfs:label "Hand and arm use"@en ;
    rientra:hasComponent "d" ;
    rientra:hasDescription "Coordinated actions to move objects using hands and arms."^^xsd:string ;
    rientra:hasICFCode "d445" .

rientra:WU_1 a rientra:Wheelchair_user ;
    foaf:birthday 1975 ;
    foaf:gender "M" ;
