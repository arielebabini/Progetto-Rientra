                                                                                    rdf:rest [ a rdf:List ;
                                                                                            rdf:first 9 ;
                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] .

ns1:des006 a ns1:HC_Descriptor,
        owl:NamedIndividual .

ns8:MAMatch a ns8:Match,
        owl:NamedIndividual .

ns8:hasExtremeCriticalityIn a owl:ObjectProperty ;
    owl:inverseOf ns8:isExtremelyCriticalFor .

ns8:hasGenericMatchValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns8:Match ;
    rdfs:range xsd:float .

ns8:hasMatch a owl:ObjectProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range ns8:Match .

ns8:hasModerateCriticalityIn a owl:ObjectProperty ;
    owl:inverseOf ns8:isModeratelyCriticalFor .

ns8:hasNoCriticalityIn a owl:ObjectProperty ;
    owl:inverseOf ns8:isNotCriticalFor .

ns8:hasRelevantCriticalityIn a owl:ObjectProperty ;
    owl:inverseOf ns8:isRelevantlyCriticalFor .

ns8:hasSlightCriticalityIn a owl:ObjectProperty ;
    owl:inverseOf ns8:isSlightlyCriticalFor .

ns5:b1561 a owl:Class ;
    rdfs:label "Visual perception" ;
    rdfs:subClassOf ns2:b156,
        ns5:Hearing_Loss .

ns5:b2700 a owl:Class ;
    rdfs:label "Sensitivity to temperature" ;
    ns2:description "Sensory functions of sensing cold and heat." ;
    rdfs:subClassOf ns2:b270,
        ns5:Hand_Conditions .

ns5:b2701 a owl:Class ;
    rdfs:label "Sensitivity to vibration" ;
    ns2:description "Sensory functions of sensing shaking or oscillation." ;
    rdfs:subClassOf ns2:b270,
        ns5:Hand_Conditions .

ns5:b2702 a owl:Class ;
    rdfs:label "Sensitivity to pressure" ;
    ns2:description """Sensory functions of sensing pressure against or on the skin.
Inclusions: sensitivity to touch, numbness, hypaesthesia, hyperaesthesia, paraesethesia, tingling""" ;
    rdfs:subClassOf ns2:b270,
        ns5:Hand_Conditions .

ns5:b2703 a owl:Class ;
    rdfs:label "Sensitivity to a noxious stimulus" ;
    ns2:description """Sensory functions of sensing painful or uncomfortable sensations.
Inclusions: impairments such as hypalgesia, hyperpathia, allodynia, analgesia and anaesthesia dolorosa""" ;
    rdfs:subClassOf ns2:b270,
        ns5:Hand_Conditions .

ns5:b435 a owl:Class ;
    rdfs:label "Immunological system functions" ;
    ns2:description """Functions of the body related to protection against foreign substances, including infections, by specific and non-specific immune responses.  
Inclusions: immune response (specific and non-specific); hypersensitivity reactions; functions of lymphatic vessels and nodes; functions of cell-mediated immunity, antibody-mediated immunity; response to immunization; impairments such as in autoimmunity, allergic reactions, lymphadenitis and lymphoedema""" ;
    rdfs:subClassOf ns2:Body_functions,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns5:b7100 a owl:Class ;
    rdfs:label "Mobility of a single joint" ;
    ns2:description "Functions of the range and ease of movement of one joint." ;
    rdfs:subClassOf ns2:b710,
        ns5:Hand_Conditions .

ns5:b7101 a owl:Class ;
    rdfs:label "Mobility of several joints" ;
    ns2:description "Functions of the range and ease of movement of more than one joint." ;
    rdfs:subClassOf ns2:b710,
        ns5:Hand_Conditions .

ns5:b7300 a owl:Class ;
    rdfs:label "Power of isolated muscles and muscle groups" ;
    ns2:description """Functions related to the force generated by the contraction of specific and isolated muscles and muscle groups.
Inclusions: impairments such as weakness of small muscles of feet or hands""" ;
    rdfs:subClassOf ns2:b730,
        ns5:Hand_Conditions .

ns5:b7301 a owl:Class ;
    rdfs:label "Power of muscles of one limb" ;
    ns2:description """Functions related to the force generated by the contraction of the muscles and muscle groups of one arm or leg.
Inclusions: impairments such as monoparesis and monoplegia""" ;
    rdfs:subClassOf ns2:b730,
        ns5:Hand_Conditions .

ns5:b860 a owl:Class ;
    rdfs:label "Functions of nails" ;
    ns2:description """Functions of the nails, such as protection, scratching and appearance.
Inclusions: growth and pigmentation of nails, quality of nails""" ;
    rdfs:subClassOf ns2:Body_functions,
        ns5:Hand_Conditions .

ns5:d140 a owl:Class ;
    rdfs:label "Learning to read" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns5:Hearing_Loss .

ns5:d3503 a owl:Class ;
    rdfs:label "Conversing with one person" ;
    rdfs:subClassOf ns2:d350,
        ns5:Hearing_Loss .

ns5:d3504 a owl:Class ;
    rdfs:label "Conversing with many people" ;
    rdfs:subClassOf ns2:d350,
        ns5:Hearing_Loss .

ns5:d4455 a owl:Class ;
    rdfs:label "Catching" ;
    rdfs:subClassOf ns2:d445,
        ns5:Hand_Conditions .

ns5:d950 a owl:Class ;
    rdfs:label "Political life and citizenship" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns5:Hearing_Loss .

ns5:s240 a owl:Class ;
    rdfs:label "Structure of external ear" ;
    rdfs:subClassOf ns2:Body_structures,
        ns5:Hearing_Loss .

ns5:s250 a owl:Class ;
    rdfs:label "Structure of middle ear" ;
    rdfs:subClassOf ns2:Body_structures,
        ns5:Hearing_Loss .

ns5:s260 a owl:Class ;
    rdfs:label "Structure of inner ear" ;
    rdfs:subClassOf ns2:Body_structures .

ns5:s740 a owl:Class ;
    rdfs:label "Structure of pelvic region" ;
    rdfs:subClassOf ns2:Body_structures,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns5:s770 a owl:Class ;
    rdfs:label "Additional musculoskeletal structures related to movement" ;
    rdfs:subClassOf ns2:Body_structures,
        ns5:Hand_Conditions,
        ns5:Low_Back_Pain .

ns5:s830 a owl:Class ;
    rdfs:label "Structure of nails" ;
    rdfs:subClassOf ns2:Body_structures,
        ns5:Hand_Conditions .

<http://www.stiima.cnr.it/RientraReturns> a owl:Ontology ;
    rdfs:comment """A box importing:
- JobList
- SkAb for the full description and translation of Jobs with ICF.

Developed for "Rientr@" ontology by STIIMA-CNR.""",
        """Added professions:
- Dancers
- Travel guides
- Receptionists and Information Clerks
- Insurance policy processing Clerks
- Insurance Claims Clerks
- Billing, cost and rate Clerks
- Bookkeeping, Accounting, and Auditing Clerks

On February 2022.""",
        """An excerpt od Friend Of a Friend (FOAF) ontology for people's description.
Developed for "Rientr@" ontology by STIIMA-CNR.

Full FOAF: http://xmlns.com/foaf/spec/""",
        "Based on Standard Occupation Classification (2016 version) available on O*NET web site: https://www.onetonline.org/",
        """Common Box for Person description importing:
- Health Condition (RientraHC)
- FOAF (FOAF-excerpt)
- ICF (excerpt and core sets)""",
        """Developed on: 29 November 2021.
Latest revision: 30 april 2024.
Version: 3.1.""",
        """Excerpt of ICF developend for the "Rientr@" project by STIIMA-CNR.
It contains the classes composing:
- Traumatic Brain Injury comprehensive core set
- Spinal Cord Injury (Long Term/Chronic) comprehensive core set
- Stroke comprehensive core set
- Vocational Rehabilitation comprehensive core set
- Codes description, Inclusion and Exclusions added

Full ICF ontology: https://www.bioportal.bioontology.org/ontologies/ICF (updated May 2012).""",
        """Excerpt of O*NET "Skills" and "Abilities" for descriptions of jobs.
Developed for "Rientr@" ontology by STIIMA-CNR.""",
        """Health Condition Ontology for modelling wheelchair users' health conditions.
Developed for "Rientr@" ontology by STIIMA-CNR.""",
        """List of jobs to be matched with the wheelchair users.
Developed for "Rientr@" ontology by STIIMA-CNR.""",
        """Revised on 08 June 2020.
Translation of O*NET in ICF deeply revised (elimination of the "translator" individuals and classes):
- SWRL "matrix" revision: specific scores for Skills and Abilities according to the new version of the matrix (Risk factor);
- 8 new SWRL rules deployed.""",
        """Rientra Ontology importing:

1. Person ontology (Common Box), which imports:
      a) Health Conditions (RientraHC)
      b) FOAF (FOAF excerpt)
      c) ICF (excerpt and core sets)

2. Job Description (Common Box), which imports:
      d) Job List
      e) Skills and Abilities (SkAb)""" .

<http://www.stiima.cnr.it/RientraReturns#1801> a owl:Class ;
    rdfs:label "Body image" ;
    ns2:description """Specific mental functions related to the representation and awareness of one's body.
Inclusions: impairments such as phantom limb and feeling too fat or too thin""" ;
    rdfs:subClassOf ns2:b180,
        ns5:Hand_Conditions .

ns6:Equipment_Maintenance a owl:Class ;
    ns4:Net_definition "Performing routine maintenance on equipment and determining when and what kind of maintenance is needed." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Equipment_Selection a owl:Class ;
    ns4:Net_definition "Determining the kind of tools and equipment needed to do a job." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Installation a owl:Class ;
    ns4:Net_definition "Installing equipment, machines, wiring, or programs to meet specifications." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns4:Net_definition a owl:AnnotationProperty .

ns6:Operation_Analysis a owl:Class ;
    ns4:Net_definition "Analyzing needs and product requirements to create a design." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Operation_Monitoring a owl:Class ;
    ns4:Net_definition "Watching gauges, dials, or other indicators to make sure a machine is working properly." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Operation_and_Control a owl:Class ;
    ns4:Net_definition "Controlling operations of equipment or systems." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Programming a owl:Class ;
    ns4:Net_definition "Writing computer programs for various purposes." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Quality_Control_Analysis a owl:Class ;
    ns4:Net_definition "Conducting tests and inspections of products, services, or processes to evaluate quality or performance." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Repairing a owl:Class ;
    ns4:Net_definition "Repairing machines or systems using the needed tools." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Technology_Design a owl:Class ;
    ns4:Net_definition "Generating or adapting equipment and technology to serve user needs." ;
    rdfs:subClassOf ns6:Technical_Skills .

ns6:Troubleshooting a owl:Class ;
    rdfs:subClassOf ns6:Technical_Skills .

rientra:ExtJob_ext01 a rientra:Job ;
    rientra:hasDescription "Perform routine accounting, bookkeeping, and payroll duties. Compute, classify, and record numerical data to keep financial records complete and accurate. Check figures, postings, and documents for correctness, and operate calculators, computers, or accounting software to process business transactions."^^xsd:string ;
    rientra:hasExternalID "ext01"^^xsd:string ;
    rientra:hasJobNameInDB "Accounting clerk"^^xsd:string ;
    rientra:matchedToONETJob_S1 joblist:Billing_cost_and_rate_clerks ;
    rientra:matchedToONETJob_S2 joblist:Bookkeping_accounting_and_auditing_clerks ;
    rientra:matchedViaLabel_S1 "Accounting Clerk"^^xsd:string ;
    rientra:matchingScore_S1 1.0 ;
    rientra:matchingScore_S2 0.8629 .

rientra:ExtJob_ext02 a rientra:Job ;
    rientra:hasDescription "Plan, create, manage, and update digital content for websites and online platforms. Coordinate the development of text, images, and multimedia materials to ensure consistency with organizational goals. Monitor content performance, maintain site structure, and collaborate with designers, editors, and marketing staff."^^xsd:string ;
    rientra:hasExternalID "ext02"^^xsd:string ;
    rientra:hasJobNameInDB "Content manager web"^^xsd:string ;
    rientra:matchedToONETJob_S1 joblist:Billing_cost_and_rate_clerks ;
    rientra:matchedViaLabel_S1 "Office Manager"^^xsd:string ;
    rientra:matchingScore_S1 0.3697 .

rientra:ExtJob_ext03 a rientra:Job ;
    rientra:hasDescription "Collect, process, and analyze data to identify trends, patterns, and relationships. Prepare reports, charts, and visualizations to support decision-making. Ensure data accuracy and integrity, and use statistical or analytical tools to interpret quantitative information."^^xsd:string ;
    rientra:hasExternalID "ext03"^^xsd:string ;
    rientra:hasJobNameInDB "Data analyst"^^xsd:string ;
    rientra:matchedToONETJob_S1 joblist:Insurance_policy_processing_clerks ;
    rientra:matchedViaLabel_S1 "compiling data on insurance policy changes"^^xsd:string ;
    rientra:matchingScore_S1 0.2643 .

rientra:ExtJob_ext04 a rientra:Job ;
    rientra:hasDescription "Enter numerical and text data into computer systems or databases using keyboards, data recorders, or scanners. Verify accuracy of data, correct errors, and maintain confidentiality of information. May compile, sort, and organize source documents."^^xsd:string ;
    rientra:hasExternalID "ext04"^^xsd:string ;
    rientra:hasJobNameInDB "Data entry"^^xsd:string ;
    rientra:matchedToONETJob_S1 joblist:Insurance_policy_processing_clerks ;
    rientra:matchedViaLabel_S1 "compiling data on insurance policy changes"^^xsd:string ;
    rientra:matchingScore_S1 0.2595 .

rientra:ExtJob_ext05 a rientra:Job ;
    rientra:hasDescription "Input, update, and maintain data in electronic systems following established procedures. Review source documents for completeness, check data for errors, and make corrections as needed. Perform basic clerical tasks related to data management."^^xsd:string ;
    rientra:hasExternalID "ext05"^^xsd:string ;
    rientra:hasJobNameInDB "Data entry employee"^^xsd:string ;
    rientra:matchedToONETJob_S1 joblist:Insurance_policy_processing_clerks ;
    rientra:matchedToONETJob_S2 joblist:Bookkeping_accounting_and_auditing_clerks ;
    rientra:matchedViaLabel_S1 "compiling data on insurance policy changes"^^xsd:string ;
    rientra:matchingScore_S1 0.2196 ;
    rientra:matchingScore_S2 0.5559 .

rientra:ExtJob_ext06 a rientra:Job ;
    rientra:hasDescription "Develop and apply statistical, mathematical, and computational techniques to analyze large and complex data sets. Build models to extract insights, make predictions, and support strategic decisions. Communicate analytical results through reports, visualizations, and presentations."^^xsd:string ;
    rientra:hasExternalID "ext06"^^xsd:string ;
    rientra:hasJobNameInDB "Data scientist"^^xsd:string ;
    rientra:matchedToONETJob_S1 joblist:Insurance_policy_processing_clerks ;
    rientra:matchedViaLabel_S1 "compiling data on insurance policy changes"^^xsd:string ;
    rientra:matchingScore_S1 0.2643 .

