@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns9:Person_with_impairment a owl:Class ;
    rdfs:subClassOf ns9:Person ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:isInHealthCondition ;
            owl:someValuesFrom ns1:Health_Condition_with_impairment ] .

ns9:TIN a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:string .

ns9:ZIPcode a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:int .

ns9:birthday a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:dateTime .

ns9:city a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:string .

ns9:country a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:string .

ns9:first_name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:string .

ns9:surname a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:string .

ns2:description a owl:AnnotationProperty .

ns2:descrizioneITA a owl:AnnotationProperty .

ns2:nomeIta a owl:AnnotationProperty .

<http://www.stiima.cnr.it/JobDescription#isSlightlyCriticalFor> a owl:ObjectProperty ;
    rdfs:domain ns6:Abilities,
        ns6:Skills .

ns7:Net_job_titles a owl:AnnotationProperty .

ns7:Net_short_description a owl:AnnotationProperty .

joblist:SOC_Code a owl:AnnotationProperty .

