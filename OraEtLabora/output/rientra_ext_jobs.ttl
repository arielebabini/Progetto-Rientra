        owl:NamedIndividual ;
    rdfs:label "Global psychosocial functions" ;
    ns2:description """General mental functions, as they develop over the life span, required to understand and constructively integrate the mental functions that lead to the formation of the personal skills needed to establish reciprocal social interactions, in terms of both meaning and purpose.
Inclusions: such as in autism""" ;
    ns2:descrizioneITA """Funzioni mentali generali, che si sviluppano nel corso della vita, richieste per capire e integrare in modo costruttivo le funzioni mentali che portano alla formazione delle abilitÃ  interpersonali necessarie per stabilire interazioni sociali reciproche, in termini sia di significato che di risultato.

Inclusione: come nellâ€™autismo""" ;
    ns2:nomeIta "Funzioni psicosociali globali" ;
    rdfs:subClassOf ns2:Body_functions .

ns2:b1261 a ns2:b1261,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Agreeableness" ;
    ns2:description "Mental functions that produce a personal disposition that is cooperative, amicable, and accomodating, as contrasted to being unfriendly, oppositional and defiant." ;
    rdfs:subClassOf ns2:b126 .

ns2:b1400 a ns2:b1400,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sustaining attention" ;
    ns2:description "Mental functions that produce concentration for the period of time required." ;
    rdfs:subClassOf ns2:b140 .

ns2:b1401 a ns2:b1401,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Shifting attention" ;
    ns2:description "Mental functions that permit refocusing concentration from one stimulus to another." ;
    rdfs:subClassOf ns2:b140 .

ns2:b1440 a ns2:b1440,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Short-term memory" ;
    ns2:description "Mental functions that produce a temporary, disruptable memory store of around 30 seconds duration from which information is lost if not consolidated into long-term memory." ;
    rdfs:subClassOf ns2:b144 .

ns2:b1441 a ns2:b1441,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Long-term memory" ;
    ns2:description "Mental functions that produce a memory system permitting the long-term storage of information from short-term memory and both autobiographical memory for past events and semantic memory for language and facts." ;
    rdfs:subClassOf ns2:b144 .

ns2:b1442 a ns2:b1442,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Retrieval and processing of memory" ;
    ns2:description "Specific mental functions of recalling information stored in long-term memory and bringing it into awareness." ;
    rdfs:subClassOf ns2:b144 .

ns2:b1560 a ns2:b1560,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Auditory perception" ;
    ns2:description "Mental functions involved in discriminating sounds, tones, pitches and other acoustic stimuli." ;
    rdfs:subClassOf ns2:b156,
        ns5:Hearing_Loss .

ns2:b1600 a ns2:b1600,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pace of thought" ;
    ns2:description "Mental functions that govern speed of the thinking process." ;
    rdfs:subClassOf ns2:b160 .

ns2:b1601 a ns2:b1601,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Form of thought" ;
    ns2:description """Mental functions that organize the thinking process as to its coherence and logic.
Inclusions: impairments of ideational perseveration, tangentiality and circumstantiality""" ;
    rdfs:subClassOf ns2:b160 .

ns2:b1640 a ns2:b1640,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Abstraction" ;
    ns2:description "Mental functions of creating general ideas, qualities or characteristics out of, and distinct from, concrete realities, specific objects or actual instances." ;
    rdfs:subClassOf ns2:b164 .

ns2:b1641 a ns2:b1641,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Organization and planning" ;
    ns2:description "Mental functions of coordinating parts into a whole, of systematizing; the mental function involved in developing a method of proceeding or acting." ;
    rdfs:subClassOf ns2:b164 .

ns2:b1642 a ns2:b1642,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Time management" ;
    ns2:description "Mental functions of ordering events in chronological sequence, allocating amounts of time to events and activities." ;
    rdfs:subClassOf ns2:b164 .

ns2:b1643 a ns2:b1643,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Cognitive flexibility" ;
    ns2:description "Mental functions of changing strategies, or shifting mental sets, especially as involved in problem-solving." ;
    rdfs:subClassOf ns2:b164 .

ns2:b1645 a ns2:b1645,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Judgement" ;
    ns2:description "Mental functions involved in discriminating between and evaluating different options, such as those involved in forming an opinion." ;
    rdfs:subClassOf ns2:b164 .

ns2:b1646 a ns2:b1646,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Problem Solving" ;
    ns2:description "Mental functions of identifying, analysing, and integrating incongruent or conflicting information into a solution." ;
    rdfs:subClassOf ns2:b164 .

ns2:b16700 a ns2:b16700,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Reception of spoken language" ;
    ns2:description "Mental functions of decoding spoken messages to obtain their meaning." ;
    rdfs:subClassOf ns2:b1670 .

ns2:b1720 a ns2:b1720,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Simple calculation" ;
    ns2:description "Mental functions of computing with numbers, such as addition, subtraction, multiplication and division." ;
    rdfs:subClassOf ns2:b172 .

ns2:b1721 a ns2:b1721,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Complex calculation" ;
    ns2:description "Mental functions of translating word problems into arithmetic procedures, translating mathematical formulas into arithmetic procedures, and other complex manipulations involving numbers." ;
    rdfs:subClassOf ns2:b172 .

ns2:b176 a ns2:b176,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Mental functions of sequencing complex movements" ;
    ns2:description """Specific mental functions of sequencing and co-ordinating complex, purposeful movements.
Inclusions: impairements such as in ideation, ideomotor, dressing, oculomotor, speech apraxia
Exclusions: psychomotor functions (b147); higher-level cognitive functions (b164); Chapter 7 Neuromusculoskeletal and Movement Related Functions (b7)""" ;
    ns2:descrizioneITA """Funzioni mentali specifiche del mettere in sequenza e coordinare movimenti complessi e finalizzati.

Inclusioni: menomazioni come nellâ€™aprassia ideatoria, ideomotoria, del vestirsi, oculomotoria e verbale

Esclusioni: funzioni psicomotorie (b147); funzioni cognitive di livello superiore (b164); Capitolo 7 â€“ Funzioni neuro-muscoloscheletriche e correlate al movimento""" ;
    ns2:nomeIta "Funzione mentale di sequenza dei movimenti complessi" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke .

ns2:b210 a ns2:b210,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Seeing functions" ;
    ns2:description """Sensory functions relating to sensing the presence of light and sensing the form, size, shape and colour of the visual stimuli.
Inclusions: visual acuity functions; visual field functions; quality of vision; functions of sensing light and colour, visual acuity of distant and near vision, monocular and binocular vision; visual picture quality; impairments such as myopia, hypermetropia, astigmatism, hemianopia, colour-blindness, tunnel vision, central and peripheral scotoma, diplopia, night blindness and impaired adaptability to light
Exclusions: perceptual functions (b156)""" ;
    ns2:descrizioneITA """Funzioni sensoriali relative alla percezione della presenza della luce e dellâ€™aspetto, dimensione, forma e colore degli stimoli visivi.

Inclusioni: funzioni dellâ€™acuitÃ  visiva; funzioni del campo visivo; qualitÃ  della visione; funzioni relative alla percezione della luce e del colore, acuitÃ  visiva della visione da lontano e da vicino, visione monoculare e binoculare; qualitÃ  dellâ€™immagine visiva; menomazioni come miopia, ipermetropia, astigmatismo,
emianopsia, cecitÃ  ai colori, visione a tunnel, scotoma centrale e periferico, diplopia, nictalopia e ridotta adattabilitÃ  alla luce

Esclusione: funzioni percettive (b156)""" ;
    ns2:nomeIta "Funzioni della vista" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:b21000 a ns2:b21000,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Binocular acuity of distant vision" ;
    ns2:description "Seeing functions of sensing size, form and contour using both eyes for objects distant from the eye." ;
    rdfs:subClassOf ns2:b2100 .

ns2:b21001 a ns2:b21001,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Monocular acuity of distant vision" ;
    ns2:description "Seeing functions of sensing size, form and contour using either right or left eye alone, for objects distant from the eye." ;
    rdfs:subClassOf ns2:b2100 .

ns2:b21002 a ns2:b21002,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Binocular acuity of near vision" ;
    ns2:description "Seeing functions of sensing size, form and contour, using both eyes, for objects close to the eye." ;
    rdfs:subClassOf ns2:b2100 .

ns2:b21003 a ns2:b21003,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Monocular acuity of near vision" ;
    ns2:description "Seeing functions of sensing size, form and contour, using either right or left eye alone, for objects close to the eye." ;
    rdfs:subClassOf ns2:b2100 .

ns2:b2101 a ns2:b2101,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Visual field functions" ;
    ns2:description """Seeing functions related to the entire area that can be seen with fixation of gaze.
Inclusions: impairments such as in scotoma, tunnel vision, anopsia""" ;
    rdfs:subClassOf ns2:b210 .

ns2:b2102 a ns2:b2102,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Quality of vision" ;
    ns2:description "Seeing functions involving light sensitivity, colour vision, contrast sensitivity and the overall quality of the picture." ;
    rdfs:subClassOf ns2:b210 .

ns2:b21021 a ns2:b21021,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Colour vision" ;
    ns2:description "Seeing functions of differentiating and matching colours." ;
    rdfs:subClassOf ns2:b2102 .

ns2:b21022 a ns2:b21022,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Contrast sensitivity" ;
    ns2:description "Seeing functions of separating figure from ground, involving the minimum amount of luminance required." ;
    rdfs:subClassOf ns2:b2102 .

ns2:b230 a ns2:b230,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Hearing functions" ;
    ns2:description """Sensory functions relating to sensing the presence of sounds and discriminating the location, pitch, loudness and quality of sounds.
Inclusions: functions of hearing, auditory discrimination, localization of sound source, lateralization of sound, speech discrimination; impairments such as deafness, hearing impairment and hearing loss
Exclusions: perceptual functions (b156) and mental functions of language (b167)""" ;
    ns2:descrizioneITA """Funzioni sensoriali relative alla percezione della presenza di suoni e alla discriminazione della loro localizzazione, tono, intensitÃ  e qualitÃ .

Inclusioni: funzioni uditive, discriminazione uditiva, localizzazione della fonte del suono, lateralizzazione del suono, discriminazione delle parole; menomazioni come sorditÃ , menomazione dellâ€™udito e perdita dellâ€™udito

Esclusioni: funzioni percettive (b156) e funzioni mentali del
linguaggio (b167)""" ;
    ns2:nomeIta "Funzioni uditive" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Vocational_Rehabilitation .

ns2:b2301 a ns2:b2301,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sound discrimination" ;
    ns2:description "Sensory functions relating to sensing the presence of sound involving the differentiation of ground and binaural synthesis, separation and blending." ;
    rdfs:subClassOf ns2:b230,
        ns5:Hearing_Loss .

ns2:b2302 a ns2:b2302,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Localization of sound source" ;
    ns2:description "Sensory functions relating to determining the location of the source of sound." ;
    rdfs:subClassOf ns2:b230,
        ns5:Hearing_Loss .

ns2:b2303 a ns2:b2303,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Lateralization of sound" ;
    ns2:description "Sensory functions relating to determining whether the sound is coming from right or the left side." ;
    rdfs:subClassOf ns2:b230 .

ns2:b2304 a ns2:b2304,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Speech discrimination" ;
    ns2:description "Sensory functions relating to determining spoken language and distinguishing it from other sounds." ;
    rdfs:subClassOf ns2:b230,
        ns5:Hearing_Loss .

ns2:b2351 a ns2:b2351,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Vestibular function of balance" ;
    ns2:description "Sensory functions of the inner ear related to determining the balance of the body." ;
    rdfs:subClassOf ns2:b235 .

ns2:b320 a ns2:b320,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Articulation functions" ;
    ns2:description """Functions of the production of speech sounds.
Inclusions: functions of enunciation, articulation of phonemes; spastic, ataxic, flaccid dysarthria; anarthria
Exclusions: mental functions of language (b167); voice functions (b310)""" ;
    ns2:descrizioneITA """Funzioni della produzione di suoni linguistici.

Inclusioni: funzioni di enunciazione, articolazione di fonemi; disartria spastica, atassica, flaccida; anartria

Esclusioni: funzioni mentali del linguaggio (b167); funzioni della voce (b310)""" ;
    ns2:nomeIta "Funzioni dellâ€™articolazione della voce" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hearing_Loss .

ns2:b330 a ns2:b330,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Fluency and rhythm of speech functions" ;
    ns2:description """Functions of the production of flow and tempo of speech.
Inclusions: functions of fluency, rhythm, speed and melody of speech; prosody and intonation; impairments such as stuttering, stammering, cluttering, bradylalia and tachylalia
Exclusions: mental functions of language (b167); voice functions (b310); articulation functions (b320)""" ;
    ns2:descrizioneITA """Funzioni della produzione del flusso e del tempo dellâ€™eloquio.

Inclusioni: funzioni della fluiditÃ , del ritmo, della velocitÃ  e della melodia dellâ€™eloquio; prosodia e intonazione; menomazioni come balbuzie, farfugliamento, disritmia, bradilalia e tachilalia

Esclusioni: funzioni mentali del linguaggio (b167); funzioni della voce (b310); funzioni dellâ€™articolazione della voce (b320)""" ;
    ns2:nomeIta "Funzioni della fluiditÃ  e del ritmo dellâ€™eloquio" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hearing_Loss .

ns2:b4550 a ns2:b4550,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "General physical endurance" ;
    ns2:description "Functions related to the general level of tolerance of physical exercise or stamina." ;
    rdfs:subClassOf ns2:b455 .

ns2:b7305 a ns2:b7305,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Power of muscles of the trunk" ;
    ns2:description "Functions related to the force generated by the contraction of muscles and muscle groups in the trunk." ;
    rdfs:subClassOf ns2:b730 .

ns2:b7306 a ns2:b7306,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Power of all muscles of the body" ;
    ns2:description """Functions related to the force generated by the contraction of all muscles and muscle groups of the body.
Inclusions: impairments such as akinetic mutism""" ;
    rdfs:subClassOf ns2:b730 .

ns2:b735 a ns2:b735,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Muscle tone functions" ;
    ns2:description """Functions related to the tension present in the resting muscles and the resistance offered when trying to move the muscles passively.
Inclusions: functions associated with the tension of isolated muscles and muscle groups, muscles of one limb, one side of the body and the lower half of the body, muscles of all limbs, muscles of the trunk, and all muscles of the body, impairments such as hypotonia, hypertonia and muscle spasticity, myotonia and paramyotonia
Exclusions: muscle power functions (b730); muscle endurance functions (b740)""" ;
    ns2:descrizioneITA """Funzioni correlate alla tensione presente nei muscoli a riposo e alla resistenza opposta quando si cerca di muovere i muscoli passivamente.

Inclusioni: funzioni correlate alla tensione di muscoli isolati e di gruppi di muscoli, dei muscoli di un arto, di un lato del corpo e della metÃ  inferiore del corpo, dei muscoli di tutti gli arti, dei muscoli del tronco e di tutti i muscoli del corpo; menomazioni come ipotonia, ipertonia e spasticitÃ  muscolare

Esclusioni: funzioni della forza muscolare (b730); funzioni della resistenza muscolare (b740)""" ;
    ns2:nomeIta "Funzioni del tono muscolare" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hand_Conditions,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:b7401 a ns2:b7401,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Endurance of muscle groups" ;
    ns2:description """Functions related to sustaining muscle contraction of isolated muscle groups for the required period of time.
Inclusions: impairments associated with monoparesis, monoplegia, hemiparesis and hemiplegia, paraparesis and paraplegia""" ;
    rdfs:subClassOf ns2:b740 .

ns2:b755 a ns2:b755,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Involuntary movement reaction functions" ;
    ns2:description """Functions of involuntary contractions of large muscles or the whole body induced by body position, balance and threatening stimuli.
Inclusions: functions of postural reactions, righting reactions, body adjustment reactions, balance reactions, supporting reactions, defensive reactions
Exclusions: motor reflex functions (b750)""" ;
    ns2:descrizioneITA """Funzioni delle contrazioni involontarie di grandi muscoli o di tutto il corpo indotte da stimoli della posizione del corpo, dellâ€™equilibrio e di minaccia.

Inclusioni: funzioni delle reazioni posturali, di raddrizzamento, di adattamento del corpo, di equilibrio, di sostegno, di difesa

Esclusione: funzioni del riflesso motorio (b750)""" ;
    ns2:nomeIta "Funzioni della reazione di movimento involontario" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:b7603 a ns2:b7603,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Supportive functions of arm or leg" ;
    ns2:description "Functions associated with control over and coordination of voluntary movements by placing weight either on the arms (elbows or hands) or on the legs (knees or feet)." ;
    rdfs:subClassOf ns2:b760 .

ns2:b770 a ns2:b770,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Gait pattern functions" ;
    ns2:description """Functions of movement patterns associated with walking, running or other whole body movements.
Inclusions: walking patterns and running patterns; impairments such as spastic gait, hemiplegic gait, paraplegic gait, asymmetric gait, limping and stiff gait pattern
Exclusions: muscle power functions (b730); muscle tone functions (b735); control of voluntary movement functions (b760); involuntary movement functions (b765)""" ;
    ns2:descrizioneITA """Funzioni di pattern di movimento associati al camminare, correre o ad altri movimenti di tutto il corpo.

Inclusioni: pattern della deambulazione e della corsa; menomazioni come pattern dellâ€™andatura spastica, emiplegica, paraplegica, asimmetrica, zoppicante e rigida

Esclusione: funzioni della forza muscolare (b730); funzioni del tono muscolare (b735); funzioni di controllo del movimento volontario (b760); funzioni del movimento involontario (b765)""" ;
    ns2:nomeIta "Funzioni del pattern dellâ€™andatura" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d160 a ns2:d160,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Focusing attention" ;
    ns2:description "Intentionally focusing on specific stimuli, such as by filtering out distracting noises."@en ;
    ns2:descrizioneITA "Focalizzarsi intenzionalmente su stimoli specifici, come ignorare i rumori distraenti." ;
    ns2:nomeIta "Focalizzare lâ€™attenzione" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:d166 a ns2:d166,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Reading" ;
    ns2:description """Performing activities involved in the comprehension and interpretation of written language (e.g. books, instructions or newspapers in text or Braille), for the purpose of obtaining general knowledge or specific information.

Exclusions: learning to read (d140)"""@en ;
    ns2:descrizioneITA """AttivitÃ  di performance coinvolte nella comprensione e nellâ€™interpretazione del linguaggio scritto (ad esempio libri, istruzioni o giornali in testo o in Braille), con lo scopo di acquisire conoscenze generali o informazioni specifiche.

Esclusione: imparare a leggere (d140)""" ;
    ns2:nomeIta "Lettura" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation .

ns2:d170 a ns2:d170,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Writing" ;
    ns2:description """Using or producing symbols or language to convey information, such as producing a written record of events or ideas or drafting a letter.

Exclusions: learning to write (d145)"""@en ;
    ns2:descrizioneITA """Utilizzare o produrre simboli o linguaggio per comunicare informazioni, come produrre una documentazione scritta di eventi o idee o scrivere una lettera.

Esclusione: imparare a scrivere (d145)""" ;
    ns2:nomeIta "Scrittura" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions .

ns2:d177 a ns2:d177,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Making decisions" ;
    ns2:description """Making a choice among options, implementing the choice, and evaluating the effects of the choice, such as selecting and purchasing a specific item, or deciding to undertake and undertaking one task from among several tasks that need to be done.

Exclusions: thinking (d163); solving problems (d175)"""@en ;
    ns2:descrizioneITA """Effettuare una scelta tra piÃ¹ opzioni, metterla in atto e valutarne le conseguenze, come scegliere e acquistare un prodotto specifico, o decidere di intraprendere un compito tra vari altri che devono essere svolti.

Esclusioni: pensiero (d163); risoluzione di problemi (d175)""" ;
    ns2:nomeIta "Prendere decisioni" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d2400 a ns2:d2400,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Handling responsibilities" ;
    ns2:description "Carrying out simple or complex and coordinated actions to manage the duties of task performance and to assess the requirements of these duties."@en ;
    rdfs:subClassOf ns2:d240 .

ns2:d310 a ns2:d310,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Communicating with - receiving - spoken messages" ;
    ns2:description """Comprehending literal and implied meanings of messages in spoken language, such as understanding that a statement asserts a fact or is an idiomatic expression.

Inclusions: communicating with - receiving - simple spoken messages, complex spoken messages"""@en ;
    ns2:descrizioneITA "Comprendere i significati letterali e impliciti dei messaggi nel linguaggio parlato, come comprendere che unâ€™affermazione sostiene un fatto o Ã¨ unâ€™espressione idiomatica." ;
    ns2:nomeIta "Comunicare con - ricevere - messaggi verbali" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d325 a ns2:d325,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Communicating with - receiving - written messages" ;
    ns2:description "Comprehending the literal and implied meanings of messages that are conveyed through written language (including Braille), such as following political events in the daily newspaper or understanding the intent of religious scripture."@en ;
    ns2:descrizioneITA "Comprendere il significato letterale e implicito di messaggi che vengono comunicati tramite il linguaggio scritto (incluso il Braille), come seguire gli eventi politici sui quotidiani o comprendere le intenzioni dei testi sacri." ;
    ns2:nomeIta "Comunicare con - ricevere - messaggi scritti" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke .

ns2:d3300 a ns2:d3300,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Producing meaningful sounds" ;
    ns2:description "Using single words to label objects, persons or actions such as ball, mommy, bye-bye."@en ;
    rdfs:subClassOf ns2:d330 .

ns2:d3301 a ns2:d3301,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Producing simple spoken messages" ;
    ns2:description "Using words to produce simple spoken messages such as single or few words or expressing a need (e.g. I want ...) or feeling (e.g., I like ...)."@en ;
    rdfs:subClassOf ns2:d330 .

ns2:d3302 a ns2:d3302,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Producing complex spoken messages" ;
    ns2:description "Using words to produce complex spoken messages (complete sentences) such as giving an explanation or asking for directions."@en ;
    rdfs:subClassOf ns2:d330 .

ns2:d345 a ns2:d345,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Writing messages" ;
    ns2:description "Producing the literal and implied meanings of messages that are conveyed through written language, such as writing a letter to a friend."@en ;
    ns2:descrizioneITA "Produrre il significato letterale e implicito di messaggi che vengono comunicati tramite il linguaggio scritto, come scrivere una lettera a un amico." ;
    ns2:nomeIta "Scrivere messaggi" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury .

ns2:d440 a ns2:d440,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Fine hand use" ;
    ns2:description """Performing the coordinated actions of handling objects, picking up, manipulating and releasing them using one's hand, fingers and thumb, such as required to lift coins off a table or turn a dial or knob.

Inclusions: picking up, grasping, manipulating and releasing

Exclusions: lifting and carrying objects (d430)"""@en ;
    ns2:descrizioneITA """Compiere le azioni coordinate del maneggiare oggetti, raccoglierli, manipolarli e lasciarli andare usando una mano, dita e pollice, come necessario per raccogliere delle monete da un tavolo o per comporre un numero al telefono o girare una maniglia.

Inclusioni: raccogliere, afferrare, manipolare e lasciare

Esclusione: sollevare e trasportare oggetti (d430)""" ;
    ns2:nomeIta "Uso fine della mano" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d4402 a ns2:d4402,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Manipulating" ;
    ns2:description "Using fingers and hands to exert control over, direct or guide something, such as when handling coins or other small objects, such as scissors, shoe laces, pencils, chopsticks, knives and forks."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d440,
        ns5:Hand_Conditions .

ns2:d455 a ns2:d455,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Moving around" ;
    ns2:description """Moving the whole body from one place to another by means other than walking, such as climbing over a rock or running down a street, skipping, scampering, jumping, somersaulting or running around obstacles.

Inclusions: crawling, climbing, running, jogging, jumping, and swimming

Exclusions: transferring oneself (d420); walking (d450)"""@en ;
    ns2:descrizioneITA """Trasferire tutto il corpo da un posto allâ€™altro con modalitÃ  diverse dal camminare, come arrampicarsi su una roccia o correre per la strada, saltellare, scorrazzare, saltare, fare capriole o correre attorno a ostacoli.

Inclusioni: strisciare, salire, correre, fare jogging, saltare e nuotare

Esclusioni: trasferirsi (d420); camminare (d450)""" ;
    ns2:nomeIta "Spostarsi" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions .

ns2:d720 a ns2:d720,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Complex interpersonal interactions" ;
    ns2:description """Maintaining and managing interactions with other people, in a contextually and socially appropriate manner, such as by regulating emotions and impulses, controlling verbal and physical aggression, acting independently in social interactions, and acting in accordance with social rules and conventions, when for example playing, studying or working with others.

Inclusions: forming and terminating relationship; regulating behaviours within interactions; interacting according to social rules; and maintaining social space."""@en ;
    ns2:descrizioneITA """Mantenere e gestire le interazioni con gli altri, in un modo contestualmente e socialmente adeguato, come nel regolare le emozioni e gli impulsi, controllare lâ€™aggressione verbale e fisica, agire in maniera indipendente nelle interazioni sociali e agire secondo i ruoli e le convenzioni sociali.

Inclusioni: formare e porre termine a relazioni; regolare i comportamenti nelle interazioni; interagire secondo le regole sociali; mantenere la distanza sociale""" ;
    ns2:nomeIta "Interazioni interpersonali complesse" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions,
        ns5:Hearing_Loss .

ns2:d865 a ns2:d865,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Complex economic transactions" ;
    ns2:description "Engaging in any form of complex economic transaction that involves the exchange of capital or property, and the creation of profit or economic value, such as buying a business, factory, or equipment, maintaining a bank account, or trading in commodities."@en ;
    ns2:descrizioneITA "Impegnarsi in ogni forma di transazione economica complessa che implichi lo scambio di capitale o proprietÃ  e la creazione di profitto o valore economico, come acquistare unâ€™impresa, una fabbrica o apparecchiature, mantenere un conto in banca, commerciare in titoli." ;
    ns2:nomeIta "Transazioni economiche complesse" ;
    rdfs:subClassOf ns2:Activities_and_participation .

joblist:Insurance_policy_processing_clerks a joblist:Insurance_policy_processing_clerks,
        owl:Class,
