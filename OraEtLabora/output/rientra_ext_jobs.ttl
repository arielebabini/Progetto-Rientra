ns6:Social_Skills a owl:Class ;
    ns4:Net_definition "Developed capacities used to work with people to achieve goals" ;
    rdfs:subClassOf ns6:Skills .

ns2:b1565 a ns2:b1565,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Visuospatial perception" ;
    ns2:description """Mental function involved in distinguishing by sight the relative position of objects in the environment or in relation to oneself.
Exclusions: orientation to objects (b1143)""" ;
    rdfs:subClassOf ns2:b156 .

ns2:b7602 a ns2:b7602,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Coordination of voluntary movements" ;
    ns2:description """Functions associated with coordination of simple and complex voluntary movements, performing movements in an orderly combination.
Inclusions: right left coordination, coordination of visually directed movements, such as eye hand coordination and eye foot coordination; impairments such as dysdiadochokinesia""" ;
    rdfs:subClassOf ns2:b760 .

ns2:d172 a ns2:d172,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Calculating" ;
    ns2:description """Performing computations by applying mathematical principles to solve problems that are described in words and producing or displaying the results, such as computing the sum of three numbers or finding the result of dividing one number by another.

Exclusions: learning to calculate (d150)"""@en ;
    ns2:descrizioneITA """Compiere dei calcoli applicando principi matematici per risolvere dei problemi descritti verbalmente e presentare o esporre i risultati, come calcolare la somma di tre numeri o trovare il risultato della divisione di un numero per un altro.

Esclusione: imparare a calcolare (d150)""" ;
    ns2:nomeIta "Calcolo" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Vocational_Rehabilitation .

ns2:d1751 a ns2:d1751,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Solving complex problems" ;
    ns2:description "Finding solutions to a complex problem involving multiple and interrelated issues, or several related problems, by identifying and analysing the issue, developing solutions, evaluating the potential effects of the solutions and executing a chosen solution."@en ;
    rdfs:subClassOf ns2:d175 .

ns2:d410 a ns2:d410,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Changing basic body position" ;
    ns2:description """Getting into and out of a body position and moving from one location to another, such as getting up out of a chair to lie down on a bed, and getting into and out of positions of sitting, standing, kneeling or squatting.

Inclusions: changing body position from lying down, from squatting or kneeling, from sitting or standing, rolling over, bending and shifting the body's centre of gravity

Exclusions: transferring oneself (d420)"""@en ;
    ns2:descrizioneITA """Assumere e abbandonare una posizione corporea e muoversi da una collocazione allâ€™altra, come alzarsi da una sedia per sdraiarsi sul letto, e assumere e abbandonare una posizione inginocchiata o accovacciata.

Inclusione: cambiare posizione dallâ€™essere sdraiati, accovacciati o inginocchiati, da seduti o in piedi, piegandosi e spostando il baricentro del corpo

Esclusione: trasferirsi (d420)""" ;
    ns2:nomeIta "Cambiare la posizione corporea di base" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d450 a ns2:d450,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking" ;
    ns2:description """Moving along a surface on foot, step by step, so that one foot is always on the ground, such as when strolling, sauntering, walking forwards, backwards, or sideways.

Inclusions: walking short or long distances; walking on different surfaces; walking around obstacles

Exclusions: transferring oneself (d420); moving around (d455)"""@en ;
    ns2:descrizioneITA """Muoversi lungo una superficie a piedi, passo dopo passo, in modo che almeno un piede sia sempre appoggiato al suolo, come nel passeggiare, gironzolare, camminare avanti, a ritroso o lateralmente.

Inclusioni: camminare per brevi o lunghe distanze; camminare su superfici diverse; camminare attorno a degli ostacoli

Esclusioni: trasferirsi (d420); spostarsi (d455)""" ;
    ns2:nomeIta "Camminare" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:ICF_Core_set a owl:Class .

ns2:b164 a ns2:b164,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Higher-level cognitive functions" ;
    ns2:description """Specific mental functions especially dependent on the frontal lobes of the brain, including complex goal-directed behaviours such as decision-making, abstract thinking, planning and carrying out plans, mental flexibility, and deciding which behaviours are appropriate under what circumstances; often called executive functions.
Inclusions: functions of abstraction and organization of ideas; time management, insight and judgement; concept formation, categorization and cognitive flexibility
Exclusions: memory functions (b144); thought functions (b160); mental functions of language (b167); calculation functions (b172)""" ;
    ns2:descrizioneITA """Funzioni mentali specifiche dipendenti in particolar modo dai lobi frontali del cervello, che includono comportamenti complessi diretti allo scopo come la capacitÃ  di prendere una decisione, il pensiero astratto, la pianificazione e la realizzazione di progetti, la flessibilitÃ  mentale e la capacitÃ  di decidere i comportamenti appropriati alle circostanze; spesso chiamate funzioni esecutive.

Inclusioni: funzioni dellâ€™astrazione e dellâ€™organizzazione delle idee; gestione del tempo, insight e giudizio; formazione di concetti, categorizzazione e flessibilitÃ  cognitiva

Esclusioni: funzioni della memoria (b144); funzioni del pensiero (b160); funzioni mentali del linguaggio (b167); funzioni di calcolo (b172)""" ;
    ns2:nomeIta "Funzioni cognitive di livello superiore" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:b2801 a ns2:b2801,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in body part" ;
    ns2:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in a specific part, or parts, of the body." ;
    rdfs:subClassOf ns2:b280 .

ns8:hasSpecificCriticality a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ns6:Abilities ns6:Skills ) ] ;
    rdfs:range xsd:int .

ns5:isSelected a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range xsd:boolean .

ns6:isTranslatedWithICFCode a owl:ObjectProperty ;
    rdfs:domain ns6:Abilities,
        ns6:Skills ;
    rdfs:range ns2:ICF ;
    owl:inverseOf <http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb> .

ns2:b710 a ns2:b710,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Mobility of joint functions" ;
    ns2:description """Functions of the range and ease of movement of a joint.
Inclusions: functions of mobility of single or several joints, vertebral, shoulder, elbow, wrist, hip, knee, ankle, small joints of hands and feet; mobility of joints generalized; impairments such as in hypermobility of joints, frozen joints, frozen shoulder, arthritis
Exclusions: stability of joint functions (b715); control of voluntary movement functions (b760)""" ;
    ns2:descrizioneITA """Funzioni della gamma e della facilitÃ  di movimento di unâ€™articolazione.

Inclusioni: funzioni della mobilitÃ  di una o piÃ¹ articolazioni, di vertebre, spalla, gomito, polso, anca, ginocchio, caviglia, piccole articolazioni della mano e del piede; mobilitÃ  delle articolazioni generalizzata; menomazioni come nellâ€™ipermobilitÃ  delle articolazioni, giunture congelate, tenosinovite scapolo-omerale cronica, artrite

Esclusioni: funzioni della stabilitÃ  dellâ€™articolazione (b715); funzioni di controllo del movimento volontario (b760)""" ;
    ns2:nomeIta "Funzioni della mobilitÃ  dellâ€™articolazione" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d330 a ns2:d330,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Speaking" ;
    ns2:description "Producing words, phrases and longer passages in spoken messages with literal and implied meaning, such as expressing a fact or telling a story in oral language."@en ;
    ns2:descrizioneITA "Produrre parole, frasi e brani piÃ¹ lunghi allâ€™interno di messaggi verbali con significato letterale e implicito, come esporre un fatto o raccontare una storia attraverso il linguaggio verbale." ;
    ns2:nomeIta "Parlare" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hearing_Loss .

ns1:involvesICFCode a owl:ObjectProperty ;
    rdfs:domain ns1:HC_Descriptor ;
    rdfs:range ns2:ICF .

ns1:isDescribedBy a owl:ObjectProperty ;
    rdfs:domain ns1:Health_Condition ;
    rdfs:range ns1:HC_Descriptor .

ns8:isEvaluatedForJob a owl:ObjectProperty ;
    rdfs:comment "Connects a person to a profession for which the person's health condition is being evaluated." ;
    rdfs:domain ns9:Person ;
    rdfs:range joblist:Job .

ns6:Physical_Abilities a owl:Class ;
    ns4:Net_definition "Abilities that influence strength, endurance, flexibility, balance and coordination" ;
    rdfs:subClassOf ns6:Abilities .

ns2:b730 a ns2:b730,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Muscle power functions" ;
    ns2:description """Functions related to the force generated by the contraction of a muscle or muscle groups.
Inclusions: functions associated with the power of specific muscles and muscle groups, muscles of one limb, one side of the body, the lower half of the body, all limbs, the trunk and the body as a whole; impairments such as weakness of small muscles in feet and hands, muscle paresis, muscle paralysis, monoplegia, hemiplegia, paraplegia, quadriplegia and akinetic mutism
Exclusions: functions of structures adjoining the eye (b215); muscle tone functions (b735); muscle endurance functions (b740)""" ;
    ns2:descrizioneITA """Funzioni correlate alla forza generata dalla contrazione di un muscolo o di un gruppo di muscoli.

Inclusioni: funzioni associate alla forza di specifici muscoli e gruppi di muscoli, muscoli di un arto, di un lato del corpo, della metÃ  inferiore del corpo, di tutti gli arti, del tronco e di tutto lâ€™insieme del corpo; menomazioni come debolezza dei piccoli muscoli dei piedi e delle mani, paresi muscolare, paralisi muscolare, monoplegia, emiplegia, paraplegia, tetraplegia e mutismo
acinetico

Esclusioni: funzioni delle strutture adiacenti allâ€™occhio (b215); funzioni del tono muscolare (b735); funzioni della resistenza muscolare (b740)""" ;
    ns2:nomeIta "Funzioni della forza muscolare" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns1:isInHealthCondition a owl:ObjectProperty ;
    rdfs:domain ns9:Person ;
    rdfs:range ns1:Health_Condition .

ns6:Basic_Skills a owl:Class ;
    ns4:Net_definition "Developed capacities that facilitate learning or the more rapid acquisition of knowledge" ;
    rdfs:subClassOf ns6:Skills .

ns6:Psychomotor_Abilities a owl:Class ;
    ns4:Net_definition "Abilities that influence the capacity to manipulate and control objects" ;
    rdfs:subClassOf ns6:Abilities .

<urn:swrl#x> a ns3:Variable .

ns2:b760 a ns2:b760,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Control of voluntary movement functions" ;
    ns2:description """Functions associated with control over and coordination of voluntary movements.
Inclusions: functions of control of simple voluntary movements and of complex voluntary movements, coordination of voluntary movements, supportive functions of arm or leg, right left motor coordination, eye hand coordination, eye foot coordination; impairments such as control and coordination problems, e.g. dysdiadochokinesia
Exclusions: muscle power functions (b730); involuntary movement functions (b765); gait pattern functions (b770)""" ;
    ns2:descrizioneITA """Funzioni associate al controllo e alla coordinazione dei movimenti volontari.

Inclusioni: funzioni di controllo di movimenti volontari semplici e di movimenti volontari complessi, coordinazione dei movimenti volontari, funzioni di sostegno del braccio o della gamba, coordinazione motoria destra sinistra, coordinazione occhio mano, coordinazione occhio piede; menomazioni come problemi di controllo e di coordinazione, ad es. disdiadococinesia

Esclusioni: funzioni della forza muscolare (b730); funzioni del
movimento involontario (b765); funzioni del pattern dellâ€™andatura (b770)""" ;
    ns2:nomeIta "Funzioni di controllo del movimento volontario" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hand_Conditions,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns6:Technical_Skills a owl:Class ;
    ns4:Net_definition "Developed capacities used to design, set-up, operate, and correct malfunctions involving application of machines or technological systems" ;
    rdfs:subClassOf ns6:Skills .

ns2:d445 a ns2:d445,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Hand and arm use" ;
    ns2:description """Performing the coordinated actions required to move objects or to manipulate them by using hands and arms, such as when turning door handles or throwing or catching an object.

Inclusions: pulling or pushing objects; reaching; turning or twisting the hands or arms; throwing; catching

Exclusions: fine hand use (d440)"""@en ;
    ns2:descrizioneITA """Compiere le azioni coordinate necessarie per muovere o manipolare oggetti usando mani e braccia, come nel girare le maniglie della porta o nel tirare o afferrare un oggetto.

Inclusioni: tirare o spingere oggetti; raggiungere allungando il braccio; girare o esercitare torsione delle mani o delle braccia; lanciare; afferrare

Esclusione: uso fine della mano (d440)""" ;
    ns2:nomeIta "Uso della mano e del braccio" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns6:ManPersonnelResources a ns6:Management_of_Personnel_Resources,
        owl:NamedIndividual ;
    ns6:isTranslatedWithICFCode ns2:d859-ManagementOfPersonnelResources .

ns6:Sensory_Abilities a owl:Class ;
    ns4:Net_definition "Abilities that influence visual, auditory and speech perception" ;
    rdfs:subClassOf ns6:Abilities .

ns6:WrittenComprehension a ns6:WrittenComprehension,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to read and understand information and ideas presented in writing." ;
    ns6:isTranslatedWithICFCode ns2:d325 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

<urn:swrl#sa> a ns3:Variable .

joblist:concerns a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain joblist:Job_Descriptor ;
    rdfs:range ns6:Abilities,
        ns6:Skills .

joblist:requires a owl:ObjectProperty ;
    rdfs:domain joblist:Job ;
    rdfs:range joblist:Job_Descriptor .

ns6:ArmHandSteadiness a ns6:ArmHandSteadiness,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to keep your hand and arm steady while moving your arm or while holding your arm and hand in one position." ;
    ns6:isTranslatedWithICFCode ns2:b7603,
        ns2:d455 ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:DynamicFlexibilty a ns6:Dynamic_Flexibility,
        owl:NamedIndividual ;
    ns6:isTranslatedWithICFCode ns2:b789-DynamicFlexibility .

ns6:ManFinancialResources a ns6:Management_of_Financial_Resources,
        owl:NamedIndividual ;
    ns6:isTranslatedWithICFCode ns2:d172,
        ns2:d2400,
        ns2:d865 .

ns6:ManMaterialResources a ns6:Management_of_Material_Resources,
        owl:NamedIndividual ;
    ns6:isTranslatedWithICFCode ns2:d859-ManagementOfMaterialResources .

ns6:SocialPerceptiveness a ns6:Social_Perceptiveness,
        owl:NamedIndividual ;
    ns6:isTranslatedWithICFCode ns2:b122 .

ns6:SpatialOrientation a ns6:SpatialOrientation,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to know your location in relation to the environment or to know where other objects are in relation to you." ;
    ns6:isTranslatedWithICFCode ns2:b1144,
        ns2:b1565 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns2:ICF a owl:Class .

ns6:ActiveLearning a ns6:ActiveLearning,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Understanding the implications of new information for both current and future problem-solving and decision-making." ;
    ns6:isTranslatedWithICFCode ns2:d198-ActiveLearning ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:ActiveListening a ns6:ActiveListening,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Giving full attention to what other people are saying, taking time to understand the points being made, asking questions as appropriate, and not interrupting at inappropriate times." ;
    ns6:isTranslatedWithICFCode ns2:d329-ActiveListening ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:AuditoryAttention a ns6:AuditoryAttention,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to focus on a single source of sound in the presence of other distracting sounds." ;
    ns6:isTranslatedWithICFCode ns2:b1408-AuditoryAttention ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:CategoryFlexibility a ns6:CategoryFlexibility,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to generate or use different sets of rules for combining or grouping things in different ways." ;
    ns6:isTranslatedWithICFCode ns2:b1643 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:ComplexProblemSolving a ns6:ComplexProblemSolving,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Identifying complex problems and reviewing related information to develop and evaluate options and implement solutions." ;
    ns6:isTranslatedWithICFCode ns2:b1646,
        ns2:d1751 ;
    rdfs:subClassOf ns6:Complex_problem_solving_Skills .

ns6:ControlPrecision a ns6:ControlPrecision,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to quickly and repeatedly adjust the controls of a machine or a vehicle to exact positions." ;
    ns6:isTranslatedWithICFCode ns2:b176,
        ns2:b760 ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:Coordination a ns6:Coordination,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Adjusting actions in relation to others' actions." ;
    ns6:isTranslatedWithICFCode ns2:d720 ;
    rdfs:subClassOf ns6:Social_Skills .

ns6:CriticalThinking a ns6:CriticalThinking,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Using logic and reasoning to identify the strengths and weaknesses of alternative solutions, conclusions or approaches to problems." ;
    ns6:isTranslatedWithICFCode ns2:b1645 ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:DeductiveReasoning a ns6:DeductiveReasoning,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to apply general rules to specific problems to produce answers that make sense." ;
    ns6:isTranslatedWithICFCode ns2:b189-DeductiveReasoning ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:DepthPerception a ns6:DepthPerception,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to judge which of several objects is closer or farther away from you, or to judge the distance between you and an object." ;
    ns6:isTranslatedWithICFCode ns2:b1565 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:DynamicStrenght a ns6:DynamicStrenght,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to exert muscle force repeatedly or continuously over time. This involves muscular endurance and resistance to muscle fatigue." ;
    ns6:isTranslatedWithICFCode ns2:b7401 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:ExplosiveStrenght a ns6:ExplosiveStrenght,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to use short bursts of muscle force to propel oneself (as in jumping or sprinting), or to throw an object." ;
    ns6:isTranslatedWithICFCode ns2:b7308-ExplosiveStrength ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:ExtentFlexibility a ns6:ExtentFlexibility,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to bend, stretch, twist, or reach with your body, arms, and/or legs." ;
    ns6:isTranslatedWithICFCode ns2:b710,
        ns2:b735 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:FarVision a ns6:FarVision,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to see details at a distance." ;
    ns6:isTranslatedWithICFCode ns2:b21000,
        ns2:b21001 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:FingerDexterity a ns6:FingerDexterity,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to make precisely coordinated movements of the fingers of one or both hands to grasp, manipulate, or assemble very small objects." ;
    ns6:isTranslatedWithICFCode ns2:d4402 ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:FlexibilityOfClosure a ns6:FlexibilityOfClosure,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to identify or detect a known pattern (a figure, object, word, or sound) that is hidden in other distracting material." ;
    ns6:isTranslatedWithICFCode ns2:b1568-FlexibilityOfClosure ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:FluencyOfIdeas a ns6:FluencyOfIdeas,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to come up with a number of ideas about a topic (the number of ideas is important, not their quality, correctness, or creativity)." ;
    ns6:isTranslatedWithICFCode ns2:b1648-FluencyOfIdeas ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:GlareSensitivity a ns6:GlareSensitivity,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to see objects in the presence of glare or bright lighting." ;
    ns6:isTranslatedWithICFCode ns2:b21028-GlareSensitivity ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:GrossBodyCoordination a ns6:GrossBodyCoordination,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to coordinate the movement of your arms, legs, and torso together when the whole body is in motion." ;
    ns6:isTranslatedWithICFCode ns2:b770 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:GrossBodyEquilibrium a ns6:GrossBodyEquilibrium,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to keep or regain your body balance or stay upright when in an unstable position." ;
    ns6:isTranslatedWithICFCode ns2:b2351,
        ns2:b755 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:HearingSensitivity a ns6:HearingSensitivity,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to detect or tell the differences between sounds that vary in pitch and loudness." ;
    ns6:isTranslatedWithICFCode ns2:b1560,
        ns2:b2301 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:InductiveReasoning a ns6:InductiveReasoning,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to combine pieces of information to form general rules or conclusions (includes finding a relationship among seemingly unrelated events)." ;
    ns6:isTranslatedWithICFCode ns2:b189-InductiveReasoning ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:InformationOrdering a ns6:InformationOrdering,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to arrange things or actions in a certain order or pattern according to a specific rule or set of rules (e.g., patterns of numbers, letters, words, pictures, mathematical operations)." ;
    ns6:isTranslatedWithICFCode ns2:b1641 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:Instructing a ns6:Instructing,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Teaching others how to do something." ;
    ns6:isTranslatedWithICFCode ns2:d398-Instructing ;
    rdfs:subClassOf ns6:Social_Skills .

ns6:JudgmentAndDecisionMaking a ns6:JudgmentAndDecisionMaking,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Considering the relative costs and benefits of potential actions to choose the most appropriate one." ;
    ns6:isTranslatedWithICFCode ns2:d177 ;
    rdfs:subClassOf ns6:Systems_Skills .

ns6:LearningStrategies a ns6:LearningStrategies,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Selecting and using training/instructional methods and procedures appropriate for the situation when learning or teaching new things." ;
    ns6:isTranslatedWithICFCode ns2:d198-LearningStrategies ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:ManualDexterity a ns6:ManualDexterity,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to quickly move your hand, your hand together with your arm, or your two hands to grasp, manipulate, or assemble objects." ;
    ns6:isTranslatedWithICFCode ns2:b7602,
        ns2:d445 ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:MathematicalReasoning a ns6:MathematicalReasoning,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to choose the right mathematical methods or formulas to solve a problem." ;
    ns6:isTranslatedWithICFCode ns2:b1721 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:Mathematics a ns6:Mathematics,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Using mathematics to solve problems." ;
    ns6:isTranslatedWithICFCode ns2:d172 ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:Memorization a ns6:Memorization,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to remember information such as words, numbers, pictures, and procedures." ;
    ns6:isTranslatedWithICFCode ns2:b1440,
        ns2:b1441,
        ns2:b1442 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:Monitoring a ns6:Monitoring,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Monitoring/Assessing performance of yourself, other individuals, or organizations to make improvements or take corrective action." ;
    ns6:isTranslatedWithICFCode ns2:b1648-Monitoring ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:MultilimbCoordination a ns6:MultilimbCoordination,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to coordinate two or more limbs (for example, two arms, two legs, or one leg and one arm) while sitting, standing, or lying down. It does not involve performing the activities while the whole body is in motion." ;
    ns6:isTranslatedWithICFCode ns2:b7602 ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:NearVision a ns6:NearVision,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to see details at close range (within a few feet of the observer)." ;
    ns6:isTranslatedWithICFCode ns2:b21002,
        ns2:b21003 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:Negotiation a ns6:Negotiation,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Bringing others together and trying to reconcile differences." ;
    ns6:isTranslatedWithICFCode ns2:d3558-Negotiation ;
    rdfs:subClassOf ns6:Social_Skills .

ns6:NightVision a ns6:NightVision,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to see under low light conditions." ;
    ns6:isTranslatedWithICFCode ns2:b21028-NightVision ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:NumberFacility a ns6:NumberFacility,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to add, subtract, multiply, or divide quickly and correctly." ;
    ns6:isTranslatedWithICFCode ns2:b1720 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:OralComprehension a ns6:OralComprehension,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to listen to and understand information and ideas presented through spoken words and sentences." ;
    ns6:isTranslatedWithICFCode ns2:d310 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:OralExpression a ns6:OralExpression,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to communicate information and ideas in speaking so others will understand." ;
    ns6:isTranslatedWithICFCode ns2:d3300,
        ns2:d3301,
        ns2:d3302 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:Originality a ns6:Originality,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to come up with unusual or clever ideas about a given topic or situation, or to develop creative ways to solve a problem." ;
    ns6:isTranslatedWithICFCode ns2:b1648-Originality ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:PerceptualSpeed a ns6:PerceptualSpeed,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to quickly and accurately compare similarities and differences among sets of letters, numbers, objects, pictures, or patterns. The things to be compared may be presented at the same time or one after the other. This ability also includes comparing a presented object with a remembered object." ;
    ns6:isTranslatedWithICFCode ns2:b1568-PerceptualSpeed ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:PeripheralVision a ns6:PeripheralVision,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to see objects or movement of objects to one's side when the eyes are looking ahead." ;
    ns6:isTranslatedWithICFCode ns2:b2101 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:Persuasion a ns6:Persuasion,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Persuading others to change their minds or behavior." ;
    ns6:isTranslatedWithICFCode ns2:d3558-Persuasion ;
    rdfs:subClassOf ns6:Social_Skills .

ns6:ProblemSensitivity a ns6:ProblemSensitivity,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to tell when something is wrong or is likely to go wrong. It does not involve solving the problem, only recognizing there is a problem." ;
    ns6:isTranslatedWithICFCode ns2:b1648-ProblemSensitivity ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:RateControl a ns6:RateControl,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to time your movements or the movement of a piece of equipment in anticipation of changes in the speed and/or direction of a moving object or scene." ;
    ns6:isTranslatedWithICFCode ns2:b7608-RateControl ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:ReactionTime a ns6:ReactionTime,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to quickly respond (with the hand, finger, or foot) to a signal (sound, light, picture) when it appears." ;
    ns6:isTranslatedWithICFCode ns2:b1478-ReactionTime ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:ReadingComprehension a ns6:ReadingComprehension,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Understanding written sentences and paragraphs in work related documents." ;
    ns6:isTranslatedWithICFCode ns2:d166 ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:ResponseOrientation a ns6:ResponseOrientation,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to choose quickly between two or more movements in response to two or more different signals (lights, sounds, pictures). It includes the speed with which the correct response is started with the hand, foot, or other body part." ;
    ns6:isTranslatedWithICFCode ns2:b7608-ResponseOrientation ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:Science a ns6:Science,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Using scientific rules and methods to solve problems." ;
    ns6:isTranslatedWithICFCode ns2:d1751 ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:SelectiveAttention a ns6:SelectiveAttention,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to concentrate on a task over a period of time without being distracted." ;
    ns6:isTranslatedWithICFCode ns2:b1400,
        ns2:d160 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:ServiceOrientation a ns6:ServiceOrientation,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Actively looking for ways to help people." ;
    ns6:isTranslatedWithICFCode ns2:b1261 ;
    rdfs:subClassOf ns6:Social_Skills .

ns6:SoundLocalization a ns6:SoundLocalization,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to tell the direction from which a sound originated." ;
    ns6:isTranslatedWithICFCode ns2:b2302,
        ns2:b2303 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:Speaking a ns6:Speaking,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Talking to others to convey information effectively." ;
    ns6:isTranslatedWithICFCode ns2:d330 ;
    rdfs:subClassOf ns6:Basic_Skills .

ns6:SpeechClarity a ns6:SpeechClarity,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to speak clearly so others can understand you." ;
    ns6:isTranslatedWithICFCode ns2:b320,
        ns2:b330 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:SpeechRecognition a ns6:SpeechRecognition,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to identify and understand the speech of another person." ;
    ns6:isTranslatedWithICFCode ns2:b16700,
        ns2:b2304 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:SpeedOfClosure a ns6:SpeedOfClosure,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to quickly make sense of, combine, and organize information into meaningful patterns." ;
    ns6:isTranslatedWithICFCode ns2:b1600,
        ns2:b1601 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:SpeedOfLimbMovement a ns6:SpeedOfLimbMovement,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to quickly move the arms and legs." ;
    ns6:isTranslatedWithICFCode ns2:b7608-SpeedOfLimbMovement ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:Stamina a ns6:Stamina,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to exert yourself physically over long periods of time without getting winded or out of breath." ;
    ns6:isTranslatedWithICFCode ns2:b4550 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:StaticStrenght a ns6:StaticStrenght,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to exert maximum muscle force to lift, push, pull, or carry objects." ;
    ns6:isTranslatedWithICFCode ns2:b7306 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:TimeManagement a ns6:TimeManagement,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Managing one's own time and the time of others." ;
    ns6:isTranslatedWithICFCode ns2:b1642 ;
    rdfs:subClassOf ns6:Resource_Management_Skills .

ns6:TimeSharing a ns6:TimeSharing,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to shift back and forth between two or more activities or sources of information (such as speech, sounds, touch, or other sources)." ;
    ns6:isTranslatedWithICFCode ns2:b1401 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:TrunkStrenght a ns6:TrunkStrenght,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to use your abdominal and lower back muscles to support part of the body repeatedly or continuously over time without 'giving out' or fatiguing." ;
    ns6:isTranslatedWithICFCode ns2:b7305 ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:VisualColorDiscrimination a ns6:VisualColorDiscrimination,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to match or detect differences between colors, including shades of color and brightness." ;
    ns6:isTranslatedWithICFCode ns2:b21021,
        ns2:b21022 ;
    rdfs:subClassOf ns6:Sensory_Abilities .

ns6:Visualization a ns6:Visualization,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to imagine how something will look after it is moved around or when its parts are moved or rearranged." ;
    ns6:isTranslatedWithICFCode ns2:b1143,
        ns2:b1640 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

ns6:WristFingerSpeed a ns6:WristFingerSpeed,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to make fast, simple, repeated movements of the fingers, hands, and wrists." ;
    ns6:isTranslatedWithICFCode ns2:d4408-WristFingerSpeed ;
    rdfs:subClassOf ns6:Psychomotor_Abilities .

ns6:Writing a ns6:Writing,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "Communicating effectively in writing as appropriate for the needs of the audience." ;
    ns6:isTranslatedWithICFCode ns2:d170 ;
    rdfs:subClassOf ns6:Basic_Skills .

<urn:swrl#j> a ns3:Variable .

ns1:Health_Condition a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:isDescribedBy ;
            owl:someValuesFrom ns1:HC_Descriptor ] .

ns6:WrittenExpression a ns6:WrittenExpression,
        owl:Class,
        owl:NamedIndividual ;
    ns4:Net_definition "The ability to communicate information and ideas in writing so others will understand." ;
    ns6:isTranslatedWithICFCode ns2:d345 ;
    rdfs:subClassOf ns6:Cognitive_Abilities .

<urn:swrl#jd> a ns3:Variable .

<urn:swrl:var#res> a ns3:Variable .

<urn:swrl:var#x> a ns3:Variable .

ns2:Body_structures a owl:Class ;
    rdfs:subClassOf ns2:ICF .

ns6:Cognitive_Abilities a owl:Class ;
    ns4:Net_definition "Abilities that influence the acquisition and application of knowledge in problem" ;
    rdfs:subClassOf ns6:Abilities .

<urn:swrl:var#hc> a ns3:Variable .

<urn:swrl:var#icf> a ns3:Variable .

<urn:swrl:var#jde> a ns3:Variable .

ns9:Person a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:isInHealthCondition ;
            owl:someValuesFrom ns1:Health_Condition ] .

ns6:Abilities a owl:Class ;
    ns4:Net_definition "Enduring attributes of the individual that influence performance." .

ns6:Skills a owl:Class ;
    ns4:Net_definition "Developed capacities that facilitate learning or the more rapid acquisition of knowledge." .

<urn:swrl:var#des> a ns3:Variable .

<urn:swrl:var#p> a ns3:Variable .

joblist:Job a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass joblist:Job_Descriptor ;
            owl:onProperty joblist:requires ] .

<urn:swrl:var#job> a ns3:Variable .

<urn:swrl:var#skab> a ns3:Variable .

ns5:Low_Back_Pain a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns2:Vocational_Rehabilitation a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns5:Hearing_Loss a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns2:Body_functions a owl:Class ;
    ns2:descrizioneITA """Le funzioni corporee sono le funzioni fisiologiche dei sistemi corporei (comprese le funzioni psicologiche).

Le menomazioni sono problemi nella funzione o nella struttura del corpo, intesi come una deviazione o una perdita significative.""" ;
    ns2:nomeIta "Funzioni Corporee" ;
    rdfs:subClassOf ns2:ICF .

ns2:Activities_and_participation a owl:Class ;
    ns2:descrizioneITA """Definizioni:
Lâ€™attivitÃ  Ã¨ lâ€™esecuzione di un compito o di unâ€™azione da parte di un individuo.

La partecipazione Ã¨ il coinvolgimento in una situazione di vita.

Le limitazioni dellâ€™attivitÃ  sono le difficoltÃ  che un individuo puÃ² incontrare nello svolgere delle attivitÃ .

Le restrizioni alla partecipazione sono i problemi che un individuo puÃ² sperimentare nel coinvolgimento nelle situazioni di vita.""" ;
    ns2:nomeIta "AttivitÃ  e Partecipazione" ;
    rdfs:subClassOf ns2:ICF .

ns5:Hand_Conditions a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns2:Stroke a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns2:Traumatic_Brain_Injury a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns2:Spinal_Cord_Injury a owl:Class ;
    rdfs:subClassOf ns2:ICF_Core_set .

ns1:HC_Descriptor a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onClass ns2:ICF ;
            owl:onProperty ns1:involvesICFCode ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

joblist:Job_Descriptor a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty joblist:hasScore ;
            owl:someValuesFrom xsd:int ],
        [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:unionOf ( ns6:Abilities ns6:Skills ) ] ;
            owl:onProperty joblist:concerns ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] rdfs:comment "VeryImp (3) - Activity&part" .

