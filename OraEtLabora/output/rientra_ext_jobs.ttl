ns1:AP2qual a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "NOT TO BE USED." ;
    rdfs:domain ns1:HC_Descriptor ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first 0 ;
                    rdf:rest [ a rdf:List ;
                            rdf:first 1 ;
                            rdf:rest [ a rdf:List ;
                                    rdf:first 2 ;
                                    rdf:rest [ a rdf:List ;
                                            rdf:first 3 ;
                                            rdf:rest [ a rdf:List ;
                                                    rdf:first 4 ;
                                                    rdf:rest [ a rdf:List ;
                                                            rdf:first 8 ;
                                                            rdf:rest [ a rdf:List ;
                                                                    rdf:first 9 ;
                                                                    rdf:rest () ] ] ] ] ] ] ] ] .

