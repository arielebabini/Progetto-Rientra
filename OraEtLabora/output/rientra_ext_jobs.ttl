                                                                                            rdf:first 9 ;
                                                                                            rdf:rest () ] ] ] ] ] ] ] ] ] ] ] .

ns1:BS3qual a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "NOT TO BE USED.",
        "Location of the impairment in the human body."@en ;
    rdfs:domain ns1:HC_Descriptor ;
    rdfs:range [ a rdfs:Datatype ;
            owl:oneOf [ a rdf:List ;
                    rdf:first 0 ;
                    rdf:rest [ a rdf:List ;
