@prefix ns5: <http://www.stiima.cnr.it/RientraOnt3Merged#> .
@prefix ns6: <http://www.stiima.cnr.it/SkAb#> .
@prefix ns7: <http://www.stiima.cnr.it/JobList#O*> .
