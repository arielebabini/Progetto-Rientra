ns8:isExtremelyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability is extremely critical for a person being evaluated in a specific profession." ;
    rdfs:domain ns6:Abilities,
        ns6:Skills ;
    rdfs:range ns9:Person .

ns8:isModeratelyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability has a moderate criticality for a person being evaluated in a specific profession." ;
    rdfs:domain ns6:Abilities,
        ns6:Skills ;
    rdfs:range ns9:Person .

ns8:isNotCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability presents no criticality for a person being evaluated in a specific profession." ;
    rdfs:domain ns6:Abilities,
        ns6:Skills ;
    rdfs:range ns9:Person .

ns8:isRelevantlyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability has a relevant criticality for a person being evaluated in a specific profession." ;
    rdfs:domain ns6:Abilities,
        ns6:Skills ;
    rdfs:range ns9:Person .

ns8:isSlightlyCriticalFor a owl:ObjectProperty ;
    rdfs:comment "Describe which O*NET-SOC Skill or Ability is slightly critical for a person being evaluated in a specific profession." ;
    rdfs:domain ns6:Abilities,
        ns6:Skills ;
    rdfs:range ns9:Person .

ns8:matchedJob a owl:ObjectProperty ;
    rdfs:domain ns8:Match ;
    rdfs:range joblist:Job .

ns6:Complex_problem_solving_Skills a owl:Class ;
    ns4:Net_definition "Developed capacities used to solve novel, ill-defined problems in complex, real-world settings" ;
    rdfs:subClassOf ns6:Skills .

ns6:Dynamic_Flexibility a owl:Class ;
    ns4:Net_definition "The ability to quickly and repeatedly bend, stretch, twist, or reach out with your body, arms, and/or legs." ;
    rdfs:subClassOf ns6:Physical_Abilities .

ns6:Management_of_Financial_Resources a owl:Class ;
    ns4:Net_definition "Determining how money will be spent to get the work done, and accounting for these expenditures." ;
    rdfs:subClassOf ns6:Resource_Management_Skills .

ns6:Management_of_Material_Resources a owl:Class ;
    ns4:Net_definition "Obtaining and seeing to the appropriate use of equipment, facilities, and materials needed to do certain work." ;
    rdfs:subClassOf ns6:Resource_Management_Skills .

ns6:Management_of_Personnel_Resources a owl:Class ;
    ns4:Net_definition "Motivating, developing, and directing people as they work, identifying the best people for the job." ;
    rdfs:subClassOf ns6:Resource_Management_Skills .

ns6:Social_Perceptiveness a owl:Class ;
    ns4:Net_definition "Being aware of others' reactions and understanding why they react as they do." ;
    rdfs:subClassOf ns6:Social_Skills .

<http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb> a owl:ObjectProperty .

ns2:b117 a ns2:b117,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Intellectual functions" ;
    ns2:description """General mental functions, required to understand and constructively integrate the various mental functions including all cognitive functions and their development over the life span.
Inclusions: functions of intellectual growth; intellectual retardation, mental retardation, dementia
Exclusions: memory functions (b144); thought functions (b160); higher level cognitive functions (b164)""" ;
    ns2:descrizioneITA """Funzioni mentali generali richieste per capire e integrare in modo costruttivo le varie funzioni mentali, incluse tutte le funzioni cognitive e il loro sviluppo nellâ€™arco di vita.

Inclusioni: funzioni della crescita intellettiva; ritardo intellettivo, ritardo mentale, demenza

Esclusioni: funzioni della memoria (b144); funzioni del pensiero (b160); funzioni cognitive di livello superiore (b164)""" ;
    ns2:nomeIta "Funzioni intellettive" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:b126 a ns2:b126,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Temperament and personality functions" ;
    ns2:description """General mental functions of constitutional disposition of the individual to react in a particular way to situations, including the set of mental characteristics that makes the individual distinct from others.
Inclusions: functions of extraversion, introversion, agreeableness, conscientiousness, psychic and emotional stability, and openness to experience; optimism; novelty seeking; confidence; trustworthiness
Exclusions: intellectual functions (b117); energy and drive functions (b130); psychomotor functions (b147); emotional functions (b152)""" ;
    ns2:descrizioneITA """Funzioni mentali generali del temperamento proprio dellâ€™individuo che lo portano a reagire in un particolare modo alle situazioni, inclusa la serie di caratteristiche mentali che rende un individuo distinto dagli altri.

Inclusioni: funzioni di estroversione, introversione, giovialitÃ , coscienziositÃ , stabilitÃ  emotiva e psichica e apertura alle esperienze; ottimismo; ricerca delle novitÃ ; fiducia; affidabilitÃ 

Esclusioni: funzioni intellettive (b117); funzioni dellâ€™energia e
delle pulsioni (b130); funzioni psicomotorie (b147); funzioni
emozionali (b152)""" ;
    ns2:nomeIta "Funzioni del temperamento e della personalitÃ " ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss,
        ns5:Low_Back_Pain .

ns2:b1568 a owl:Class ;
    rdfs:label "Perceptual functions, other specified" ;
    rdfs:subClassOf ns2:b156 .

ns2:b1670 a owl:Class ;
    rdfs:label "Reception of language" ;
    ns2:description "Specific mental functions of decoding messages in spoken, written or other forms, such as sign language, to obtain their meaning." ;
    rdfs:subClassOf ns2:b167 .

ns2:b1671 a owl:Class ;
    rdfs:label "Expression of language" ;
    ns2:description "Specific mental functions necessary to produce meaningful messages in spoken, written, signed or other forms of language." ;
    rdfs:subClassOf ns2:b167 .

ns2:b180 a ns2:b180,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Experience of self and time functions" ;
    ns2:description """Specific mental functions related to the awareness of one's identity, one's body, one's position in the reality of one's environment and of time.
Inclusions: functions of experience of self, body image and time""" ;
    ns2:descrizioneITA """Funzioni mentali specifiche correlate alla consapevolezza della propria identitÃ , del proprio corpo, della propria posizione nella realtÃ  del proprio ambiente e temporale.

Inclusione: funzioni dellâ€™esperienza del sÃ©, dellâ€™immagine corporea e del tempo""" ;
    ns2:nomeIta "Funzioni dellâ€™esperienza del sÃ© e del tempo" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns5:Low_Back_Pain .

ns2:b189 a owl:Class ;
    rdfs:label "Specific mental functions, other specified and unspecified" ;
    ns2:nomeIta "Funzioni mentali specifiche, altro specificato e non specificato" ;
    rdfs:subClassOf ns2:Body_functions .

ns2:b21028 a owl:Class ;
    rdfs:label "Quality of vision, other specified" ;
    rdfs:subClassOf ns2:b2102 .

ns2:b235 a ns2:b235,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Vestibular functions" ;
    ns2:description """Sensory functions of the inner ear related to position, balance and movement.
Inclusions: functions of position and positional sense; functions of balance of the body and movement
Exclusions: sensation associated with hearing and vestibular functions (b240)""" ;
    ns2:descrizioneITA """Funzioni sensoriali dellâ€™orecchio interno correlate alla posizione, allâ€™equilibrio e al movimento.

Inclusioni: funzioni della posizione e del senso di posizione; funzioni dellâ€™equilibrio del corpo e del movimento

Esclusione: sensazioni associate alla funzione uditiva e vestibolare (b240)""" ;
    ns2:nomeIta "Funzioni vestibolari" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:b265 a ns2:b265,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Touch function" ;
    ns2:description """Sensory functions of sensing surfaces and their texture or quality.
Inclusions: functions of touching, feeling of touch; impairments such as numbness, anaesthesia, tingling, paraesthesia and hyperaesthesia
Exclusions: sensory functions related to temperature and other stimuli (b270)""" ;
    ns2:descrizioneITA """Funzioni sensoriali che permettono di percepire superfici e la loro struttura o qualitÃ .

Inclusioni: funzioni del toccare, sensazione del tocco; menomazioni come intorpidimento, anestesia, formicolio, parestesia e iperestesia

Esclusione: funzioni sensoriali correlate alla temperatura e ad altri stimoli (b270)""" ;
    ns2:nomeIta "Funzione del tatto" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns5:Hand_Conditions .

ns2:b28010 a ns2:b28010,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in head and neck" ;
    ns2:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in the head and neck." ;
    rdfs:subClassOf ns2:b2801 .

ns2:b28014 a ns2:b28014,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pain in upper limb" ;
    ns2:description "Sensation of unpleasant feeling indicating potential or actual damage to some body structure felt in either one or both upper limbs, including hands." ;
    rdfs:subClassOf ns2:b2801 .

ns2:b310 a ns2:b310,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Voice functions" ;
    ns2:description """Functions of the production of various sounds by the passage of air through the larynx.
Inclusions: functions of production and quality of voice; functions of phonation, pitch, loudness and other qualities of voice; impairments such as aphonia, dysphonia, hoarseness, hypernasality and hyponasality
Exclusions: mental functions of language (b167); articulation functions (b320); alternative vocalization functions (b340)""" ;
    ns2:descrizioneITA """Funzioni della produzione di vari suoni tramite il passaggio di aria attraverso la laringe.

Inclusioni: funzioni di produzione e qualitÃ  della voce; funzioni di fonazione, tono, volume e altre qualitÃ  della voce; menomazioni come afonia, disfonia, raucedine, ipernasalitÃ  e iponasalitÃ 

Esclusioni: funzioni mentali del linguaggio (b167); funzioni
dellâ€™articolazione della voce (b320)""" ;
    ns2:nomeIta "Funzioni della voce" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hearing_Loss .

ns2:b715 a ns2:b715,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Stability of joint functions" ;
    ns2:description """Functions of the maintenance of structural integrity of the joints.
Inclusions: functions of the stability of a single joint, several joints, and joints generalized; impairments such as in unstable shoulder joint, dislocation of a joint, dislocation of shoulder and hip
Exclusions: mobility of joint functions (b710)""" ;
    ns2:descrizioneITA """Funzioni del mantenimento dellâ€™integritÃ  strutturale delle articolazioni.

Inclusioni: funzioni della stabilitÃ  di una singola articolazione, di diverse articolazioni e delle articolazioni nel loro complesso; menomazioni come nellâ€™articolazione instabile della spalla, lussazione di unâ€™articolazione, lussazione della spalla e dellâ€™anca

Esclusione: funzioni della mobilitÃ  dellâ€™articolazione (b710)""" ;
    ns2:nomeIta "Funzioni della stabilitÃ  dellâ€™articolazione" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns5:Hand_Conditions,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:b750 a ns2:b750,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Motor reflex functions" ;
    ns2:description """Functions of involuntary contraction of muscles automatically induced by specific stimuli.
Inclusions: functions of stretch motor reflex, automatic local joint reflex, reflexes generated by noxious stimuli and other exteroceptive stimuli; withdrawal reflex, biceps reflex, radius reflex, quadriceps reflex, patellar reflex, ankle reflex, emergence and persistence of reflexes""" ;
    ns2:descrizioneITA """Funzioni della contrazione involontaria dei muscoli indotta automaticamente da stimoli specifici.

Inclusioni: funzioni del riflesso motorio miostatico, riflesso automatico dellâ€™articolazione locale, riflessi generati da stimoli nocivi o da altri stimoli esterocettivi; riflesso di ritrazione, riflesso del bicipite, riflesso del radio, riflesso del quadricipite, riflesso della rotula, riflesso della caviglia""" ;
    ns2:nomeIta "Funzioni del riflesso motorio" ;
    rdfs:subClassOf ns2:Body_functions,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns5:Low_Back_Pain .

ns2:b761 a ns2:b761,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Spontaneous movements" ;
    ns2:description """Functions associated with frequency, fluency and complexity of total and individual body-part movements such as infant spontaneous movements and patterns of movement. Note: this code should be applied only to infants aged less than corrected age 6 months.
Exclusions: motor reflex functions (b750); involuntary movement reaction functions (b755); involuntary movement functions (b765)""" ;
    ns2:descrizioneITA "------ Non disponibile ------" ;
    ns2:nomeIta "Movimenti spontanei" ;
    rdfs:subClassOf ns2:Body_functions .

ns2:d155 a ns2:d155,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Acquiring skills" ;
    ns2:description """Developing basic and complex competencies in integrated sets of actions or tasks so as to initiate and follow through with the acquisition of a skill, such as manipulating tools or toys or playing games.

Inclusions: acquiring basic and complex skills"""@en ;
    ns2:descrizioneITA """Sviluppare capacitÃ  basilari e complesse in insiemi integrati di azioni o compiti in modo da iniziare e portare a termine lâ€™acquisizione di unâ€™abilitÃ , come utilizzare strumenti o giocare a giochi come gli scacchi

Inclusioni: acquisire abilitÃ  basilari e complesse""" ;
    ns2:nomeIta "Acquisizione di abilitÃ " ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d175 a ns2:d175,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Solving problems" ;
    ns2:description """Finding solutions to questions or situations by identifying and analysing issues, developing options and solutions, evaluating potential effects of solutions, and executing a chosen solution, such as in resolving a dispute between two people.

Inclusions: solving simple and complex problems

Exclusions: thinking (d163); making decisions (d177)"""@en ;
    ns2:descrizioneITA """Trovare soluzioni a problemi o situazioni identificando e analizzando le questioni, sviluppando opzioni e soluzioni, valutandone i potenziali effetti e mettendo in atto la soluzione prescelta, come nel risolvere una disputa fra due persone.

Inclusioni: risoluzione di problemi semplici e complessi

Esclusioni: pensiero (d163); prendere decisioni (d177)""" ;
    ns2:nomeIta "Risoluzione di problemi" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:d198 a owl:Class ;
    rdfs:label "Learning and applying knowledge, other specified" ;
    ns2:nomeIta "Apprendimento e applicazione delle conoscenze, altro specificato" ;
    rdfs:subClassOf ns2:Activities_and_participation .

ns2:d230 a ns2:d230,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Carrying out daily routine" ;
    ns2:description """Carrying out simple or complex and coordinated actions in order to plan, manage and complete the requirements of day-to-day procedures or duties, such as budgeting time and making plans for separate activities throughout the day.

Inclusions: managing and completing the daily routine; managing one's own activity level

Exclusions: undertaking multiple tasks (d220)"""@en ;
    ns2:descrizioneITA """Compiere delle azioni semplici o complesse e coordinate per pianificare, gestire e completare le attivitÃ  richieste dai procedimenti o dalle incombenze quotidiane, come organizzare il proprio tempo e pianificare le diverse attivitÃ  nel corso della giornata.

Inclusioni: gestire e completare la routine quotidiana; gestire il proprio tempo e le proprie attivitÃ 

Esclusione: intraprendere compiti articolati (d220)""" ;
    ns2:nomeIta "Eseguire la routine quotidiana" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d240 a ns2:d240,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Handling stress and other psychological demands" ;
    ns2:description """Carrying out simple or complex and coordinated actions to manage and control the psychological demands required to carry out tasks demanding significant responsibilities and involving stress, distraction, or crises, such as driving a vehicle during heavy traffic or taking care of many children.

Inclusions: handling responsibilities; handling stress and crisis"""@en ;
    ns2:descrizioneITA """Eseguire azioni semplici o complesse e coordinate per gestire e controllare le richieste di tipo psicologico necessarie per eseguire compiti che comportano significative responsabilitÃ , stress, distrazioni e crisi, come guidare un veicolo nel traffico intenso o occuparsi di molti bambini.

Inclusioni: gestire le responsabilitÃ ; gestire lo stress e le crisi""" ;
    ns2:nomeIta "Gestire la tensione e altre richieste di tipo psicologico" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss,
        ns5:Low_Back_Pain,
        ns5:Muskoloskeletal_Conditions_for_Post_Acute_Care .

ns2:d315 a ns2:d315,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Communicating with - receiving - nonverbal messages" ;
    ns2:description """Comprehending the literal and implied meanings of messages conveyed by gestures, symbols and drawings, such as realizing that a child is tired when she rubs her eyes or that a warning bell means that there is a fire.

Inclusions: communicating with - receiving - body gestures, general signs and symbols, drawings and photographs"""@en ;
    ns2:descrizioneITA """Comprendere i significati letterali e impliciti di messaggi comunicati tramite gesti, simboli e disegni, come capire che un bambino Ã¨ stanco quando si stropiccia gli occhi o che il suono di una sirena significa che Ã¨ in atto un incendio.

Inclusioni: comunicare con - ricevere - linguaggio corporeo, segni e simboli comuni, disegni e fotografie""" ;
    ns2:nomeIta "Comunicare con - ricevere - messaggi non verbali" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hearing_Loss .

ns2:d3558 a owl:Class ;
    rdfs:label "Discussion, other specified" ;
    rdfs:subClassOf ns2:d355 .

ns2:d360 a ns2:d360,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Using communication devices and techniques" ;
    ns2:description """Using devices, techniques and other means for the purposes of communicating, such as calling a friend on the telephone.

Inclusions: using telecommunication devices, using writing machines and communication techniques"""@en ;
    ns2:descrizioneITA """Utilizzare strumenti, tecniche e altri mezzi per scopi comunicativi, come chiamare un amico al telefono.

Inclusioni: utilizzare strumenti di telecomunicazione, usare macchine per scrivere e tecniche di comunicazione""" ;
    ns2:nomeIta "Utilizzo di strumenti e tecniche di comunicazione" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions,
        ns5:Hearing_Loss .

ns2:d4100 a ns2:d4100,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Lying down" ;
    ns2:description """Getting into and out of a lying down position or changing body position, from horizontal to any other position, such as standing up or sitting down.

Inclusions: getting into a prostrate position"""@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d410 .

ns2:d4102 a ns2:d4102,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Kneeling" ;
    ns2:description "Getting into and out of a position where the body is supported by the knees with legs bent, such as during prayers, or changing body position from kneeling to any other position, such as standing up."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d410 .

ns2:d4104 a ns2:d4104,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Standing" ;
    ns2:description "Getting into and out of a standing position or changing body position from standing to any other position, such as lying down or sitting down."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d410 .

ns2:d4105 a ns2:d4105,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Bending" ;
    ns2:description "Tilting the back downwards or to the side, at the torso, such as in bowing or reaching down for an object."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d410 .

ns2:d4106 a ns2:d4106,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Shifting the body's centre of gravity" ;
    ns2:description """Adjusting or moving the weight of the body from one position to another while sitting, standing or lying, such as moving from one foot to another while standing.

Exclusions: transferring oneself (d420); walking (d450)"""@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d410 .

ns2:d4500 a ns2:d4500,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking short distances" ;
    ns2:description "Walking for less than a kilometre, such as walking around rooms or hallways, within a building or for short distances outside."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d450 .

ns2:d4501 a ns2:d4501,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking long distances" ;
    ns2:description "Walking for more than a kilometre, such as across a village or town, between villages or across open areas."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d450 .

ns2:d4502 a ns2:d4502,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking on different surfaces" ;
    ns2:description "Walking on sloping, uneven, or moving surfaces, such as on grass, gravel or ice and snow, or walking aboard a ship, train or other vehicle."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d450 .

ns2:d4503 a ns2:d4503,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Walking around obstacles" ;
    ns2:description "Walking in ways required to avoid moving and immobile objects, people, animals, and vehicles, such as walking around a marketplace or shop, around or through traffic or other crowded areas."@en ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:d450 .

ns2:d710 a ns2:d710,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Basic interpersonal interactions" ;
    ns2:description """Interacting with people in a contextually and socially appropriate manner, such as by showing consideration and esteem when appropriate, or responding to the feelings of others.

Inclusions: showing respect, warmth, appreciation, and tolerance in relationships; responding to criticism and social cues in relationships; and using appropriate physical contact in relationships"""@en ;
    ns2:descrizioneITA """Interagire con le persone in un modo contestualmente e socialmente adeguato, come nel mostrare considerazione e stima quando appropriato, o rispondere ai sentimenti degli altri.

Inclusioni: mostrare rispetto, cordialitÃ , apprezzamento e tolleranza nelle relazioni; rispondere alle critiche e ai segnali sociali nelle relazioni; fare uso adeguato del contatto fisico nelle relazioni""" ;
    ns2:nomeIta "Interazioni interpersonali semplici" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns2:Vocational_Rehabilitation,
        ns5:Hand_Conditions,
        ns5:Hearing_Loss,
        ns5:Low_Back_Pain .

ns2:d750 a ns2:d750,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Informal social relationships" ;
    ns2:description """Entering into relationships with others, such as casual relationships with people living in the same community or residence, or with co-workers, students, playmates, people with similar backgrounds or professions.

Inclusions: informal relationships with friends, neighbours, acquaintances, co-inhabitants and peers"""@en ;
    ns2:descrizioneITA """Entrare in relazione con altri, come le relazioni casuali con persone che vivono nella stessa comunitÃ  o residenza, o con colleghi di lavoro, studenti, compagni di gioco o persone dello stesso ambiente o professione.

Inclusioni: relazioni informali con amici, vicini di casa, conoscenti, coinquilini e pari""" ;
    ns2:nomeIta "Relazioni sociali informali" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns2:Spinal_Cord_Injury,
        ns2:Stroke,
        ns2:Traumatic_Brain_Injury,
        ns5:Hand_Conditions,
        ns5:Hearing_Loss .

ns2:d859 a owl:Class ;
    rdfs:label "Work and employment, other specified and unspecified" ;
    ns2:nomeIta "Lavoro e impiego, altro specificato e non specificato" ;
    rdfs:subClassOf ns2:Activities_and_participation,
        ns5:Hand_Conditions,
        ns5:Low_Back_Pain .

ns2:s7500 a ns2:s7500,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Structure of thigh" ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:s750 .

ns2:s7501 a ns2:s7501,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Structure of lower leg" ;
    rdfs:subClassOf ns2:Spinal_Cord_Injury,
        ns2:s750 .

