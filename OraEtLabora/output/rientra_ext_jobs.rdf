    <rdf:type rdf:resource="http://www.stiima.cnr.it/JobList#Billing_cost_and_rate_clerks"/>
    <ns7:Net_job_titles>Sample of reported job titles: Accounting Assistant, Accounting Clerk, Accounts Payable Clerk, Accounts Receivable Clerk, Administrative Assistant, Biller, Billing Clerk, Billing Coordinator, Billing Specialist, Office Manager</ns7:Net_job_titles>
    <joblist:SOC_Code>43-3021.02</joblist:SOC_Code>
    <ns7:Net_short_description>Compile data, compute fees and charges, and prepare invoices for billing purposes. Duties include computing costs and calculating rates for goods, services, and shipment of goods; posting data; and keeping other relevant records. May involve use of computer or typewriter, calculator, and adding and bookkeeping machines.</ns7:Net_short_description>
    <rdfs:label>Billing, Cost, and Rate Clerks</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
  </rdf:Description>
