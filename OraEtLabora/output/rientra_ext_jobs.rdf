    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Muskoloskeletal_Conditions_for_Post_Acute_Care"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Low_Back_Pain"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hand_Conditions"/>
    <ns4:description xml:lang="en">Planning and carrying out the elimination of human waste (menstruation, urination and defecation), and clean oneself afterwards.

Inclusions: regulating urination, defecation and menstrual care

Exclusions: washing oneself (d510); caring for body parts (d520)</ns4:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d530"/>
    <rdfs:label>Toileting</rdfs:label>
    <ns4:descrizioneITA>Pianificare ed espletare lâ€™eliminazione di prodotti organici (mestruazioni, minzione e defecazione) e poi pulirsi.

Inclusioni: regolare la minzione, la defecazione e la cura relativa alle mestruazioni

Esclusioni: lavarsi (d510); prendersi cura di singole parti del corpo (d520)</ns4:descrizioneITA>
    <ns4:nomeIta>Bisogni corporali</ns4:nomeIta>
  </rdf:Description>
