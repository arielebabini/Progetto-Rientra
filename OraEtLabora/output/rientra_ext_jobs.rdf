    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d420"/>
    <ns4:descrizioneITA>Muoversi da una superficie a unâ€™altra, come muoversi lungo una panca o dal letto alla sedia, senza cambiare posizione corporea.

Inclusioni: trasferirsi da seduti o da sdraiati Esclusione: cambiare la posizione corporea di base (d410)</ns4:descrizioneITA>
    <rdfs:label>Transferring oneself</rdfs:label>
    <ns4:nomeIta>Trasferirsi</ns4:nomeIta>
  </rdf:Description>
