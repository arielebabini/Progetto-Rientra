    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <joblist:SOC_Code>43-3031.00</joblist:SOC_Code>
    <ns8:Net_job_titles>Sample of reported job titles: Account Clerk, Accounting Assistant, Accounting Associate, Accounting Clerk, Accounting Specialist, Accounting Technician, Accounts Payable Clerk, Accounts Payable Specialist, Accounts Payables Clerk, Accounts Receivable Clerk</ns8:Net_job_titles>
    <rdfs:label>Bookkeeping, Accounting, and Auditing Clerks</rdfs:label>
  </rdf:Description>
