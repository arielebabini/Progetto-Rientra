  <rdf:Description rdf:about="http://www.stiima.cnr.it/JobList#File_clerks">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>File Clerks</rdfs:label>
    <ns7:Net_short_description>File correspondence, cards, invoices, receipts, and other records in alphabetical or numerical order or according to the filing system used. Locate and remove material from file when requested.</ns7:Net_short_description>
    <joblist:SOC_Code>43-4071.00</joblist:SOC_Code>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    <ns7:Net_job_titles>Sample of reported job titles: Claims Clerk, Clerk, Documentation Specialist, File Clerk, Human Resources Assistant (HR Assistant), Manufacturing Clerk, Medical Records Clerk, Office Assistant, Police Records Clerk, Records Clerk</ns7:Net_job_titles>
  </rdf:Description>
