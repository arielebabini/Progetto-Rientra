    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hearing_Loss"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Vocational_Rehabilitation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d825"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:description xml:lang="en">Engaging in all activities of a vocational programme and learning the curriculum material for preparation for employment in a trade, job or profession.</ns2:description>
    <rdfs:label>Vocational training</rdfs:label>
    <ns2:nomeIta>Formazione professionale</ns2:nomeIta>
    <ns2:descrizioneITA>Impegnarsi in tutte le attivitÃ  di formazione professionale e apprendere il materiale del curriculum in previsione di intraprendere un mestiere, lavoro o professione.</ns2:descrizioneITA>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6e57ca3393974ceebd319a095f946e42">
    <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first>
