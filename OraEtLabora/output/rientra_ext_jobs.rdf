    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Spinal_Cord_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <ns3:descrizioneITA>Gestione delle risorse economiche provenienti da fonti private o pubbliche per garantirsi sicurezza economica in vista delle necessitÃ  presenti o future.

Inclusioni: risorse economiche personali e sussidi economici pubblici</ns3:descrizioneITA>
  </rdf:Description>
