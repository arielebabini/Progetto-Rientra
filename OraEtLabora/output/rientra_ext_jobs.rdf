    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d740"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns2:nomeIta>Relazioni formali</ns2:nomeIta>
    <ns2:descrizioneITA>Creare e mantenere delle relazioni specifiche in contesti formali, come con datori di lavoro, professionisti o fornitori di servizi.

Inclusioni: entrare in relazione con persone autorevoli, con subordinati e con i pari</ns2:descrizioneITA>
    <rdfs:label>Formal relationships</rdfs:label>
    <ns2:description xml:lang="en">Creating and maintaining specific relationships in formal settings, such as with teachers, employers, professionals or service providers.

Inclusions: relating with persons in authority, with subordinates and with equals</ns2:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.stiima.cnr.it/RientraHC#desTest_A_44">
    <ns1:AP1qual rdf:datatype="http://www.w3.org/2001/XMLSchema#int">4</ns1:AP1qual>
