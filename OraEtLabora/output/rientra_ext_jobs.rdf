    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#b7602"/>
    <ns2:description>Functions associated with coordination of simple and complex voluntary movements, performing movements in an orderly combination.
Inclusions: right left coordination, coordination of visually directed movements, such as eye hand coordination and eye foot coordination; impairments such as dysdiadochokinesia</ns2:description>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#b760"/>
    <rdfs:label>Coordination of voluntary movements</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncbb550e5b2774018bf0e9df695850ead">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
