  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d760">
    <ns4:nomeIta>Relazioni familiari</ns4:nomeIta>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d760"/>
    <rdfs:label>Family relationships</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Spinal_Cord_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Muskoloskeletal_Conditions_for_Post_Acute_Care"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hearing_Loss"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Low_Back_Pain"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hand_Conditions"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Traumatic_Brain_Injury"/>
    <ns4:description xml:lang="en">Creating and maintaining kinship relationships, such as those with members of the nuclear family, extended family, foster and adopted family and step-relationships, more distant relationships such as second cousins, or legal guardians.

Inclusions: parent-child and child-parent relationships, sibling and extended family relationships</ns4:description>
    <ns4:descrizioneITA>Creazione e mantenimento di relazioni di parentela, come con i membri della famiglia ristretta, della famiglia allargata, della famiglia affidataria e adottiva e nelle relazioni tra patrigno o matrigna e figliastri, nelle parentele piÃ¹ lontane come secondi cugini, o tutori legali.

Inclusioni: relazioni genitore-figlio e figlio-genitore, tra fratelli e nella famiglia allargata</ns4:descrizioneITA>
  </rdf:Description>
