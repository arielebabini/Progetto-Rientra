    <ns2:nomeIta>Comunicare con - ricevere - messaggi verbali</ns2:nomeIta>
    <rdfs:label>Communicating with - receiving - spoken messages</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Traumatic_Brain_Injury"/>
