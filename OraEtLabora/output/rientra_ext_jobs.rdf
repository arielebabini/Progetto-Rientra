    <rdf:type rdf:resource="http://www.stiima.cnr.it/JobList#Billing_cost_and_rate_clerks"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <joblist:SOC_Code>43-3021.02</joblist:SOC_Code>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    <rdfs:label>Billing, Cost, and Rate Clerks</rdfs:label>
    <ns5:Net_job_titles>Sample of reported job titles: Accounting Assistant, Accounting Clerk, Accounts Payable Clerk, Accounts Receivable Clerk, Administrative Assistant, Biller, Billing Clerk, Billing Coordinator, Billing Specialist, Office Manager</ns5:Net_job_titles>
  </rdf:Description>
