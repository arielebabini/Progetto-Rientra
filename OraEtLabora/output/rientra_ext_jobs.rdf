  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d4502">
    <ns4:description xml:lang="en">Walking on sloping, uneven, or moving surfaces, such as on grass, gravel or ice and snow, or walking aboard a ship, train or other vehicle.</ns4:description>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Spinal_Cord_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d450"/>
