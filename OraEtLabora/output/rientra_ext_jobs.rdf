    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns3:descrizioneITA>Comprendere il significato letterale e implicito di messaggi che vengono comunicati tramite il linguaggio scritto (incluso il Braille), come seguire gli eventi politici sui quotidiani o comprendere le intenzioni dei testi sacri.</ns3:descrizioneITA>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <ns3:nomeIta>Comunicare con - ricevere - messaggi scritti</ns3:nomeIta>
    <rdfs:label>Communicating with - receiving - written messages</rdfs:label>
    <ns3:description xml:lang="en">Comprehending the literal and implied meanings of messages that are conveyed through written language (including Braille), such as following political events in the daily newspaper or understanding the intent of religious scripture.</ns3:description>
  </rdf:Description>
