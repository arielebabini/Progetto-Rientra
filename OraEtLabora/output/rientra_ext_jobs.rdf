  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#b255">
    <ns2:descrizioneITA>Funzioni sensoriali del percepire odori e aromi.

Inclusioni: funzioni olfattive; menomazioni come anosmia o iposmia</ns2:descrizioneITA>
    <ns2:nomeIta>Funzione dellâ€™olfatto</ns2:nomeIta>
    <ns2:description>Sensory functions of sensing odours and smells.
Inclusions: functions of smelling, olfactory functions; anosmia, hyposmia</ns2:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
