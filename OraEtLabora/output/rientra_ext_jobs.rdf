  <rdf:Description rdf:about="http://www.stiima.cnr.it/SkAb#PerceptualSpeed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/SkAb#PerceptualSpeed"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/SkAb#Cognitive_Abilities"/>
    <ns7:Net_definition>The ability to quickly and accurately compare similarities and differences among sets of letters, numbers, objects, pictures, or patterns. The things to be compared may be presented at the same time or one after the other. This ability also includes comparing a presented object with a remembered object.</ns7:Net_definition>
    <ns6:isTranslatedWithICFCode rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#b1568-PerceptualSpeed"/>
  </rdf:Description>
