    <ns3:descrizioneITA>Focalizzarsi intenzionalmente su stimoli specifici, come ignorare i rumori distraenti.</ns3:descrizioneITA>
    <ns3:nomeIta>Focalizzare lâ€™attenzione</ns3:nomeIta>
    <ns3:description xml:lang="en">Intentionally focusing on specific stimuli, such as by filtering out distracting noises.</ns3:description>
  </rdf:Description>
