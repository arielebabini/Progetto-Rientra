    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hearing_Loss"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Vocational_Rehabilitation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d710"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns2:description xml:lang="en">Interacting with people in a contextually and socially appropriate manner, such as by showing consideration and esteem when appropriate, or responding to the feelings of others.

Inclusions: showing respect, warmth, appreciation, and tolerance in relationships; responding to criticism and social cues in relationships; and using appropriate physical contact in relationships</ns2:description>
    <ns2:descrizioneITA>Interagire con le persone in un modo contestualmente e socialmente adeguato, come nel mostrare considerazione e stima quando appropriato, o rispondere ai sentimenti degli altri.

Inclusioni: mostrare rispetto, cordialitÃ , apprezzamento e tolleranza nelle relazioni; rispondere alle critiche e ai segnali sociali nelle relazioni; fare uso adeguato del contatto fisico nelle relazioni</ns2:descrizioneITA>
    <rdfs:label>Basic interpersonal interactions</rdfs:label>
    <ns2:nomeIta>Interazioni interpersonali semplici</ns2:nomeIta>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.stiima.cnr.it/RientraHC#GRZerodes0077">
    <rdf:type rdf:resource="http://www.stiima.cnr.it/RientraHC#HC_Descriptor"/>
