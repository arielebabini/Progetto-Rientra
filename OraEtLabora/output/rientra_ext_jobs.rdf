    <joblist:SOC_Code>43-4171.00</joblist:SOC_Code>
    <ns5:Net_job_titles>Sample of reported job titles: Clerk Specialist, Community Liaison, Front Desk Receptionist, Greeter, Member Service Representative, Office Assistant, Receptionist, Scheduler, Senior Receptionist, Unit Assistant</ns5:Net_job_titles>
  </rdf:Description>
