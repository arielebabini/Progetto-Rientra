    <ns4:nomeIta>Transazioni economiche complesse</ns4:nomeIta>
    <rdfs:label>Complex economic transactions</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <ns4:descrizioneITA>Impegnarsi in ogni forma di transazione economica complessa che implichi lo scambio di capitale o proprietÃ  e la creazione di profitto o valore economico, come acquistare unâ€™impresa, una fabbrica o apparecchiature, mantenere un conto in banca, commerciare in titoli.</ns4:descrizioneITA>
    <ns4:description xml:lang="en">Engaging in any form of complex economic transaction that involves the exchange of capital or property, and the creation of profit or economic value, such as buying a business, factory, or equipment, maintaining a bank account, or trading in commodities.</ns4:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.stiima.cnr.it/SkAb#MultilimbCoordination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
