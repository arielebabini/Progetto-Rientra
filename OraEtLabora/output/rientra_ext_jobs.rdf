Inclusions: sensitivity to touch, numbness, hypaesthesia, hyperaesthesia, paraesethesia, tingling</ns3:description>
    <rdfs:label>Sensitivity to pressure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d610">
