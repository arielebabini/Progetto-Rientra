  <rdf:Description rdf:about="http://www.stiima.cnr.it/SkAb#FluencyOfIdeas">
    <ns6:isTranslatedWithICFCode rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#b1648-FluencyOfIdeas"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/SkAb#FluencyOfIdeas"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
