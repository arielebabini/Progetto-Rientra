    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Moving around outside the home and other buildings</rdfs:label>
    <ns3:description xml:lang="en">Walking and moving around close to or far from one's home and other buildings, without the use of transportation, public or private, such as walking for short or long distances around a town or village.

Inclusions: walking or moving down streets in the neighbourhood, town, village or city; moving between cities, without using transportation</ns3:description>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.stiima.cnr.it/JobDescription#isVeryImportantFor">
