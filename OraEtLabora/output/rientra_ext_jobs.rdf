    <rdfs:label>Insurance Policy Processing Clerks</rdfs:label>
    <joblist:SOC_Code>43-9041.02</joblist:SOC_Code>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/JobList#Insurance_policy_processing_clerks"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    <ns7:Net_short_description>Sample of reported job titles: Account Administrator, Agency Service Representative, Client Process Specialist, Enrollment Representative, Insurance Analyst, Policy Analyst, Policy Service Coordinator, Policy Services Representative, Premium Representative, Processing Clerk</ns7:Net_short_description>
    <ns7:Net_job_titles>Process applications for, changes to, reinstatement of, and cancellation of insurance policies. Duties include reviewing insurance applications to ensure that all questions have been answered, compiling data on insurance policy changes, changing policy records to conform to insured party's specifications, compiling data on lapsed insurance policies to determine automatic reinstatement according to company policies, canceling insurance policies as requested by agents, and verifying the accuracy of insurance company records.</ns7:Net_job_titles>
  </rdf:Description>
