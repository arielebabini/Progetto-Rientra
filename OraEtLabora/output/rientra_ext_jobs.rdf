  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d335">
    <ns2:description xml:lang="en">Using gestures, symbols and drawings to convey messages, such as shaking one's head to indicate disagreement or drawing a picture or diagram to convey a fact or complex idea.

Inclusions: producing body gestures, signs, symbols, drawings and photographs</ns2:description>
    <ns2:nomeIta>Produrre messaggi non verbali</ns2:nomeIta>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Traumatic_Brain_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <rdfs:label>Producing nonverbal messages</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d335"/>
    <ns2:descrizioneITA>Usare segni, simboli e disegni per comunicare significati, come scuotere la testa per indicare disaccordo o disegnare unâ€™immagine o un grafico per comunicare un fatto o unâ€™idea complessa.

Inclusioni: produrre gesti con il corpo, segni, simboli, disegni e fotografie</ns2:descrizioneITA>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N69aa5c9114384daca25e13ccd89a2802">
