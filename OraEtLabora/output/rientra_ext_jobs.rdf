    <rdf:type rdf:resource="http://www.stiima.cnr.it/JobList#Postal_service_clerks"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Postal Service Clerks</rdfs:label>
  </rdf:Description>
