  <rdf:Description rdf:about="http://www.stiima.cnr.it/RientraOnt3Merged#b435">
    <rdfs:label>Immunological system functions</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Body_functions"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Muskoloskeletal_Conditions_for_Post_Acute_Care"/>
    <ns2:description>Functions of the body related to protection against foreign substances, including infections, by specific and non-specific immune responses.  
Inclusions: immune response (specific and non-specific); hypersensitivity reactions; functions of lymphatic vessels and nodes; functions of cell-mediated immunity, antibody-mediated immunity; response to immunization; impairments such as in autoimmunity, allergic reactions, lymphadenitis and lymphoedema</ns2:description>
  </rdf:Description>
