    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Vocational_Rehabilitation"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <ns4:descrizioneITA>Interagire con le persone in un modo contestualmente e socialmente adeguato, come nel mostrare considerazione e stima quando appropriato, o rispondere ai sentimenti degli altri.

Inclusioni: mostrare rispetto, cordialitÃ , apprezzamento e tolleranza nelle relazioni; rispondere alle critiche e ai segnali sociali nelle relazioni; fare uso adeguato del contatto fisico nelle relazioni</ns4:descrizioneITA>
    <ns4:nomeIta>Interazioni interpersonali semplici</ns4:nomeIta>
    <rdfs:label>Basic interpersonal interactions</rdfs:label>
  </rdf:Description>
