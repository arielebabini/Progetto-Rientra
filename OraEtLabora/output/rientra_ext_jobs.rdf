    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d730"/>
    <ns3:nomeIta>Entrare in relazione con estranei</ns3:nomeIta>
    <rdfs:label>Relating with strangers</rdfs:label>
    <ns3:descrizioneITA>Avere contatti e legami temporanei con estranei per scopi specifici, come quando sichiede unâ€™indicazione o si effettua un acquisto.</ns3:descrizioneITA>
    <ns3:description xml:lang="en">Engaging in temporary contacts and links with strangers for specific purposes, when asking for directions or other information, or making a purchase.</ns3:description>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc57381c19bcf499db9e27baf54e91c9b">
    <rdf:first rdf:nodeID="Ned4a3820c18a4ad3a2b9e8ecddfaadb8"/>
