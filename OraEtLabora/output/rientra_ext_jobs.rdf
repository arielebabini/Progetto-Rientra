  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d520">
    <rdfs:label>Caring for body parts</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d520"/>
