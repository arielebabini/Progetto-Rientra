  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d770">
    <ns4:descrizioneITA>Creare e mantenere relazioni strette o sentimentali tra individui, come tra marito e moglie, tra fidanzati o partner sessuali.

Inclusioni: relazioni romantiche, coniugali e sessuali</ns4:descrizioneITA>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hearing_Loss"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Low_Back_Pain"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Traumatic_Brain_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Spinal_Cord_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hand_Conditions"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <ns4:nomeIta>Relazioni intime</ns4:nomeIta>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d770"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:description xml:lang="en">Creating and maintaining close or romantic relationships between individuals, such as husband and wife, lovers or sexual partners.

Inclusions: romantic, spousal and sexual relationships</ns4:description>
    <rdfs:label>Intimate relationships</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2bdcf2ba235944d6a75d6dbc292ae44f">
