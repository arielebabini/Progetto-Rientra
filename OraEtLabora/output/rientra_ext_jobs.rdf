  <rdf:Description rdf:about="http://www.stiima.cnr.it/JobList#Construction_laborers">
    <ns7:Net_job_titles>Sample of reported job titles: Bituminous Asphalt Technician, Construction Laborer, Construction Worker, Drop Crew Laborer, Equipment Operator (EO), Form Setter, Post Framer, Scaffolding Operator, Site Work Laborer, Toolman</ns7:Net_job_titles>
    <rdfs:label>Construction laborers</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    <joblist:SOC_Code>47-2061.00</joblist:SOC_Code>
    <ns7:Net_short_description>Perform tasks involving physical labor at construction sites. May operate hand and power tools of all types: air hammers, earth tampers, cement mixers, small mechanical hoists, surveying and measuring equipment, and a variety of other equipment and instruments. May clean and prepare sites, dig trenches, set braces to support the sides of excavations, erect scaffolding, and clean up rubble, debris and other waste materials. May assist other craft workers.</ns7:Net_short_description>
  </rdf:Description>
