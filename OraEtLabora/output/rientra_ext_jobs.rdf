    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d5300"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns3:description xml:lang="en">Coordinating and managing urination, such as by indicating need, getting into the proper position, choosing and getting to an appropriate place for urination, manipulating clothing before and after urination, and cleaning oneself after urination.</ns3:description>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Spinal_Cord_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d530"/>
    <rdfs:label>Regulating urination</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#d550">
    <ns3:description xml:lang="en">Carrying out the coordinated tasks and actions of eating food that has been served, bringing it to the mouth and consuming it in culturally acceptable ways, cutting or breaking food into pieces, opening bottles and cans, using eating implements, having meals, feasting or dining.

Exclusions: drinking (d560)</ns3:description>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#d550"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Muskoloskeletal_Conditions_for_Post_Acute_Care"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Spinal_Cord_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Stroke"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Traumatic_Brain_Injury"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#Activities_and_participation"/>
    <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3Merged#Hand_Conditions"/>
    <ns3:descrizioneITA>Eseguire i compiti e le azioni coordinati di mangiare il cibo che Ã¨ stato servito, portarlo alla bocca e consumarlo in modi culturalmente accettabili, tagliare o spezzare il cibo in pezzi, aprire bottiglie e lattine, usare posate, consumare i pasti, banchettare.

Esclusione: bere (d560)</ns3:descrizioneITA>
    <rdfs:label>Eating</rdfs:label>
    <ns3:nomeIta>Mangiare</ns3:nomeIta>
  </rdf:Description>
