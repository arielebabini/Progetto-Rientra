    <ns5:Net_job_titles>Sample of reported job titles: Bulk Mail Technician, Clerk, Distribution Clerk, Part Time Flexible Clerk (PTF Clerk), Postal Clerk, Sales &amp; Service Associate (SSA), Sales and Distribution Clerk, Sales and Service Associate (SSA), Window Clerk, Window/Distribution Clerk</ns5:Net_job_titles>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.stiima.cnr.it/JobList#Postal_service_clerks"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <joblist:SOC_Code>43-5051.00</joblist:SOC_Code>
    <rdfs:label>Postal Service Clerks</rdfs:label>
    <ns5:Net_short_description>Perform any combination of tasks in a post office, such as receive letters and parcels; sell postage and revenue stamps, postal cards, and stamped envelopes; fill out and sell money orders; place mail in pigeon holes of mail rack or in bags; and examine mail for correct postage.</ns5:Net_short_description>
  </rdf:Description>
