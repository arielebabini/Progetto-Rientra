<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.stiima.cnr.it/RientraOnt3Merged#"
     xml:base="http://www.stiima.cnr.it/RientraOnt3Merged"
     xmlns:O="http://www.stiima.cnr.it/SkAb#O*"
     xmlns:O1="http://www.stiima.cnr.it/JobList#O*"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rie="http://www.stiima.cnr.it/RientraOnt3Merged#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:SkAb="http://www.stiima.cnr.it/SkAb#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:RRISO="http://www.stiima.cnr.it/RRISO#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:JobList="http://www.stiima.cnr.it/JobList#"
     xmlns:RientraHC="http://www.stiima.cnr.it/RientraHC#"
     xmlns:RientraOnt3="http://www.stiima.cnr.it/RientraOnt3#"
     xmlns:translatesO="http://www.stiima.cnr.it/SkAb#translatesO*"
     xmlns:FOAF-excerpt="http://www.stiima.cnr.it/FOAF-excerpt#"
     xmlns:JobDescription="http://www.stiima.cnr.it/JobDescription#"
     xmlns:ICF-exc-coreset="http://www.stiima.cnr.it/ICF-exc-coreset#"
     xmlns:Person-CommonBox="http://www.stiima.cnr.it/Person-CommonBox#">
    <owl:Ontology rdf:about="http://www.stiima.cnr.it/RientraReturns">
        <owl:imports rdf:resource="http://www.stiima.cnr.it/RRISO"/>
        <rdfs:comment xml:lang="&quot; ontology by stiima-cnr.">A box importing:
- JobList
- SkAb for the full description and translation of Jobs with ICF.

Developed for &quot;Rientr</rdfs:comment>
        <rdfs:comment>Added professions:
- Dancers
- Travel guides
- Receptionists and Information Clerks
- Insurance policy processing Clerks
- Insurance Claims Clerks
- Billing, cost and rate Clerks
- Bookkeeping, Accounting, and Auditing Clerks

On February 2022.</rdfs:comment>
        <rdfs:comment xml:lang="&quot; ontology by stiima-cnr.

full foaf: http://xmlns.com/foaf/spec/">An excerpt od Friend Of a Friend (FOAF) ontology for people&apos;s description.
Developed for &quot;Rientr</rdfs:comment>
        <rdfs:comment>Based on Standard Occupation Classification (2016 version) available on O*NET web site: https://www.onetonline.org/</rdfs:comment>
        <rdfs:comment>Common Box for Person description importing:
- Health Condition (RientraHC)
- FOAF (FOAF-excerpt)
- ICF (excerpt and core sets)</rdfs:comment>
        <rdfs:comment>Developed on: 29 November 2021.
Latest revision: 30 april 2024.
Version: 3.1.</rdfs:comment>
        <rdfs:comment xml:lang="&quot; project by stiima-cnr.
it contains the classes composing:
- traumatic brain injury comprehensive core set
- spinal cord injury (long term/chronic) comprehensive core set
- stroke comprehensive core set
- vocational rehabilitation comprehensive core set
- codes description, inclusion and exclusions added

full icf ontology: https://www.bioportal.bioontology.org/ontologies/icf (updated may 2012).">Excerpt of ICF developend for the &quot;Rientr</rdfs:comment>
        <rdfs:comment xml:lang="&quot; ontology by stiima-cnr.">Excerpt of O*NET &quot;Skills&quot; and &quot;Abilities&quot; for descriptions of jobs.
Developed for &quot;Rientr</rdfs:comment>
        <rdfs:comment xml:lang="&quot; ontology by stiima-cnr.">Health Condition Ontology for modelling wheelchair users&apos; health conditions.
Developed for &quot;Rientr</rdfs:comment>
        <rdfs:comment xml:lang="&quot; ontology by stiima-cnr.">List of jobs to be matched with the wheelchair users.
Developed for &quot;Rientr</rdfs:comment>
        <rdfs:comment>Revised on 08 June 2020.
Translation of O*NET in ICF deeply revised (elimination of the &quot;translator&quot; individuals and classes):
- SWRL &quot;matrix&quot; revision: specific scores for Skills and Abilities according to the new version of the matrix (Risk factor);
- 8 new SWRL rules deployed.</rdfs:comment>
        <rdfs:comment>Rientra Ontology importing:

1. Person ontology (Common Box), which imports:
      a) Health Conditions (RientraHC)
      b) FOAF (FOAF excerpt)
      c) ICF (excerpt and core sets)

2. Job Description (Common Box), which imports:
      d) Job List
      e) Skills and Abilities (SkAb)</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stiima.cnr.it/ICF-exc-coreset#description -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#description"/>
    


    <!-- http://www.stiima.cnr.it/ICF-exc-coreset#descrizioneITA -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#descrizioneITA"/>
    


    <!-- http://www.stiima.cnr.it/ICF-exc-coreset#nomeIta -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/ICF-exc-coreset#nomeIta"/>
    


    <!-- http://www.stiima.cnr.it/JobList#SOC_Code -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/JobList#SOC_Code"/>
    


    <!-- http://www.stiima.cnr.it/JobList#O*Net_job_titles -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/JobList#O*Net_job_titles"/>
    


    <!-- http://www.stiima.cnr.it/JobList#O*Net_short_description -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/JobList#O*Net_short_description"/>
    


    <!-- http://www.stiima.cnr.it/SkAb#O*Net_definition -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/SkAb#O*Net_definition"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stiima.cnr.it/JobDescription#isImportantFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobDescription#isImportantFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/JobDescription#isLessImportantFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobDescription#isLessImportantFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/JobDescription#isSlightlyCriticalFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobDescription#isSlightlyCriticalFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/JobDescription#isSomewhatImportantFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobDescription#isSomewhatImportantFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/JobDescription#isVeryImportantFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobDescription#isVeryImportantFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/JobList#concerns -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobList#concerns">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/JobList#Job_Descriptor"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/JobList#requires -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/JobList#requires">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job_Descriptor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraHC#involvesICFCode -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraHC#involvesICFCode">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/RientraHC#HC_Descriptor"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#ICF"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraHC#isDescribedBy -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraHC#isDescribedBy">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/RientraHC#Health_Condition"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/RientraHC#HC_Descriptor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraHC#isInHealthCondition -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraHC#isInHealthCondition">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/RientraHC#Health_Condition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#hasExtremeCriticalityIn -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#hasExtremeCriticalityIn">
        <owl:inverseOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3#isExtremelyCriticalFor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#hasMatch -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#hasMatch">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/RientraOnt3#Match"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#hasModerateCriticalityIn -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#hasModerateCriticalityIn">
        <owl:inverseOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3#isModeratelyCriticalFor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#hasNoCriticalityIn -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#hasNoCriticalityIn">
        <owl:inverseOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3#isNotCriticalFor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#hasRelevantCriticalityIn -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#hasRelevantCriticalityIn">
        <owl:inverseOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3#isRelevantlyCriticalFor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#hasSlightCriticalityIn -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#hasSlightCriticalityIn">
        <owl:inverseOf rdf:resource="http://www.stiima.cnr.it/RientraOnt3#isSlightlyCriticalFor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#isEvaluatedForJob -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#isEvaluatedForJob">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
        <rdfs:comment>Connects a person to a profession for which the person&apos;s health condition is being evaluated.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#isExtremelyCriticalFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#isExtremelyCriticalFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:comment>Describe which O*NET-SOC Skill or Ability is extremely critical for a person being evaluated in a specific profession.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#isModeratelyCriticalFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#isModeratelyCriticalFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:comment>Describe which O*NET-SOC Skill or Ability has a moderate criticality for a person being evaluated in a specific profession.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#isNotCriticalFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#isNotCriticalFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:comment>Describe which O*NET-SOC Skill or Ability presents no criticality for a person being evaluated in a specific profession.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#isRelevantlyCriticalFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#isRelevantlyCriticalFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:comment>Describe which O*NET-SOC Skill or Ability has a relevant criticality for a person being evaluated in a specific profession.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#isSlightlyCriticalFor -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#isSlightlyCriticalFor">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/FOAF-excerpt#Person"/>
        <rdfs:comment>Describe which O*NET-SOC Skill or Ability is slightly critical for a person being evaluated in a specific profession.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/RientraOnt3#matchedJob -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/RientraOnt3#matchedJob">
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/RientraOnt3#Match"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/JobList#Job"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/SkAb#isTranslatedWithICFCode -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/SkAb#isTranslatedWithICFCode">
        <owl:inverseOf rdf:resource="http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Abilities"/>
        <rdfs:domain rdf:resource="http://www.stiima.cnr.it/SkAb#Skills"/>
        <rdfs:range rdf:resource="http://www.stiima.cnr.it/ICF-exc-coreset#ICF"/>
    </owl:ObjectProperty>
    


    <!-- http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb -->

    <owl:ObjectProperty rdf:about="http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb"/>
    


