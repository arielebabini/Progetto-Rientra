<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/spoladore/ontologies/2024/3/untitled-ontology-14/"
     xml:base="http://www.semanticweb.org/spoladore/ontologies/2024/3/untitled-ontology-14/"
     xmlns:iso="http://www.stiima.cnr.it/RRISO#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.stiima.cnr.it/RRISO">
        <owl:imports rdf:resource="http://www.stiima.cnr.it/glic"/>
        <rdfs:comment xml:lang="cnr.it">Contact: Daniele Spoladore (STIIMA Cnr)
daniele.spoladore</rdfs:comment>
        <rdfs:comment>Modelling the &quot;ISO 9999:2022&quot;</rdfs:comment>
        <rdfs:comment xml:lang="returns research project, financed by inail.">Module of the Rientr</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stiima.cnr.it/RRISO#description -->

    <owl:AnnotationProperty rdf:about="http://www.stiima.cnr.it/RRISO#description"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.stiima.cnr.it/RRISO#04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04">
        <rdfs:comment>Products that monitor or assess a person’s medical condition and products for stimulating or training physiological and psychological functions
Included are, e.g. products used in medical treatment.
Excluded are assistive products used exclusively by healthcare professionals. Devices that have a function other than training, but that can also be used for training should be included in the class covering its principal function.</rdfs:comment>
        <rdfs:label>Assistive products for measuring, stimulating or training physiological and psychological functions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Equipment for assisting a person to breathe</iso:description>
        <rdfs:label>Assistive products for respiration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices that take in air from the surrounding area and physiologically treat it before inhalation by warming, cooling or cleaning the air</iso:description>
        <rdfs:label>Inhaled-air pretreatment devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices for assisting a person to inhale or to administer drugs in the form of vapour, gas, liquid spray or fine dust</iso:description>
        <rdfs:label>Inhalation equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices for providing artificial ventilation through the nose, the mouth or an artificial hole in the air pipe (tracheostomy) for a person who has difficulties with breathing Included are, e.g. ventilators and respirators that filter or purify the surrounding air, Continuous Positive Airway Pressure (CPAP), Bilevel Positive Airway Pressure (BIPAP).</iso:description>
        <rdfs:label>Respirators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices providing concentrated oxygen gas, which is breathed in through the nose and mouth
Included are, e.g. units that concentrate oxygen from the surrounding air.</iso:description>
        <rdfs:label>Oxygen units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices for sucking secretions and substances out of the lungs</iso:description>
        <rdfs:label>Aspirators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices for positioning a person in order to enable him/her to breathe or to drain secretions from the lungs</iso:description>
        <rdfs:label>Benches and cushions for respiration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices for training the respiratory muscles either by applying resistance when a person is breathing or by direct compression onto the walls of the chest
Included are, e.g. masks that give resistance to inhaling and exhaling.</iso:description>
        <rdfs:label>Respiration muscle trainers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.03.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.03.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.03"/>
        <iso:description>Devices that support the uvula in order to enable free breathing
Included are, e.g. devices to enable continuity in breathing and to avoid snoring.</iso:description>
        <rdfs:label>Uvula supports</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Equipment for assisting blood circulation by passive or active compression</iso:description>
        <rdfs:label>Assistive products for supporting and stimulating blood circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.06.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.06.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.06"/>
        <iso:description>Clothes that have a gradually descending pressure towards the body for curing or preventing oedema
Included are, e.g. tube-like elastic anti-oedema bandages, stockings for arms and legs for reducing or preventing swelling caused by circulation problems.</iso:description>
        <rdfs:label>Anti-oedema stockings for arms and legs and other parts of the body</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.06.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.06.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.06"/>
        <iso:description>Equipment with air-filled attachments for surrounding an affected part of the body; equipment consisting of both compression garments and compressors that produces waves of compression to aid the circulation and to prevent swelling caused by circulation problems</iso:description>
        <rdfs:label>Air-filled garments and compression units for managing circulation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.08 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.08">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Garments that facilitate body posture and control or body conceptualization with even pressure; clothes that are used to enhance daily activities Included are, e.g. compression garments, bandages, tapes.</iso:description>
        <rdfs:label>Assistive products for stimulating body control and conceptualization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <rdfs:label>Assistive products for light therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.09.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.09.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.09"/>
        <iso:description>Therapy lamps with long wave ultraviolet rays, used primarily for the treatment of skin conditions</iso:description>
        <rdfs:label>Ultraviolet A (UVA) lamps</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.09.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.09.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.09"/>
        <iso:description>Therapy lamps with short wave ultraviolet rays, used primarily for the treatment of skin conditions</iso:description>
        <rdfs:label>Selective Ultraviolet Phototherapy (SUP) and Ultraviolet B (UVB) lamps</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.09.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.09.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.09"/>
        <iso:description>Devices for protecting the eyes from ultraviolet rays</iso:description>
        <rdfs:label>Protective eyeglasses for light therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Devices for purifying the blood of a person</iso:description>
        <rdfs:label>Assistive products for dialysis therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.15.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.15.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.15"/>
        <iso:description>Machines used regularly for purifying the blood of a person who has poorly functioning or absent kidneys
Included are, e.g. dialysers, monitors, blood pumps, heparin pumps, air detectors.</iso:description>
        <rdfs:label>Haemodialysis units (HD)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.15.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.15.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.15"/>
        <iso:description>Body-worn devices for continuously purifying the blood of a person with poorly functioning or absent kidneys-
Included are, e.g. infusion unit bags, frames, heaters, fistula cannulas.</iso:description>
        <rdfs:label>Units for continuous ambulant peritoneal dialysis (CAPD)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.15.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.15.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.15"/>
        <iso:description>Devices to connect a person to a dialyser
Included are, e.g. forceps.</iso:description>
        <rdfs:label>Instrument sets for dialysis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Assistive products for dosage, taking, injecting and handling medicines
Included are devices for handling medicine packaging.</iso:description>
        <rdfs:label>Assistive products for administering medicines</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Assistive products for dosage, taking and handling pills and other non-liquid medicines
Included are, e.g. devices for suppositories.</iso:description>
        <rdfs:label>Assistive products for administering non-liquid medicines</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Devices with a trigger for introducing liquid medicines directly into the body through the skin</iso:description>
        <rdfs:label>Injection guns</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Devices with a plunger for introducing liquid medicines directly into the body through a needle inserted in the skin; each syringe is intended for single use only</iso:description>
        <rdfs:label>Injection syringes, single-use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Devices with a plunger for introducing liquid medicines directly into the body through a needle inserted in the skin; each syringe can be sterilized and re-used</iso:description>
        <rdfs:label>Injection syringes, multi-use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Needles intended for single use only</iso:description>
        <rdfs:label>Injection needles, single-use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Needles that can be sterilized and re-used and needles that can stay in the body for a long period of time</iso:description>
        <rdfs:label>Injection needles, multi-use or permanent use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Devices attached to the body for the automatic administration of medicine (including nutrients) directly into the blood vessels Included are, e.g. insulin pumps, feeding pumps, and accessories for parenteral (intravenous) feeding.</iso:description>
        <rdfs:label>Infusion pumps</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Intravenous drip systems for the administration of medicine</iso:description>
        <rdfs:label>Unpowered infusion systems</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.19.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.19.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.19"/>
        <iso:description>Included are, e.g. devices for measuring liquid medicines, devices for handling injection needles and medicine packaging</iso:description>
        <rdfs:label>Other assistive products for administering medicines</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.22 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.22">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Devices that eliminate harmful bacteria, viruses and other microorganisms from assistive products</iso:description>
        <rdfs:label>Sterilizing equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <rdfs:label>Physical, physiological and biochemical test equipment and materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <rdfs:label>Urine analysis equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <rdfs:label>Blood pressure meters (sphygmomanometers)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Included are, e.g. blood glucose monitors</iso:description>
        <rdfs:label>Blood analysis devices, equipment and materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Equipment for monitoring and recording the activities of the heart</iso:description>
        <rdfs:label>Electrocardiogram (ECG) equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Equipment for testing and evaluating functions like joint stability, joint mobility, muscle strength and physical endurance, as well as movement activities like sitting, standing, rolling over and walking</iso:description>
        <rdfs:label>Physical test and evaluation materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Device for auscultation, or listening to the internal sounds of the human body</iso:description>
        <rdfs:label>Stethoscopes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Instruments for measuring the body temperature</iso:description>
        <rdfs:label>Body thermometers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Instruments of measuring body weight</iso:description>
        <rdfs:label>Personal scales</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.28 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.28">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Instruments for measuring weight of a person seated on an assistive product 
Included are, e.g. personal scale for wheelchair user seated on a wheelchair</iso:description>
        <rdfs:label>Personal scales for seated person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.24.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.24.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.24"/>
        <iso:description>Instruments for measuring the volume of air inhaled and exhaled
Included are, e.g. spirometers</iso:description>
        <rdfs:label>Respiration meters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.25 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.25">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Equipment for testing all those functions and activities that are related to logical thinking, intellectual potential and reasoning</iso:description>
        <rdfs:label>Cognitive test and evaluation materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.25.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.25.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.25"/>
        <iso:description>Equipment for testing and evaluating how to use and understand language as a means of communication</iso:description>
        <rdfs:label>Language test and evaluation materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.25.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.25.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.25"/>
        <iso:description>Equipment for testing and evaluating behaviour, attitudes and emotional response</iso:description>
        <rdfs:label>Psychological test and evaluation materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Assistive products to enhance a person’s self-integrity and for training and learning to interact with the outside world both in terms of individual social integration and relationships with others
Included are, e.g. assistive products for doll therapy and social robots</iso:description>
        <rdfs:label>Assistive products to enhance cognitive function</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Devices and software for training a person to remember</iso:description>
        <rdfs:label>Assistive products for memory training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Products for training a person to put words, actions, numbers, etc. in the correct order</iso:description>
        <rdfs:label>Assistive products for training in sequencing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Products for developing concentration and other functions of attention</iso:description>
        <rdfs:label>Assistive products for training in attention</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Products for training a person to understand concepts such as colour, size, and shape</iso:description>
        <rdfs:label>Assistive products for training in concept development</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Products for training a person to group related things together</iso:description>
        <rdfs:label>Assistive products for training in classification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Devices and software for training a person in solving conceptual and specific problems</iso:description>
        <rdfs:label>Assistive products for training in problem solving</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Products to train logical thinking when drawing conclusions from a set of facts and generalizing and interpreting them</iso:description>
        <rdfs:label>Assistive products for training inductive/deductive reasoning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <rdfs:label>Assistive products for developing and enhancing understanding of cause and effect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Included are, e.g. therapy dolls and social robots.</iso:description>
        <rdfs:label>Assistive products for social training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Products for training in the concept and function of time</iso:description>
        <rdfs:label>Assistive products for training in understanding of time</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.26.88 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.26.88">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.26"/>
        <iso:description>Other assistive products to support being and going among other people</iso:description>
        <rdfs:label>Other products to enhance cognitive function</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Equipment for stimulating a muscle or a particular area of a muscle and equipment for stimulating tissue, tendons and joints</iso:description>
        <rdfs:label>Stimulators for treatment on cellular and tissue level</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.27.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.27.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.27"/>
        <iso:description>Equipment for stimulating a muscle or a particular area of a muscle causing it to contract or relax</iso:description>
        <rdfs:label>Muscle stimulators not used as orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.27.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.27.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.27"/>
        <iso:description>Devices made to oscillate rapidly that are used in vibratory massage for therapeutic purposes Included are, e.g. relaxation massage devices, vibrators for loosening mucus in the lungs (percussors).</iso:description>
        <rdfs:label>Vibrators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.27.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.27.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.27"/>
        <iso:description>Included are, e.g. magnetic field stimulation and electric stimulation of bone growth and tissue growth.</iso:description>
        <rdfs:label>Assistive products for stimulating cell growth</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.27.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.27.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.27"/>
        <iso:description>Devices to assist stimulating implanted receivers</iso:description>
        <rdfs:label>Stimulators used in connection with implants</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Assistive products for increasing, reducing or stabilizing sensory stimuli
Included are, e.g. assistive products for sensory integration and perceptual training.</iso:description>
        <rdfs:label>Assistive products for stimulating senses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.28"/>
        <iso:description>Included are e.g. assistive products for light therapy.</iso:description>
        <rdfs:label>Assistive products for stimulating senses with light</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.28"/>
        <iso:description>Assistive products for sound therapy and stimulation of senses with sound waves
Included are, e.g. tinnitus masks.</iso:description>
        <rdfs:label>Assistive products for stimulating senses with sound</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.28"/>
        <iso:description>Assistive product for stimulation of senses by static or dynamic physical touch
Included are, e.g. covers, cushions, clothing, brushes, balls for sensory stimulation</iso:description>
        <rdfs:label>Assistive products for stimulating senses by physical touch</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.28"/>
        <iso:description>Equipment that enables a person to distinguish between, match and categorize external stimuli
Included are, e.g. vibrating chairs (for training deaf persons).</iso:description>
        <rdfs:label>Assistive products for training in perceptual discrimination and matching</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.28"/>
        <iso:description>Equipment for training to improve ability to correctly process and coordinate external stimuli, especially those relating to concepts of space and time, spatial concepts and eye-hand coordination</iso:description>
        <rdfs:label>Assistive products for training in perceptual coordination</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.28.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.28.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.28"/>
        <iso:description>Products for facilitating the coordination and integration of incoming sensory information to the brain from different senses</iso:description>
        <rdfs:label>Assistive products for training in sensory integration</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.29 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.29">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Equipment for pain relief by physiological manipulation or psychological distraction</iso:description>
        <rdfs:label>Assistive products for pain relief</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Devices to produce heat or cold for therapeutic purposes</iso:description>
        <rdfs:label>Assistive products for heat treatment or cold treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.30.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.30.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.30"/>
        <iso:description>Devices for heating the body or an area of the body for therapeutic purposes
Included are, e.g. IR lamps, preheated cushions.</iso:description>
        <rdfs:label>Assistive products for heat treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.30.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.30.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.30"/>
        <iso:description>Devices for cooling the body or an area of the body for therapeutic purposes</iso:description>
        <rdfs:label>Assistive products for cold treatment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Included are, e.g. products to prevent pressure sores and decubitus ulcers.</iso:description>
        <rdfs:label>Assistive products intended to manage tissue integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.33.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.33.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.33"/>
        <iso:description>Devices for tissue integrity through redistribution of the load on the buttocks</iso:description>
        <rdfs:label>Seat cushions and underlays for tissue integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.33.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.33.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.33"/>
        <iso:description>Devices for redistribution of the load on vulnerable parts of the back</iso:description>
        <rdfs:label>Back cushions and back pads for tissue integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.33.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.33.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.33"/>
        <iso:description>Products intended to redistribute the load on vulnerable parts of the body when lying down and to prevent sores and decubitus ulcers</iso:description>
        <rdfs:label>Assistive products for tissue integrity when lying down</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.33.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.33.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.33"/>
        <iso:description>Equipment for evaluating or warning of excess pressure on parts of the body
Included are, e.g. alarms for skin integrity</iso:description>
        <rdfs:label>Special equipment for tissue integrity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Devices used to produce stretching of the spine</iso:description>
        <rdfs:label>Assistive products for spinal traction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <iso:description>Products for training the muscular and cardiovascular system, balance and coordination of physiological body functions</iso:description>
        <rdfs:label>Equipment for movement, strength, balance and cardio training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Stationary cycles for physical exercise
Included are, e.g. arm ergometer cycles, weight bearing treadmill systems.</iso:description>
        <rdfs:label>Exercise and ergometer cycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Stationary equipment for providing support to a person training to improve a gait pattern
Included are, e.g. parallel bars, weight support treadmill systems.</iso:description>
        <rdfs:label>Assistive products for exercising gait pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Equipment for training movement or strengthening the fingers and the hands</iso:description>
        <rdfs:label>Finger and hand exercise devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Equipment for training movement and balance or for strengthening the limbs and the trunk 
Included are, e.g. wall bars, trampolines, gymnasium mats, balance boards, weighted cuffs, equipment that supports aerobic and strength training.</iso:description>
        <rdfs:label>Arm exercise devices, trunk exercise devices and leg exercise devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Devices for providing an audible, a visible or a tactile signal in response to a specific physical or physiological action</iso:description>
        <rdfs:label>Biofeedback devices for movement, strength and balance training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Equipment for supporting a person in the correct position to facilitate therapy and treatment</iso:description>
        <rdfs:label>Assistive products for body positioning during therapy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Included are, e.g. devices for traction of the jaw.</iso:description>
        <rdfs:label>Jaw exercise devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Assistive products for physically enhancing the function of the pelvic floor muscles</iso:description>
        <rdfs:label>Assistive products for training the pelvic floor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Included are, e.g. equipment for training in, e.g. walking and using a wheelchair</iso:description>
        <rdfs:label>Assistive products for training in personal mobility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Stationary equipment for providing support to a person for keeping an upright position</iso:description>
        <rdfs:label>Standing frames and supports for standing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.48.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.48.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04.48"/>
        <iso:description>Platforms for positioning and supporting a person while progressively moving him/her from a lying position to an upright position so that the body can adapt to functioning in that position</iso:description>
        <rdfs:label>Tilting tables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#04.49 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#04.49">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#04"/>
        <rdfs:label>Wound care products</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06">
        <iso:description>Orthoses are externally applied devices used to modify the structural and functional characteristics of the neuromusculoskeletal systems; prostheses are externally applied devices used to replace, wholly or in part, an absent or deficient body segment Included are, e.g. body-powered and externally powered external orthoses, prostheses, orthopaedic footwear.
Excluded are endo-prostheses, which are not part of this document.</iso:description>
        <rdfs:label>Orthoses and prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06"/>
        <iso:description>Orthoses that are designed to modify the structural and functional characteristics of the neuromusculoskeletal systems of the spine and skull; the device may be custom fabricated to meet the functional needs of the individual user or prefabricated to meet a particular set of functional requirements; the prefabricated devices may be adjustable to fit an individual user, or they may be ready-to-use so that adjustment is not possible or no adjustment is necessary for any user</iso:description>
        <rdfs:label>Spinal and cranial orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass whole or part of the sacro-iliac region of the trunk</iso:description>
        <rdfs:label>Sacro-iliac orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole or part of the lumbar and sacro-iliac regions of the trunk</iso:description>
        <rdfs:label>Lumbo-sacral orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole or part of the thoracic region of the trunk</iso:description>
        <rdfs:label>Thoracic orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.08 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.08">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole or part of the thoracic and lumbar regions of the trunk</iso:description>
        <rdfs:label>Thoraco-lumbar orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole or part of the thoracic, lumbar and sacro-iliac regions of the trunk</iso:description>
        <rdfs:label>Thoraco-lumbo-sacral orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole or part of the cervical region, including the atlanto-occipital joint</iso:description>
        <rdfs:label>Cervical orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole cervical and thoracic regions, including the atlanto-occipital joint</iso:description>
        <rdfs:label>Cervico-thoracic orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the whole cervical, thoracic, lumbar and sacro-illiac regions, including the atlanto-occipital joint</iso:description>
        <rdfs:label>Cervico-thoraco-lumbo-sacral orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses that encompass the skull (cranium)</iso:description>
        <rdfs:label>Cranial orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Articulating components of orthoses allow or control the motions of anatomical joints of the spine
Included are, e.g. joints for spinal orthoses.</iso:description>
        <rdfs:label>Articulating components for spinal orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Interface components of orthoses are those in direct contact with the user; they transmit the forces between the orthosis and the user which result from its function and may retain the orthosis in place
Included are, e.g. shells, pads, straps.</iso:description>
        <rdfs:label>Interface components for spinal and cranial orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Structural components of orthoses connect the articulating and interface components and maintain the alignment of the orthosis
Included are, e.g. uprights, shells.</iso:description>
        <rdfs:label>Structural components for spinal and cranial orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Finishing components are the means of providing shape, colour and texture to orthoses
Included are, e.g. fillers, covers, sleeves.</iso:description>
        <rdfs:label>Finishing components for spinal and cranial orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.03.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.03.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.03"/>
        <iso:description>Orthoses, worn in the mouth, used to permit changes in the position of the lower mandible relative to the upper jaw
Included are, e.g. mandibular advancement splints (MAS).</iso:description>
        <rdfs:label>Mandibular advancement devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.04 -->

