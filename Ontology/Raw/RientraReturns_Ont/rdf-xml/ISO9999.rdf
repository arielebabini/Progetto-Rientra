    <!-- http://www.stiima.cnr.it/RRISO#28 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28">
        <iso:description>Products intended to aid a person in engaging in all aspects of a job, trade, occupation or profession, including vocational training
Included are, e.g. machines, devices, vehicles, tools, computer software, production and office equipment, furniture and facilities and materials for vocational assessment and vocational training.
Excluded are products that are mainly used outside the work environment.</iso:description>
        <rdfs:label>Assistive products for work activities and participation in employment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28"/>
        <rdfs:label>Workplace furniture and furnishing elements</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <iso:description>Desks for writing, reading, drawing or drafting mainly used for workplaces
Included are, e.g. office desks, computer desks.</iso:description>
        <rdfs:label>Workdesks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <iso:description>Worktables with specific equipment and accessories for manual work in industry and craft
Included are, e.g. welding tables, assembly tables, carpenter’s benches, mounting tables.</iso:description>
        <rdfs:label>Workbenches</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <iso:description>Adjustable or fixed seating for workplaces
Included are, e.g. assembly seats.</iso:description>
        <rdfs:label>Work chairs and office chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <iso:description>Seats with one or more legs, without or with back or arm supports, which provide general support for a person or specifically for remaining in a standing or near-standing position</iso:description>
        <rdfs:label>Stools and standing chairs for workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <iso:description>Devices that enable easily accessible storage of objects at workplaces
Included are, e.g. component boxes, filing cabinets, containers</iso:description>
        <rdfs:label>Storage and supply systems in workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <rdfs:label>Workplace mats</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.03.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.03.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.03"/>
        <rdfs:label>Partition walls</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28"/>
        <iso:description>Devices for transporting and moving cargo or other objects over longer distances at work</iso:description>
        <rdfs:label>Assistive products for transporting objects in workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.06"/>
        <iso:description>Devices with two or more wheels for transporting goods; a person standing on the floor adjacent to the device operates the device
Included are, e.g. industrial sets of castors, carts, trolleys</iso:description>
        <rdfs:label>Hand operated industrial transport equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06.05 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06.05">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.06"/>
        <iso:description>Powered devices with two or more wheels for transporting goods; a person standing on the floor adjacent to the device operates the device</iso:description>
        <rdfs:label>Powered pedestrian-operated industrial transport equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.06"/>
        <iso:description>Manual or power-driven lifting trucks for lifting and moving loads; a person standing on the floor adjacent to the vehicle operates the vehicle
Included are, e.g. pallet lifting trucks, high-lift pallet trucks</iso:description>
        <rdfs:label>Hand operated lifting trucks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.06"/>
        <iso:description>Powered devices with two or more wheels for transporting goods; a person sitting in or standing on the vehicle operates the vehicle
Included are, e.g. electric tractors.</iso:description>
        <rdfs:label>Powered rider-operated industrial transport vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.06"/>
        <iso:description>Transport vehicles for lifting and transporting loads; a person sitting in or standing on the vehicle operates the vehicle
Included are, e.g. forklift trucks, order-picking stackers.</iso:description>
        <rdfs:label>Powered industrial vehicles used to lift and transport materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.06.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.06.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.06"/>
        <iso:description>Stationary or mobile equipment that transports materials, packages, or other types of items over short distances within a confined path using a moving belt or chain, sets of rollers, vibration or angled chutes
Included are, e.g. conveyor chutes, roller conveyors, belt conveyors, loop and dragline conveyors, vibration conveyors.</iso:description>
        <rdfs:label>Conveyors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28"/>
        <iso:description>Devices for raising or repositioning materials, loads or persons in the work environment.
Included are, e.g. tackles, balancers, manipulators, lifting tables, lifting and positioning robots, industrial robots, cranes.</iso:description>
        <rdfs:label>Assistive products for hoisting and repositioning objects in workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.09.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.09.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.09"/>
        <iso:description>Manually operated or power-driven lifting equipment with winders or pulleys and attachments for the horizontal and vertical transfer of cargo and other objects Included are, e.g. travelling crabs, rotary cranes, overhead cranes, chains, cables, ropes, hooks, pulleys, claw grippers</iso:description>
        <rdfs:label>Cranes, tackles and load handling attachments</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.09.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.09.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.09"/>
        <iso:description>Overhead or floor guided equipment enabling lifting, repositioning and depositing or balancing of cargo and other objects by means of horizontal, vertical and rotary movements
Included are, e.g. remote-controlled manipulators.</iso:description>
        <rdfs:label>Manipulators and weight balancers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.09.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.09.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.09"/>
        <iso:description>Stationary, rotating-sliding or inclinable equipment to position or lift cargo and other objects in comfortable reach of the user
Included are, e.g. lifting tables.</iso:description>
        <rdfs:label>Lifting and positioning systems for workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.09.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.09.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.09"/>
        <iso:description>Platforms for lifting and positioning a person to enable work activity on different levels</iso:description>
        <rdfs:label>Lifting platforms for workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28"/>
        <iso:description>Devices for securing, gripping, holding, carrying, handling and positioning work equipment for easy use</iso:description>
        <rdfs:label>Assistive products for fixing, reaching and grasping objects in workplaces</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.12.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.12.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.12"/>
        <iso:description>Devices that enable a person to grasp, carry and handle objects
Included are, e.g. hand magnets</iso:description>
        <rdfs:label>Assistive products for carrying and gripping workpieces and tools</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.12.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.12.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28.12"/>
        <iso:description>Devices for fixing, securing or positioning tools and other objects used in workplaces such that they can be easily accessed or used by a person
Included are, e.g. screw clamps, vices, clamping devices, brackets, magnets, spring clips, nonslip underlays, rotating tables with compartments, side tables.</iso:description>
        <rdfs:label>Assistive products for fixing and positioning workpieces and tools</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#28.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#28.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#28"/>
        <iso:description>Tools, heavy equipment and other machines adapted or designed for use by a person in workplaces</iso:description>
        <rdfs:label>Machines and tools for use in workplaces</rdfs:label>
    </owl:Class>
    


