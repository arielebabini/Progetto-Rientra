    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#15.15.48 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#15.15.48">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#15.15"/>
        <iso:description>Included are, e.g. doormats</iso:description>
        <rdfs:label>Shoe cleaning devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#15.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#15.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#15"/>
        <iso:description>Products to enable the cultivation or tending of plants or a garden, or in the care of a lawn</iso:description>
        <rdfs:label>Assistive products for gardening and lawn care for domestic use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#15.18.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#15.18.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#15.18"/>
        <iso:description>Products to enable the cultivation or tending of a lawn or a garden that is outside
Included are, e.g. mowers, long-handled pruning shears, weed-grippers</iso:description>
        <rdfs:label>Tools for outdoor gardening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#15.18.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#15.18.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#15.18"/>
        <iso:description>Products that make accessible any indoor or outdoor area for the purpose of gardening
Included are, e.g. elevated beds, accessible greenhouses, designs for accessible gardens</iso:description>
        <rdfs:label>Adapted gardening beds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#15.18.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#15.18.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#15.18"/>
        <iso:description>Products designed to provide protection from injury or additional support for a person tending or cultivating plants
Included are, e.g. kneeling benches</iso:description>
        <rdfs:label>Assistive products for protecting and supporting the body while gardening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#15.18.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#15.18.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#15.18"/>
        <iso:description>Products to enable a person to cultivate, tend or arrange plants or a garden that is inside, and to arrange cut flowers for display</iso:description>
        <rdfs:label>Tools for indoor gardening and flower arrangement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18">
        <iso:description>Furniture and other products that can be placed in, incorporated into or, otherwise, added to, the built environment to facilitate movement and positioning, including entry and exit, within areas constructed for public and private use
Included are, e.g. products for sitting, standing and lying.</iso:description>
        <rdfs:label>Furnishings, fixtures and other assistive products for supporting activities in indoor and outdoor human-made environments</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <iso:description>Included are, e.g. adjustable tables.</iso:description>
        <rdfs:label>Tables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.03.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.03.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.03"/>
        <rdfs:label>Reading desks, writing desks and standing desks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.03.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.03.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.03"/>
        <rdfs:label>Drafting tables and drawing tables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.03.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.03.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.03"/>
        <rdfs:label>Dining tables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.03.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.03.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.03"/>
        <iso:description>Tables designed to be used on, over or beside a bed</iso:description>
        <rdfs:label>Bed tables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Light fixtures</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.06.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.06.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.06"/>
        <iso:description>Lights for illuminating an area directly or indirectly without being concentrated on specific spots</iso:description>
        <rdfs:label>General lights</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.06.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.06.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.06"/>
        <iso:description>Lights for illuminating one specific area in order to facilitate a particular activity</iso:description>
        <rdfs:label>Reading lights and working lights</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.06.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.06.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.06"/>
        <rdfs:label>Podium lights and blackboard lights</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.08.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.08.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Chairs that meet the specific seating requirements of a person
Included are, e.g. high chairs for children, sitting bags, floor seats</iso:description>
        <rdfs:label>Special sitting furniture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <iso:description>Included are, e.g. adjustable sitting furniture.</iso:description>
        <rdfs:label>Sitting furniture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Included are, e.g. chairs with or without a special mechanism to assist a person to stand or sit.</iso:description>
        <rdfs:label>Chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Seats with one or more legs without a back; may have the option of an add-on back
Included are, e.g. stools with a special mechanism to assist a person to stand up or sit down.</iso:description>
        <rdfs:label>Stools</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Seats with one or more legs that provide support for a person remaining in a standing or near-standing position</iso:description>
        <rdfs:label>Standing chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Chairs with a seat which has one or two tilting sections at the front edge
Included are, e.g. arthrodesis chairs and coxit chairs with a special mechanism to assist a person to stand or sit.</iso:description>
        <rdfs:label>Coxit chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Comfortable chairs for general use
Included are, e.g. lounge chairs with a special mechanism to assist a person to stand or sit down.</iso:description>
        <rdfs:label>Lounge chairs and easy chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Devices for transporting a chair without wheels, with or without its occupant</iso:description>
        <rdfs:label>Chair lifts and chair transporters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.09.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.09.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.09"/>
        <iso:description>Seating systems based on a framework to which can be attached selected seat modules, the position of which can then be adjusted to achieve a particular seat configuration
Included are, e.g. chairs assembled from separate elements.</iso:description>
        <rdfs:label>Modular seating systems</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <iso:description>Accessories for providing comfort and support in sitting furniture</iso:description>
        <rdfs:label>Accessories for sitting furniture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.10.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.10.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.10"/>
        <iso:description>Non-mounted products to enhance sitting position and comfort in sitting furniture
Included are, e.g. lumbar supports and back pads.</iso:description>
        <rdfs:label>Back cushions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.10.13 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.10.13">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.10"/>
        <iso:description>Head supports and non-mounted cushions placed at the top of the backrest to provide comfort in sitting furniture</iso:description>
        <rdfs:label>Neck supports and head supports for sitting furniture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.10.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.10.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.10"/>
        <iso:description>Non-mounted products to place in front of the sitting furniture for resting the legs or for supporting the feet
Included are, e.g. leg supports for holding a leg in position to ease care.</iso:description>
        <rdfs:label>Leg rests and foot rests</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.10.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.10.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.10"/>
        <iso:description>Seat cushions with a mechanism that can lift a person up to enable him or her to transfer from a sitting to a standing position; the mechanism may also support the descent of a person while sitting</iso:description>
        <rdfs:label>Cushions or systems added to seats to assist a person to stand or sit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <iso:description>Included are, e.g. beds with adjustable and non-adjustable body positions, detachable bedboards/mattress support platforms</iso:description>
        <rdfs:label>Beds and bed equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Beds with special features such as fixed handrail or fixed supports
Included are, e.g. high beds</iso:description>
        <rdfs:label>Beds and detachable bed boards/mattress support platforms, non-adjustable</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Beds with one or more sections of the mattress support platform that can be adjusted in height or angle; the adjustments are performed manually by the occupant or by an assistant</iso:description>
        <rdfs:label>Beds and detachable bed boards/mattress support platforms with manual adjustment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Beds with one or more sections of the mattress support platform that can be adjusted in height or angle; adjustments are performed by an electric mechanism operated by the occupant or by an assistant</iso:description>
        <rdfs:label>Beds and detachable bed boards/mattress support platforms with powered adjustment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Height adjustable undercarriages on which a standard bed can be mounted, thus, serving as a height adjustable bed</iso:description>
        <rdfs:label>Bed lifts</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Bed linen and products to fix bed linen in a desired position
Included are, e.g. cushions, pillows, blankets, fixing devices for blankets</iso:description>
        <rdfs:label>Bedding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Mattresses and coverings for comfort</iso:description>
        <rdfs:label>Mattresses and mattress coverings</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Frames fitted to the bed to prevent sheets and blankets from placing any weight on the person’s body</iso:description>
        <rdfs:label>Blanket supports</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Devices to support specific parts of the occupant’s body while lying in bed</iso:description>
        <rdfs:label>Separate adjustable back supports and leg supports for beds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.26 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.26">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Foldaway or removable rails for preventing the occupant from falling out of the bed</iso:description>
        <rdfs:label>Side rails to be fixed to beds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.28 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.28">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Removable rails to enable the occupant to change position in bed or to sit up independently</iso:description>
        <rdfs:label>Rails for self-lifting to be fixed to beds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Devices for reducing the length of the bed</iso:description>
        <rdfs:label>Assistive products for bed-shortening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.12.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.12.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.12"/>
        <iso:description>Devices for increasing the size of a bed</iso:description>
        <rdfs:label>Assistive products for bed-lengthening</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Assistive products for height adjustment of furniture</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.15.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.15.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.15"/>
        <iso:description>Devices that are placed under the legs of furniture to increase the length of the legs</iso:description>
        <rdfs:label>Leg extenders</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.15.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.15.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.15"/>
        <iso:description>Height-adjustable surfaces or brackets on which furniture can be mounted</iso:description>
        <rdfs:label>Height-adjustable plinths and brackets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.15.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.15.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.15"/>
        <iso:description>Fixed-height surfaces or brackets on which furniture can be mounted</iso:description>
        <rdfs:label>Pedestals and fixed-height plinths and brackets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Supporting handrails and grab bars</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.18.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.18.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.18"/>
        <iso:description>Bars, usually cylindrical, attached to a wall, floor or other stable structure that provide the means for a person to support or stabilize himself/herself using hands or arms while walking, e.g. up and down stairs or ramps or moving along corridors</iso:description>
        <rdfs:label>Handrails and support rails</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.18.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.18.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.18"/>
        <iso:description>Devices, usually straight or angled bars, that are permanently attached to a wall, a wall and a floor, or a wall, ceiling and floor to provide support to a person while standing or changing position</iso:description>
        <rdfs:label>Fixed grab bars and handgrips</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.18.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.18.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.18"/>
        <iso:description>Devices, usually straight or angled bars, that can be temporarily attached to walls, floors, ceilings or furniture using, e.g. clamps or suction pads and removed without tools providing support to a person while changing position</iso:description>
        <rdfs:label>Removable grab rails and handgrips</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.18.11 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.18.11">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.18"/>
        <iso:description>Devices that provide support to a person when changing her/his position; they can be fixed to a wall or floor and can be folded up or sideways or lowered down to allow access or when they are not needed</iso:description>
        <rdfs:label>Hinged rails and arm supports</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Gate, door, window and curtain openers/closers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.21.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.21.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.21"/>
        <rdfs:label>Door openers and door closers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.21.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.21.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.21"/>
        <rdfs:label>Window openers and window closers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.21.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.21.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.21"/>
        <rdfs:label>Curtain openers and curtain closers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.21.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.21.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.21"/>
        <rdfs:label>Sunblind openers and sunblind closers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.21.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.21.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.21"/>
        <iso:description>Included are, e.g. electric locks.</iso:description>
        <rdfs:label>Locks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <iso:description>Features of the structure of the house that are designed to assist a person to function independently</iso:description>
        <rdfs:label>Construction elements in homes and other premises</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <iso:description>Systems in a house in which liquids or gases can be controlled and distributed
Included are, e.g. water and gas supply fittings, such as single lever taps, thermostatic mixing valves, flexible tubing, siphons, electronic mixing valves.</iso:description>
        <rdfs:label>Plumbing fittings and taps</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <rdfs:label>Windows</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <iso:description>Included are, e.g. sliding doors, up-and-over doors, folding doors, swing doors.</iso:description>
        <rdfs:label>Doors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <iso:description>Floor-level sills positioned at the base of doors or at the entrance to internal areas
Included are, e.g. rubber seals for shower doors, crossover bridges</iso:description>
        <rdfs:label>Thresholds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <rdfs:label>Floor coverings</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <rdfs:label>Stairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.24.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.24.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.24"/>
        <rdfs:label>Counter tops</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Assistive products for vertical accessibility</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Platforms or enclosures raised and lowered in a vertical shaft that provide a method of transport between two or more vertical levels (e.g. building storeys, floors and ship decks)</iso:description>
        <rdfs:label>Elevators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.05 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.05">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Lifting devices that use a platform to move a person or freight between two or more vertical levels, have no roof, do not lift within a shaft and are permanently attached to a structure or the ground
Included are, e.g. wheelchair lifting tables and platform lifts.</iso:description>
        <rdfs:label>Fixed lifting platforms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Lifting devices that have a self-supporting structure that is not portable and not attached to a structure or the ground, use a platform to move a person or freight between two or more vertical levels, have no roof and do not lift within a shaft
Included are, e.g. free-standing wheelchair lifting tables and platform lifts.</iso:description>
        <rdfs:label>Free-standing lifting platforms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.08 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.08">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Lifting devices that have a self-supporting structure that is designed to be portable and not attached to a structure or the ground, use a platform to move a person or freight between two or more vertical levels, have no roof and do not lift within a shaft
Included are, e.g. portable wheelchair lifting tables and platform lifts.</iso:description>
        <rdfs:label>Portable lifting platforms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Lifting devices that have a seat unit attached to one or more rails and that follow the shape and angle of the staircase</iso:description>
        <rdfs:label>Stairlifts with seat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.11 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.11">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Lifting devices that have a platform attached to one or more rails and that follow the shape and angle of the staircase
Included are, e.g. stairlifts for wheelchairs.</iso:description>
        <rdfs:label>Stairlifts with platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Moveable sloping surfaces that bridge a limited gap between two levels</iso:description>
        <rdfs:label>Portable ramps</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Fixed sloping surfaces which bridge a limited gap between two levels</iso:description>
        <rdfs:label>Fixed ramps</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <rdfs:label>Ladders and stepladders</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.30.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.30.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.30"/>
        <iso:description>Motorized devices attached to one or more rails and following the shape and angle of the staircase; serves to support a person walking up or down the stairs</iso:description>
        <rdfs:label>Stair-climbing supports without seat or platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Safety equipment for homes and other premises</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <iso:description>Surface materials that minimize the danger of slipping
Included are, e.g. non-slip mats, non-slip tiles.</iso:description>
        <rdfs:label>Non-slip materials for floors and stairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <iso:description>Soft or shock absorbing mats to limit risk of injuries when falling, e.g. from a bed</iso:description>
        <rdfs:label>Safety mats to prevent injuries</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <rdfs:label>Safety barriers, fences and gates for windows, staircases and lifts</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <iso:description>Devices that automatically stop the flow of gas in order to avoid emergencies</iso:description>
        <rdfs:label>Safety valves for gas supplies</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <rdfs:label>Assistive products for the indoor environment to prevent burns and accidental fires</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <iso:description>Devices for evacuating a person from a dangerous situation</iso:description>
        <rdfs:label>Rescue equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <iso:description>Tactile materials used inside or outside the house, which serve for orientation for, e.g. blind persons
Included are, e.g. tiles, floor coverings, floor mats</iso:description>
        <rdfs:label>Tactile materials for floors and stairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.33.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.33.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.33"/>
        <rdfs:label>Fire-resistant floor coverings</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18"/>
        <rdfs:label>Furniture for storage</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.36.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.36.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.36"/>
        <rdfs:label>Shelves</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.36.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.36.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.36"/>
        <rdfs:label>Cupboards</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.36.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.36.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.36"/>
        <iso:description>Included are, e.g. storage devices at the bedside, combinations of bed-tables, bedside cabinets.</iso:description>
        <rdfs:label>Bedside cabinets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.36.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.36.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.36"/>
        <rdfs:label>Medicine cabinets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#18.36.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#18.36.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#18.36"/>
        <rdfs:label>Fittings for shelves, cupboards and cabinets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22"/>
        <iso:description>Products intended to support, train or replace a person&apos;s capacity to receive, send, produce and process information in different forms, including communicating by language, signs and symbols, receiving and producing messages, carrying on conversations and using communication devices and techniques.
Included are, e.g. devices for seeing, hearing, reading, writing, telephoning, signalling and alarming, information technology</iso:description>
        <rdfs:label>Assistive products for communication and information management</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.03"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <iso:description>Included are, e.g. magnifying devices.</iso:description>
        <rdfs:label>Assistive products for seeing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Devices for absorbing light with defined wavelengths and filtering out those that are unwanted</iso:description>
        <rdfs:label>Light filters (absorption filters)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Devices which enable a person to focus her/his vision
Included are, e.g. spectacle frames and electronic glasses</iso:description>
        <rdfs:label>Spectacles and contact lenses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Devices for enlarging the image of an object.
Included are, e.g. lenses with and without illumination, loupe glasses (spectacles).</iso:description>
        <rdfs:label>Magnifier glasses, lenses and lens systems for magnification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Devices for magnifying the image of a distant object for one or two eyes
Included are, e.g. spectacle-mounted monocular and binocular telescopes</iso:description>
        <rdfs:label>Binoculars and monoculars</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Devices for broadening or changing the angle of the visual field
Included are, e.g. prismatic spectacles, recumbent spectacles</iso:description>
        <rdfs:label>Assistive products for extending and adjusting range and angle of the field of vision</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Devices for displaying an enlarged image of the object that has been transmitted and captured by a camera for direct display via a monitor
Included are, e.g. cameras, control units, monitors and digital systems.</iso:description>
        <rdfs:label>Image-enlarging systems</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.03.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.03.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.03"/>
        <iso:description>Software for enlarging elements in the user interface, which can contain facilities e.g. for choosing colours, focus techniques</iso:description>
        <rdfs:label>Screen magnification software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.06"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <iso:description>Devices for concentrating, amplifying, modulating and transmitting sound for a person with hearing problems
Included are, e.g. hearing aids with built-in tinnitus masking.</iso:description>
        <rdfs:label>Assistive products for hearing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Devices for concentrating and channelling sounds into the ear</iso:description>
        <rdfs:label>Ear-trumpets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Frames of eyeglasses with built-in electronic devices to amplify sound</iso:description>
        <rdfs:label>Spectacle hearing aids</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Devices worn within the ear to amplify sound
Included are, e.g. in-the-canal hearing aids.</iso:description>
        <rdfs:label>In-the-ear hearing aids</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Devices worn behind the ear to amplify sound
Included are, e.g. headband hearing aids.</iso:description>
        <rdfs:label>Behind-the-ear hearing aids</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Devices for receiving, amplifying and transforming sounds into tactile signals</iso:description>
        <rdfs:label>Tactile hearing aids</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Devices for assisting hearing by stimulating the receivers implanted, e.g. in the inner ear</iso:description>
        <rdfs:label>Hearing aids used in connection with implants</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.25 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.25">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Devices for transmitting sound between source and hearing aid Included are induction loop systems, induction loop amplifiers, radio frequency (FM) transmission
systems, infrared (IR) systems and streaming systems</iso:description>
        <rdfs:label>Sound transmission systems for hearing aids</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.06.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.06.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.06"/>
        <iso:description>Included are, e.g. audio connections, spectacle adaptations, remote controls for hearing aids, software, special purpose batteries, rechargeable batteries, battery chargers.</iso:description>
        <rdfs:label>Accessories for assistive products for hearing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.09">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.09"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <iso:description>Devices for assisting a person to communicate through speech</iso:description>
        <rdfs:label>Assistive products for voice and speech functions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.09.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.09.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.09"/>
        <iso:description>Devices that generate mechanical vibrations that resonate in the oral and nasal cavities and can be modulated by the tongue and lips in a normal manner, thereby allowing the production of speech</iso:description>
        <rdfs:label>Voice generators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.09.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.09.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.09"/>
        <iso:description>Devices for increasing the volume of a person’s voice</iso:description>
        <rdfs:label>Voice amplifiers for personal use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.09.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.09.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.09"/>
        <iso:description>Devices to improve fluency and rhythm of speech</iso:description>
        <rdfs:label>Speech flow devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.09.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.09.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.09"/>
        <iso:description>Products for training and developing the use of voice and speech, particularly in relation to the production and awareness of sounds
Included are, e.g. assistive products for training spoken language, S-, F- and Sch-indicators, acoustic spectral analysers.</iso:description>
        <rdfs:label>Assistive products for voice training and speech training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.12"/>
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.30"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <iso:description>Included are products for handling reading and writing materials.</iso:description>
        <rdfs:label>Assistive products for reading, writing and drawing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Devices used for turning pages in e.g., books, newspapers and magazines</iso:description>
        <rdfs:label>Page turners</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Stands, boards, manuscript holders, and cushions for holding or supporting reading and writing materials, e.g. paper and books</iso:description>
        <rdfs:label>Writing boards, reading stands and book support cushions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Devices for assisting a person to write a signature or hand-written characters in the desired position or to produce a printed signature using a stamp</iso:description>
        <rdfs:label>Signature guides, stamps and writing frames</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Devices that enable a limited area of text to be visible at one time</iso:description>
        <rdfs:label>Reading masks and typoscopes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Devices and software for reading aloud printed or digital text with an electronic voice.
Included are reading machines, reading pens, screen readers and electronic voices</iso:description>
        <rdfs:label>Text-to-speech devices and software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Scanners and software used to recognize and transform printed text into digital format.
Included are hand-held scanners</iso:description>
        <rdfs:label>OCR equipment and OCR software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Included are, e.g. software for DAISY players and e-book readers.</iso:description>
        <rdfs:label>DAISY players and e-book readers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Included are, e.g. ball pens, pencils, brushes, drawing compasses, rulers, set squares, and holders for the above.</iso:description>
        <rdfs:label>Manual devices for drawing and handwriting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Devices for producing embossed Braille characters on paper with a special stylus or a stick</iso:description>
        <rdfs:label>Manual Braille writing equipment</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Included are manual and electric typewriters and e.g. Braille typewriters.</iso:description>
        <rdfs:label>Typewriters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Materials for hard copies with special effects for tactile recognition</iso:description>
        <rdfs:label>Special writing paper/plastic</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Portable devices for storing information with the use of braille</iso:description>
        <rdfs:label>Portable note-taking devices for Braille</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Software for writing, editing, organizing and storing text and multimedia materials
Included are e.g. software for word prediction, Braille and DAISY.</iso:description>
        <rdfs:label>Text and multimedia processing software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Software for enabling drawing and painting activities with computers</iso:description>
        <rdfs:label>Drawing and painting software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Products for training and developing reading skills, e.g. strategy, approach and performance</iso:description>
        <rdfs:label>Assistive products for training in reading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.48 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.48">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <iso:description>Products for training and developing writing skills
Included are e.g. assistive products for training in typing</iso:description>
        <rdfs:label>Assistive products for training in writing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.13.51 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.13.51">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.13"/>
        <rdfs:label>Assistive products for Braille training</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.15"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <rdfs:label>Assistive products for calculation and training basic arithmetic</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <iso:description>Included are, e.g. abacuses, slide rules.</iso:description>
        <rdfs:label>Manual devices for calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <iso:description>Included are calculators with, e.g. speech output, large buttons, large display.</iso:description>
        <rdfs:label>Calculators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <rdfs:label>Calculation software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <iso:description>Products designed to assist in the acquisition of the conceptual link between the number of objects, figures and basic arithmetical operations</iso:description>
        <rdfs:label>Assistive products for training and supporting the basics of arithmetic</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <iso:description>Products that enable a person to learn the main characteristics of geometric shapes, and to recognize, name and compare shapes</iso:description>
        <rdfs:label>Assistive products for training in basic geometric skills</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <iso:description>Included are assistive products for understanding valuation, means of payment.</iso:description>
        <rdfs:label>Assistive products in understanding of money</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.15.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.15.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.15"/>
        <iso:description>Products to assist in educating a person in mathematics and the natural sciences such as biology, physics and chemistry</iso:description>
        <rdfs:label>Assistive products for training in mathematics and physical sciences</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.18"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <iso:description>Devices that record or deliver information in audio or visual formats and products that combine any of those functions 
Included are, e.g. audio and video equipment, televisions, sound transmission systems, products that process audio or visual information to enhance its quality and usefulness, such as filtering noises or converting analogue to digital information.</iso:description>
        <rdfs:label>Assistive products that record, play and display audio and visual information</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Devices for recording and playback of sound, e.g. dictaphones and music players</iso:description>
        <rdfs:label>Sound recording and playing devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Devices for saving and playing visual images and motion pictures on tape or other electronic media
Included are, e.g. cameras and projectors</iso:description>
        <rdfs:label>Video recording and playing devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Included are, e.g. radio receivers with audio display.</iso:description>
        <rdfs:label>Radio receivers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Devices for receiving and transmitting mainly one to one remote radio communication
Included are, e.g. Citizens Band (CB), Family Radio Services (FRS), General Mobile, Radio Service (GMRS), marine radios.</iso:description>
        <rdfs:label>Two-way radios</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Included are, e.g. digital and high definition televisions.</iso:description>
        <rdfs:label>Televisions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Closed systems for transmitting images with a camera to a recorder or direct displaying in a remote location</iso:description>
        <rdfs:label>Closed-circuit television systems</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Devices for translating videotext into artificial speech and decoding spoken output to provide video captions
Excluded are speech recognition systems</iso:description>
        <rdfs:label>Decoders for videotext and text television</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Included are, e.g. headset microphones.</iso:description>
        <rdfs:label>Microphones</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <rdfs:label>Loudspeakers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.38 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.38">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <iso:description>Head-worn loudspeakers placed nearby or inside the ear
Included are, e.g. devices that increase the volume of TVs, radios, stereos or are used together with communication amplifiers.</iso:description>
        <rdfs:label>Headphones, earphones and headsets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.18.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.18.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.18"/>
        <rdfs:label>Accessories for audio, video and visual systems</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.21"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <iso:description>Assistive products for communication between persons situated in the same place
Included are products primarily used for face-to-face communication, but with options for distance communication.</iso:description>
        <rdfs:label>Assistive products for face-to-face communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Books/booklets or boards that contain letters, symbols and words to support communication</iso:description>
        <rdfs:label>Letter and symbol sets and boards</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Portable and non-portable electronic devices for alternative and augmentative communication between persons situated in the same place
Included are, e.g. digital electronic displays, output equipment for recorded and synthetic speech.</iso:description>
        <rdfs:label>Dialogue units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Software for communication between persons situated in the same place</iso:description>
        <rdfs:label>Face-to-face communication software</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Products for training in, and learning, finger spelling, i.e. tactile communication for deaf blind persons</iso:description>
        <rdfs:label>Assistive products for training in finger spelling</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Products for training in, and learning, sign languages, i.e. visual languages for deaf persons</iso:description>
        <rdfs:label>Assistive products for training in sign language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Products for training in, and learning, lip-reading Included are, e.g. assistive products for training deaf and hard of hearing persons to understand what other persons say by watching the movement of their lips.</iso:description>
        <rdfs:label>Assistive products for training in lip-reading</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Products for training and learning vocal language supplemented by signing</iso:description>
        <rdfs:label>Assistive products for training in cued speech</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <rdfs:label>Assistive products for training in use of tactile symbols other than Braille</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Included are assistive products for training the use of Bliss, icons, drawings, pictures, and other symbols for communication</iso:description>
        <rdfs:label>Assistive products for training the use of visual symbols for communication</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.21.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.21.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22.21"/>
        <iso:description>Products for teaching the Morse alphabet and training a person to use it</iso:description>
        <rdfs:label>Assistive products for training in Morse communication</rdfs:label>
    </owl:Class>
    


