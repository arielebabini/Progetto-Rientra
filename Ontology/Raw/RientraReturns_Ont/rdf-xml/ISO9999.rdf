    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.36.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.36.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.36"/>
        <iso:description>Devices for cutting or shortening nails</iso:description>
        <rdfs:label>Nail scissors and nail clippers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <iso:description>Devices for washing and styling hair</iso:description>
        <rdfs:label>Assistive products for hair care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.39.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.39.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.39"/>
        <iso:description>Devices for washing hair</iso:description>
        <rdfs:label>Assistive products for shampooing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.39.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.39.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.39"/>
        <iso:description>Devices for grooming hair</iso:description>
        <rdfs:label>Combs and hairbrushes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.39.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.39.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.39"/>
        <iso:description>Devices for drying and styling the hair</iso:description>
        <rdfs:label>Hair dryers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <rdfs:label>Assistive products for dental care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.42.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.42.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.42"/>
        <rdfs:label>Unpowered toothbrushes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.42.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.42.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.42"/>
        <iso:description>Included are, e.g. oral irrigation syst</iso:description>
        <rdfs:label>Powered toothbrushes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <iso:description>Devices used to assist when applying cosmetics or skin care products to the face or to perform
other types of facial grooming</iso:description>
        <rdfs:label>Assistive products for facial care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.45.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.45.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.45"/>
        <rdfs:label>Shaving brushes, razors and (electric) shavers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.45.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.45.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.45"/>
        <iso:description>Devices that are used to apply such products as make-up, lotion and facial cream</iso:description>
        <rdfs:label>Assistive products for application of facial products</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.45.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.45.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.45"/>
        <rdfs:label>Mirrors for facial care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.54 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.54">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <iso:description>Devices used in relation with sexual activity</iso:description>
        <rdfs:label>Assistive products for sexual activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.54.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.54.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.54"/>
        <iso:description>Imitations for use in relation with sexual activity
Included are, e.g. penis, vagina and whole-body (inflatable love doll) dummies.</iso:description>
        <rdfs:label>Dummies for sexual activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.54.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.54.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.54"/>
        <iso:description>Assistive products for men to enhance erectile function
Included are, e.g. penis pumps and penis rings.</iso:description>
        <rdfs:label>Assistive products for erection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.54.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.54.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.54"/>
        <iso:description>Vibrating devices for sexual activity</iso:description>
        <rdfs:label>Vibrators for sexual activity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.54.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.54.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.54"/>
        <iso:description>Included are, e.g. assistive products for dilation of the vagina.</iso:description>
        <rdfs:label>Assistive products for sexual habilitation and rehabilitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.54.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.54.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.54"/>
        <iso:description>Penal sheaths to protect against pregnancy or venereal deseases</iso:description>
        <rdfs:label>Condoms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12">
        <iso:description>Products intended to support or replace a person’s capacity to move indoors and outdoors, to transfer from one place to another or to use personal or public transportation</iso:description>
        <rdfs:label>Assistive products for activities and participation relating to personal mobility and transportation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.02 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.02">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Included are, e.g. walking chairs.</iso:description>
        <rdfs:label>Assistive products for walking, not manipulated by the arms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Devices supporting the user when walking, used singly or in pairs, each manipulated by one of the arms or hands</iso:description>
        <rdfs:label>Assistive products for walking, manipulated by one arm</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Hand-held devices providing support and balance when walking, comprising handgrip without a forearm support, shaft and one tip
Included are, e.g. hiking poles.</iso:description>
        <rdfs:label>Walking sticks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Hand-held devices providing support and balance when walking, comprising elbow support, shaft, handgrip and tip(s)</iso:description>
        <rdfs:label>Elbow crutches</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Hand-held devices providing support and balance when walking, comprising horizontal support for the forearm, hand grip, shaft and one tip</iso:description>
        <rdfs:label>Forearm crutches</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Hand-held devices providing support and balance when walking, comprising axilla support, shaft, handgrip and tip(s)</iso:description>
        <rdfs:label>Axillary crutches</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.16 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.16">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Walking devices providing support and balance which have a handgrip, shaft and three or more legs with tips</iso:description>
        <rdfs:label>Multi-tip walking sticks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Devices providing support when walking that have a hand grip without a forearm support, shaft(s), one or more tips (ferrules) and a seat, usually folding, attached to the hand grip or shaft</iso:description>
        <rdfs:label>Walking sticks with seat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Walking frames for stabilization that are manipulated with one arm and held at the side of the body; they have four legs with tips (ferrules), one or two handles</iso:description>
        <rdfs:label>Lateral support frames</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.03.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.03.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.03"/>
        <iso:description>Walking sticks and crutches with wheels or castors instead of tips</iso:description>
        <rdfs:label>Walking sticks with wheels</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Devices supporting the user when walking, manipulated by either both arms, the upper body, or by other means</iso:description>
        <rdfs:label>Assistive products for walking, manipulated by both arms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.06"/>
        <iso:description>Frames which a person lifts to move, that enable to support full body weight and to maintain stability and balance while walking or standing, that have hand grips, do not provide forearm support, and with either four legs with tips or two legs with tips and two legs with castors/wheels
Included are, e.g. rigid and articulated walking frames.</iso:description>
        <rdfs:label>Walking frames</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.06"/>
        <iso:description>Walking devices which can be moved by pushing or pulling, that enable a person to maintain stability and balance while walking, and have hand grips and three or more legs with castors/wheels
Included are, e.g. rollators with a seat for resting, knee walkers, reverse rollators that are
pulled with the opening in the front.</iso:description>
        <rdfs:label>Rollators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.06"/>
        <iso:description>Frames which can be moved by pushing and/or lifting that enable a person to improve stability and balance while walking and standing, with hand grips, without forearm supports and with four or more wheels</iso:description>
        <rdfs:label>Walking trolleys</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.06"/>
        <iso:description>Devices with wheels and seat or sling that support the body when walking, with or without forearm support</iso:description>
        <rdfs:label>Walking chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.06"/>
        <iso:description>Devices with wheels and tips and a supporting table or forearm support, pushed forward by both arms, possibly in combination with the upper body</iso:description>
        <rdfs:label>Walking tables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.06.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.06.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.06"/>
        <rdfs:label>Powered rollators</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Devices designed for use with assistive products for walking with a specific purpose</iso:description>
        <rdfs:label>Accessories for assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.05 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.05">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Products that fit over the bottom of walking sticks, canes or crutches or the ends of walking frame or rollator legs to enhance the stability of the assistive product for walking
Included are, e.g. tips with additional anti-slip material, tips for walking on ice, flexible tips.</iso:description>
        <rdfs:label>Tips for assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Devices that enable a person to grasp securely a walking stick, cane, crutch, walking frame or rollator
Included are, e.g. adjusted grips, grips with anti-slip material, grips of special material such as foam.</iso:description>
        <rdfs:label>Products to properly grip assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Products attached to an assistive product for walking that support specific body parts so that the user remains properly positioned while the product is in use Included are, e.g. underarm supports, back supports, head supports, safety belts.</iso:description>
        <rdfs:label>Accessories for assistive products for walking to provide support for specific body parts</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Products, e.g. pads and cushions, that can be added to walking sticks, canes, crutches, walking frames, rollators and walking tables to protect the user from bruising or skin injury caused by repeated contact with a specific part of the assistive product for walking</iso:description>
        <rdfs:label>Accessories for assistive products for walking to protect from injury</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Seats that can be added to canes, walking frames, rollators and walking tables that can support the weight of the person using the assistive product for walking
Included are, e.g. foldable and non-foldable solid seats for rollators, sling seats for rollators and walking tables.</iso:description>
        <rdfs:label>Seats for assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Included are, e.g. baskets, pouches, hooks, lay trays, tables, bags, holders for oxygen units, holders for umbrellas.</iso:description>
        <rdfs:label>Accessories attached to assistive products for walking to hold or carry objects</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Devices to fix in place a walking stick, cane, crutch or walking frame
Included are, e.g. walking stick holders or cane holders attached to a table.</iso:description>
        <rdfs:label>Products to hold assistive products for walking in place when not in use</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Products added to assistive products for walking to enable the user to go in a desired direction and to control speed Included are, e.g. push bars, anti-swivelling wheels, devices to overcome thresholds and curbs, brakes.</iso:description>
        <rdfs:label>Accessories to enable a person to manoeuvre assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Devices that can be added or attached to a rollator or walking frame to increase the height of assistive products for walking</iso:description>
        <rdfs:label>Accessories to adjust height of rollators and walking frames</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Devices that can be attached to an assistive product for walking to illuminate its surroundings or to mark its position
Included are, e.g. reflectors</iso:description>
        <rdfs:label>Lights and safety signalling devices for assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Wheels that can be added to a walking frame with two wheels or a rollator to replace existing wheels, or wheels that can be attached to a walking frame on legs not originally equipped with wheels
Included are, e.g. wheels that include a portion of the leg of a walking frame or rollator.</iso:description>
        <rdfs:label>Tyres and wheels for assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.07.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.07.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.07"/>
        <iso:description>Units that can be attached to assistive products for walking, and that propel wheels or that can adjust height, width, folding or walking orientation</iso:description>
        <rdfs:label>Power assist units for assistive products for walking</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.08 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.08">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Tactile canes for navigation or identification of the surroundings used by a person with a visual impairment</iso:description>
        <rdfs:label>Guide canes and symbol canes for orientation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.08.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.08.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.08"/>
        <iso:description>Long canes for navigation and identification while walking</iso:description>
        <rdfs:label>Guide canes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.08.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.08.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.08"/>
        <iso:description>Short symbol canes used primarily to alert others about the user&apos;s visual impairment</iso:description>
        <rdfs:label>Symbol canes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.08.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.08.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.08"/>
        <iso:description>Including, e.g. tips, wrist straps, handles, reflectors.</iso:description>
        <rdfs:label>Accessories for guide canes and symbol canes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Automobiles, vans and trucks for personal use and vans for use in public transportation that are manufactured to accommodate operators or passengers with disability</iso:description>
        <rdfs:label>Cars, vans and pick-up trucks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.10.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.10.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.10"/>
        <iso:description>Cars, vans and pick-up trucks that enable drivers or passengers to enter and exit by lowering the vehicle’s chassis to bring the floor of the vehicle to ground level</iso:description>
        <rdfs:label>Cars, vans and pick-up trucks with height-adjustable chassis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.10.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.10.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.10"/>
        <iso:description>Motorized vehicles with a restricted maximum speed for use on public roads; used in some countries to allow a person to drive without a driver’s licence</iso:description>
        <rdfs:label>Low-speed cars</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.10.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.10.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.10"/>
        <iso:description>Cars, vans and pick-up trucks that are originally equipped with a high roof to accommodate a person in a wheelchair inside of the vehicle</iso:description>
        <rdfs:label>Cars, vans and pick-up trucks with raised roof</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.11 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.11">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Vehicles intended to transport groups of people as part of a public or commercial transit system 
Included are, e.g. buses, rail cars, airplanes, trams.</iso:description>
        <rdfs:label>Mass transit vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.11.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.11.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.11"/>
        <iso:description>Buses that enable passengers to enter and exit by lowering the vehicle’s chassis to bring the floor of the vehicle to ground level</iso:description>
        <rdfs:label>Buses with height-adjustable chassis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.11.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.11.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.11"/>
        <iso:description>Train cars that have a lowered floor to facilitate entry and exit of the train with or without the use of a ramp
Included are, e.g. subway cars, trams.</iso:description>
        <rdfs:label>Trains with low floors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Products that can be added to vehicles or modifications made to vehicles that either enable the vehicle to be operated by persons with disability or permit persons with disability to
enter, exit or ride in the vehicle safely</iso:description>
        <rdfs:label>Vehicle accessories and vehicle adaptations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.05 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.05">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Products and modifications that assist the operator to vary the speed of the vehicle, including slowing down and stopping it
Included are, e.g. running brakes, parking brakes</iso:description>
        <rdfs:label>Vehicle accessories and vehicle adaptations to control speed</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Products and modifications that can be added to a motor vehicle that assist the operator to manoeuvre a vehicle
Included are, e.g. steering-wheel knobs, servosystems for steering, extensions of the steering column.</iso:description>
        <rdfs:label>Vehicle accessories and vehicle adaptations to operate steering system</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.08 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.08">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Included are, e.g. products relating to the use of adjustable mirrors, door locks, windscreen wipers, indicators, turn signals, lights.</iso:description>
        <rdfs:label>Accessories and adaptations to complementary functions necessary to operate vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Devices for restraining a person in a vehicle to enhance safety during travelIncluded are, e.g. three- and four-point seat belts and belt vests added to a vehicle’s seat, seat belts that attach to a vehicle to restrain a passenger who is seated in a wheelchair within the vehicle.</iso:description>
        <rdfs:label>Vehicle occupant restraining systems</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Devices designed either to enable a person to get into or out of a seat in a motor vehicle, or for supporting a person who is seated during travel
Included are, e.g. child safety seats, swivelling seats, elevating seats, sliding seats.</iso:description>
        <rdfs:label>Seats and cushions for motor vehicles and accessories and adaptations relating to seating in vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Equipment installed in a vehicle for lifting a person into or out of a vehicle</iso:description>
        <rdfs:label>Hoists to transfer person into or out of vehicles without wheelchair</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Devices for lifting a person and a wheelchair in which he/she is seated into or out of a vehicle or to allow a person in a wheelchair to roll into a vehicle
Included are, e.g. hoists to transfer a person in a wheelchair into or out of a vehicle, ramps installed in a vehicle to facilitate the loading or unloading of an occupied wheelchair, lifting platforms installed in a vehicle to facilitate the loading or unloading of an occupied wheelchair.</iso:description>
        <rdfs:label>Assistive products for transferring person seated in wheelchair into or out of vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Devices for lifting and positioning an unoccupied wheelchair onto or inside a vehicle
Included are, e.g. car hoists and winches for wheelchair.</iso:description>
        <rdfs:label>Assistive products for loading unoccupied wheelchairs onto or into vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Devices for securing a wheelchair in a vehicle
Included are, e.g. wheelchair tie-downs.</iso:description>
        <rdfs:label>Assistive products for fastening wheelchairs in vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Modifications to a vehicle’s chassis, frame or other systems to increase its accessibility, usability or comfort for an operator or a passenger with a disability
Included are, e.g. raised roofs, enlarged windows, suspension systems</iso:description>
        <rdfs:label>Vehicle chassis and body adaptations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.12.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.12.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.12"/>
        <iso:description>Racks or frames that can be mounted on the roof or the back of a vehicle to transport an unoccupied wheelchair or trailers that can be attached to the rear of a vehicle that are specifically designed to transport one or more wheelchairs
Included are, e.g. products to transport scooters.</iso:description>
        <rdfs:label>Products to carry unoccupied wheelchairs on or attached to vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.16 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.16">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <rdfs:label>Mopeds and motorcycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.16.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.16.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.16"/>
        <rdfs:label>Two-wheeled mopeds and motorcycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.16.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.16.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.16"/>
        <rdfs:label>Three-wheeled mopeds and motorcycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.17 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.17">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Included are, e.g. stand-on mobility devices, snowmobiles, snow scooters, all-terrain vehicles, go-carts</iso:description>
        <rdfs:label>Diverse motorized vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.17.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.17.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.17"/>
        <iso:description>Powered devices, operated by an attendant and not attached or connected to the stairs or the walls or ceiling adjacent to a stairway, intended to transport a person by climbing up or down stairs
Included are, e.g. powered emergency evacuation carriers</iso:description>
        <rdfs:label>Powered stair-climbing transporters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.17.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.17.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.17"/>
        <iso:description>Vehicles that are driven by the user standing on them; they have two or more wheels, handlebar and a base to stand on and may have a small seat for resting</iso:description>
        <rdfs:label>Stand-on motorized vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.17.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.17.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.17"/>
        <iso:description>Included are, e.g. all-terrain vehicles, four wheelers, snowmobiles, snow scooters, go-carts.</iso:description>
        <rdfs:label>Diverse four-wheeled motorized vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Included are, e.g. power-assisted cycles.</iso:description>
        <rdfs:label>Cycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Pedal-propelled, two-wheeled cycles for one person</iso:description>
        <rdfs:label>Foot-propelled bicycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.05 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.05">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Hand-propelled, two-wheeled cycles for one person</iso:description>
        <rdfs:label>Hand-propelled bicycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Cycles with three or more wheels for one person, pedal propelled
Included are, e.g. carrier cycles.</iso:description>
        <rdfs:label>Foot-propelled tricycles and quadricycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Hand-propelled cycles with three or four wheels</iso:description>
        <rdfs:label>Hand-propelled tricycles and quadricycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Devices with two or more seats to allow riding for more than one person, pedal-propelled</iso:description>
        <rdfs:label>Tandems, tricycles and four-wheeled cycles for two or more persons</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Additions or changes made to cycles to facilitate their operation
Included are, e.g. additional motors, trainer wheels.</iso:description>
        <rdfs:label>Cycle adaptations</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.18.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.18.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.18"/>
        <iso:description>Trailers to attach to cycles for carrying cargo</iso:description>
        <rdfs:label>Trailers for cycles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Devices providing wheeled mobility with a seating support system for a person with limitation in mobility and that rely on an occupant or an assistant to provide power for the operation Included are, e.g. stand-up manual wheelchairs (wheelchairs that enable a person to raise and maintain a standing position), reclining manual wheelchairs, snow wheelchairs, beach wheelchairs, wheelchairs for use in a pool, wheelchair frames.</iso:description>
        <rdfs:label>Manual wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Wheelchairs designed to be propelled and steered by the occupant, by pushing with both hands, on the wheels or on the handrims of the wheels
Included are, e.g. front-wheel drive, rear-wheel drive wheelchairs</iso:description>
        <rdfs:label>Bimanual handrim-drive wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Wheelchairs designed to be propelled and steered by the occupant using two-hand operated levers</iso:description>
        <rdfs:label>Bimanual lever-drive wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Wheelchairs designed to be propelled by the occupant using only one hand
Included are, e.g. one-hand lever-drive wheelchairs, one handrim-drive wheelchairs</iso:description>
        <rdfs:label>Single-side manual drive wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Occupant operated wheelchairs with a combination of human power and electrical power, where the activation of the electrical power is through application of a torque, displacement or force to the handrims</iso:description>
        <rdfs:label>Handrim-activated power-assisted wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <rdfs:label>Foot-propelled wheelchairs</rdfs:label>
        <rdfs:label>Wheelchairs designed to be propelled and steered by contact of the occupant’s foot or feet with the floor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Manual wheelchairs intended to be pushed and steered by an assistant, by pushing with both hands on the push handles of the wheelchair</iso:description>
        <rdfs:label>Push wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Wheelchairs designed to be propelled and steered by an assistant by pushing with both hands on the push handles of the wheelchair, with one or two electric mechanisms to help rotate one or both of the wheels</iso:description>
        <rdfs:label>Power-assisted push wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.22.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.22.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.22"/>
        <iso:description>Manual wheelchairs that can safely climb and descend stairs, possibly operated by an assistant, while occupied by the occupant</iso:description>
        <rdfs:label>Stair-climbing manual wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Devices with powered propulsion, intended to provide wheeled mobility with a seating
support system for a person with limitation in mobility; the motor power is derived from an integral source of electric or combustion power 
Included are, e.g. stand-up powered wheelchairs (wheelchairs that are capable of raising and maintaining a person in a standing position), reclining powered wheelchairs, wheelchairs with elevating or tilt-in-space seats, snow wheelchairs, beach wheelchairs, wheelchair power units.</iso:description>
        <rdfs:label>Powered wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.23"/>
        <iso:description>Wheelchairs powered by electricity, with control of direction (steering) by mechanically changing the orientation of the pivot drive wheel(s) without powered assistance
Included are, e.g. scooters</iso:description>
        <rdfs:label>Electrically powered wheelchairs with manual direct steering</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.23"/>
        <iso:description>Electrically powered wheelchairs activated with an electronic controller by the occupant
Included are, e.g. self-balancing wheelchairs</iso:description>
        <rdfs:label>Electrically powered wheelchairs with electronic steering</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.23"/>
        <iso:description>Wheelchairs powered by a combustion engine</iso:description>
        <rdfs:label>Combustion powered wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.23"/>
        <iso:description>Electrically powered wheelchairs manoeuvred by an assistant with an electronic controller or a remote controller</iso:description>
        <rdfs:label>Assistant-controlled electrically powered wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.23"/>
        <iso:description>Electrically powered wheelchairs that can safely climb and descend stairs while occupied and operated by the occupant</iso:description>
        <rdfs:label>Stair-climbing powered wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.23.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.23.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.23"/>
        <iso:description>Two-wheeled powered wheelchairs maintaining balance without casters and being manoeuvred through the body movements of the occupant or a joystick</iso:description>
        <rdfs:label>Self-balancing wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Devices related to the use of wheelchairs</iso:description>
        <rdfs:label>Wheelchair accessories</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Devices for controlling a wheelchair’s movements and its direction of travel</iso:description>
        <rdfs:label>Steering and control systems for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Devices that are added to a manual wheelchair to propel the wheelchair with or without human propulsion
Included are, e.g. add-on power kits used for propulsion</iso:description>
        <rdfs:label>Propulsion units for manual wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.11 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.11">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Devices added to a manual wheelchair to transform it into a handbike, hand-propelled</iso:description>
        <rdfs:label>Half-handbikes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Devices that can be attached to a wheelchair to illuminate the wheelchair’s surroundings or to mark the position of the wheelchair
Included are, e.g. wheelchair safety flags, reflectors</iso:description>
        <rdfs:label>Lights and safety signalling devices for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Devices for slowing down or stopping a wheelchair or holding it in a fixed position</iso:description>
        <rdfs:label>Running or parking brakes for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Included are, e.g. snow runners, hub caps</iso:description>
        <rdfs:label>Tyres, wheels and castors for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Devices to supply electric power to a wheelchair</iso:description>
        <rdfs:label>Batteries and battery chargers for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.28 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.28">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Included are, e.g. wheelchair cleaning systems, brushes for wheelchair tires.</iso:description>
        <rdfs:label>Devices for cleaning wheelchairs or any part of wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.34 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.34">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Included are, e.g. umbrellas and canopies for wheelchairs.</iso:description>
        <rdfs:label>Devices to protect wheelchairs and their occupants from sunlight or precipitation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Coupling systems that connect a wheelchair to a bicycle</iso:description>
        <rdfs:label>Devices to connect a wheelchair to a bicycle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Carts and other types of vehicles, manually or electrically powered, to which a wheelchair can be securely fastened that allow the wheelchair, while occupied, to climb and descend stairs safely</iso:description>
        <rdfs:label>Devices to which a wheelchair is attached that facilitate movement up and down stairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Products that are fixed to a wheelchair to carry one or more objects
Included are, e.g. pouches, baskets and cases that are attached to a wheelchair, cane and crutch holders, walker carriers, trailers for wheelchairs.</iso:description>
        <rdfs:label>Devices attached to wheelchairs to hold or carry objects</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.24.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.24.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.24"/>
        <iso:description>Included are, e.g. rear view mirrors, cameras.</iso:description>
        <rdfs:label>Devices to check surroundings of wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Accessories for providing support for the sitting position in wheelchairs
Included are, e.g. lap trays for attaching to the wheelchair</iso:description>
        <rdfs:label>Accessories wheelchair seating</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.25"/>
        <iso:description>Accessories that are interchangeable with the original back support of the wheelchair
Included are, e.g. components of back supports and brackets for mounting</iso:description>
        <rdfs:label>Back supports for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.25"/>
        <iso:description>Cushions and other devices that are placed on a seat to correct and maintain a stable sitting position</iso:description>
        <rdfs:label>Seat cushions and underlays</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.25"/>
        <iso:description>Supports for stabilizing a person’s head while seated in a wheelchair
Included are, e.g. components of head supports and brackets for mounting</iso:description>
        <rdfs:label>Head supports and neck supports for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.25"/>
        <iso:description>Included are, e.g. leg supports, foot supports, footplates, stump supports that are attached to a wheelchair, abductors, adductors, knee separators</iso:description>
        <rdfs:label>Leg supports and foot supports for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.25"/>
        <iso:description>Devices that are attached to or incorporated into a wheelchair to provide support to, or to stabilize, a person’s shoulders, torso, hips or pelvic region when sitting</iso:description>
        <rdfs:label>Trunk supports and pelvic supports for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.25.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.25.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.25"/>
        <iso:description>Products that can be attached to a wheelchair or placed on the lap of a sitting person that provide a flat surface that may stabilize the sitting position and on which activities can be carried out or objects can be placed</iso:description>
        <rdfs:label>Lap trays for wheelchairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <rdfs:label>Diverse human powered vehicles</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Devices for short distance transportation of a person in a sitting position, manoeuvred and controlled by an assistant 
Included are, e.g. emergency evacuation chairs, transport chairs adapted for climbing or
descending stairs.</iso:description>
        <rdfs:label>Transportation chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.07 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.07">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Wheeled devices for carrying one or more person(s) in a lying or sitting position, designed to be manoeuvred and controlled by an assistant
Included are, e.g. prams and buggies for adults.</iso:description>
        <rdfs:label>Prams and buggies</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Devices for conveying a person over ice and snow, mounted on runners with or without wheels
Included are, e.g. kick-sledges.</iso:description>
        <rdfs:label>Sledges</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Wheeled devices on which a person lies or sits and moves by pushing on the floor with the arms or legs</iso:description>
        <rdfs:label>Crawlers and mobility boards</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.19 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.19">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Pedal cars are small car-shaped vehicles propelled by pedals; playing carts are wheeled toys for sitting on or in, to enable mobility</iso:description>
        <rdfs:label>Pedal cars and playing carts</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.20 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.20">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Manually propelled mobile platforms designed to transport a person in a lying position</iso:description>
        <rdfs:label>Wheeled stretchers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.22 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.22">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Sit-on vehicle with saddle and handlebars, propelled by pushing with the feet</iso:description>
        <rdfs:label>Running bikes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.23 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.23">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Stand-on vehicle with handlebars propelled by pushing with one foot</iso:description>
        <rdfs:label>Unpowered scooters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.27.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.27.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.27"/>
        <iso:description>Devices that are propelled by the occupant using the arms and are used in a standing position only</iso:description>
        <rdfs:label>Manually powered stand-on mobility devices</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <rdfs:label>Assistive products for changing body position</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices for changing position or direction of a person using sliding and turning techniques
Included are, e.g. sliding boards, sliding mats, turning sheets, turning cushions.</iso:description>
        <rdfs:label>Assistive products for sliding and turning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices to assist a person in a standing or near-standing position to make a rotating movement  where the feet are placed on the device when moving</iso:description>
        <rdfs:label>Turntables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices to support a person rising from a sitting or lying position (e.g. from a bed or chair)</iso:description>
        <rdfs:label>Not mounted rails for self-lifting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices, fixed at one end, for assisting a person to change his/her body position step by step</iso:description>
        <rdfs:label>Grip ladders</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices for assisting a person to move another person manually</iso:description>
        <rdfs:label>Lifting belts and harnesses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices for moving a person from one place to another carried by one or more assistants</iso:description>
        <rdfs:label>Carrying chairs, carrying harnesses and carrying baskets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Devices for moving a standing person a short horizontal distance</iso:description>
        <rdfs:label>Transfer platforms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.31.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.31.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.31"/>
        <iso:description>Transfer equipment for lifting a person from the floor to e.g. a bed or to a sitting position wherefrom standing up may be possible</iso:description>
        <rdfs:label>Lifting seats and lifting mattresses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12"/>
        <iso:description>Equipment for transferring by lifting and (re)positioning a person to enable an intended activity</iso:description>
        <rdfs:label>Assistive products for lifting persons</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.36.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.36.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.36"/>
        <iso:description>Equipment for transferring by lifting and freely moving a person in a sitting, near-sitting and semi-lying position; the body support unit consists of slings</iso:description>
        <rdfs:label>Mobile hoists for transferring a person in sitting position with sling seats</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.36.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.36.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.36"/>
        <iso:description>Equipment for transferring and repositioning a person from a sitting position into an upright standing position; the equipment can be moved around freely; the body support consists of slings, a foot support and leg or knee support</iso:description>
        <rdfs:label>Mobile hoists for transferring a person in standing position</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.36.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.36.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.36"/>
        <iso:description>Equipment for transferring by lifting and freely moving a person in a sitting position; the body support unit consists of a solid seat, a spade seat or equivalent</iso:description>
        <rdfs:label>Mobile hoists for transferring a person in sitting position with solid seats</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.36.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.36.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.36"/>
        <iso:description>Equipment for transferring by lifting and freely moving a person in a lying position; the body support unit is vertically adjustable but not horizontally revolving</iso:description>
        <rdfs:label>Mobile hoists for transferring a person in lying position</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#12.36.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#12.36.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#12.36"/>
