    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.04.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.04"/>
        <iso:description>Interface components in direct contact with the user; they transmit the forces between the orthosis and the user which result from its function and may retain the orthosis in place
Included are, e.g. shells, pads, straps.</iso:description>
        <rdfs:label>Interface components for abdominal orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.04.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.04.12">
