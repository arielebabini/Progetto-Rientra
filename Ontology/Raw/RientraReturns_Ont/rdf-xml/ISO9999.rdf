    <!-- http://www.stiima.cnr.it/RRISO#09.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <rdfs:label>Assistive products for toileting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Chairs, with or without castors, with a collection receptacle used for toileting away from the bathroom
Included are, e.g. sanichairs, toilet wheelchairs, commode chairs also used for showering.</iso:description>
        <rdfs:label>Commode chairs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Included are, e.g. raised or height adjustable toilets, toilets with built-in douche and air dryers.</iso:description>
        <rdfs:label>Toilets</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices attached to the toilet bowl or toilet chair for a person to sit on; they can provide stability and comfort</iso:description>
        <rdfs:label>Toilet seats</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.10 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.10">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices to keep bodily substances from splashing outside the toilet bowl</iso:description>
        <rdfs:label>Toilet splash guards</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Raised toilet seats (separate) standing on floor, where the seat can easily be removed from the toilet bowl
Included are, e.g. over toilet frames.</iso:description>
        <rdfs:label>Raised toilet seats, free-standing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Raised toilet seats (loose attachments) placed directly on the toilet bowl/toilet seat where the seat insert can easily be removed from the toilet bowl/toilet seat</iso:description>
        <rdfs:label>Raised toilet seats, detachable</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices permanently fixed on to a toilet bowl to increase the height of the seat and to facilitate sitting down upon, and standing up from, the toilet
Included are, e.g. plinths.</iso:description>
        <rdfs:label>Raised toilet seats fixed to toilet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Toilet seats that have a built-in lifting mechanism to assist a person to sit down on and get up from the toilet</iso:description>
        <rdfs:label>Toilet seats with built-in raising mechanism to assist standing up and sitting down</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices mounted on the toilet that provide support getting on or off the toilet
Included are, e.g. body supports mounted on the toilet.</iso:description>
        <rdfs:label>Toilet arm supports and toilet back supports mounted on toilet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.25 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.25">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <rdfs:label>Toilet arm supports and toilet back supports, free-standing</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices for holding toilet paper and facilitating bottom wiping</iso:description>
        <rdfs:label>Toilet paper tongs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices for holding toilet paper in an accessible position</iso:description>
        <rdfs:label>Toilet roll holders</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Containers for collecting bodily waste matter, enabling a person to urinate and defecate while, e.g. in bed</iso:description>
        <rdfs:label>Bedpans</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Devices attached to a toilet to provide a water spray with or without air blowing afterwards to wash, and possibly dry, a person’s bottom while sitting on the toilet
Included are, e.g. toilet seats with that function.</iso:description>
        <rdfs:label>Douches and air dryers for attachment to a toilet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Sanitary equipment mounted on the wall to enable a man to urinate in a standing position</iso:description>
        <rdfs:label>Wall-mounted urinals</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.43 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.43">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Included are, e.g. transportable toilet booths.</iso:description>
        <rdfs:label>Transportable hygiene rooms</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.12.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.12.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.12"/>
        <iso:description>Pads specifically designed for toilet seats and commode chair seats for better comfort and distribution of pressure</iso:description>
        <rdfs:label>Padding for toilet seats</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <rdfs:label>Assistive products for tracheostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.15.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.15.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.15"/>
        <iso:description>Tubes that are placed in an opening in the windpipe of a person with a tracheostomy to enable that person to breathe</iso:description>
        <rdfs:label>Tracheostoma cannulas</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.15.04 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.15.04">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.15"/>
        <iso:description>Tubes that are placed in an opening in the windpipe of a person with a laryngectomy to keep the tracheostoma open</iso:description>
        <rdfs:label>Laryngectomy tubes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.15.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.15.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.15"/>
        <iso:description>Devices for protecting an opening in the windpipe of a person from harmful external influences</iso:description>
        <rdfs:label>Tracheostoma protectors</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.15.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.15.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.15"/>
        <iso:description>Included are, e.g. lamps, brushes, pressure meters, connectors, filters, belts</iso:description>
        <rdfs:label>Accessories for tracheostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <iso:description>Devices related to the collection of bodily waste matter through an artificial opening in the intestines or the urinary tract (stoma) or through a fistula</iso:description>
        <rdfs:label>Assistive products for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.11 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.11">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>The components of effluent collection systems that are attached to the skin around the stoma or fistula allowing the attachment or removal of a bag while the component itself remains in position</iso:description>
        <rdfs:label>Plates for two-piece effluent systems for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.16 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.16">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>The components of effluent collection systems that can be removed consisting of a bag, which is either closed or drainable, for collecting bodily waste matter from a stoma or fistula
Included are, e.g. high output bags</iso:description>
        <rdfs:label>Bags for two-piece effluent systems for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.17 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.17">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Extra bags that can be connected to the bag of a stoma system to have additional capacity for collecting bodily waste</iso:description>
        <rdfs:label>Additional bags for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Systems for collecting bodily waste matter through a stoma or fistula consisting of a stoma plate for attachment on the skin around the stoma or fistula that is connected to a bag, which is either closed or drainable</iso:description>
        <rdfs:label>One-piece effluent systems for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.19 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.19">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Products that provide support in order to ensure the correct position of a stoma plate or a stoma bag in case of a parastomal herniation
Included are, e.g. belts.</iso:description>
        <rdfs:label>Assistive products for supporting and holding in place effluent systems for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.20 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.20">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Products with the purpose to attach the one-piece effluent systems or the plates of the two-piece effluent systems to the skin, to make even unevenness in the ostomy area, and to prevent leakage</iso:description>
        <rdfs:label>Filling products for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.22 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.22">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Products that are used to keep open or widen the opening through which bodily waste is drained from the intestines or the urinary tract
Included are, e.g. dilatators, hegars, ace stoppers.</iso:description>
        <rdfs:label>Assistive product for dilatating stoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Included are, e.g. products to flush the bowel via a stoma or the rectum.</iso:description>
        <rdfs:label>Assistive products for bowel irrigation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.28 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.28">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Equipment for draining or flushing an internal stoma
Included are, e.g. tubes for draining bodily waste from an internal stoma either directly into, e.g. the toilet, or connected to a bag collecting bodily waste.</iso:description>
        <rdfs:label>Assistive products for draining or flushing internal stoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.31 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.31">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Devices that protect or plug-up the stoma to protect it from harmful external influences
Included are, e.g. stoma shields, stoma plugs, special blisters.</iso:description>
        <rdfs:label>Assistive products for sealing stoma</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.48 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.48">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Bags and accessories used for post-operative purposes when creating and maintaining a stoma
Included are, e.g. sterile products.</iso:description>
        <rdfs:label>Post-operative ostomy bags and accessories</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.18.51 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.18.51">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.18"/>
        <iso:description>Included are, e.g. odour absorbents, pocket supports for ostomy bags, ostomy bag closures, products to condense bodily waste, lubricants, cotton overs.</iso:description>
        <rdfs:label>Accessories for ostomy care</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <iso:description>Products used to care for and protect the skin from injury from a variety of sources, including the use of prostheses and orthoses and the use of adhesives for ostomy care</iso:description>
        <rdfs:label>Products for skin care, skin protection, and skin cleaning</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.21"/>
        <iso:description>Substances for removing adhesive materials</iso:description>
        <rdfs:label>Adhesive solvents</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.21"/>
        <iso:description>Substances for cleaning the skin</iso:description>
        <rdfs:label>Skin detergents</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.21"/>
        <iso:description>Substances for killing germs and bacteria</iso:description>
        <rdfs:label>Disinfectants</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.21"/>
        <iso:description>Substances for completely enclosing an area of the skin</iso:description>
        <rdfs:label>Sealing materials</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.21"/>
        <iso:description>Substances that protect the skin</iso:description>
        <rdfs:label>Skin-protective agents</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.21.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.21.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.21"/>
        <rdfs:label>Callous smoothers</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09"/>
        <iso:description>Devices for draining away urine</iso:description>
        <rdfs:label>Urine diverters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <iso:description>Tubular devices inserted into the urethra to provide long-term drainage and flushing of the bladder</iso:description>
        <rdfs:label>Long-term indwelling catheters</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <iso:description>Disposable tubular devices inserted into the urethra to provide single drainage and flushing of the bladder</iso:description>
        <rdfs:label>Intermittent catheters inserted through the urethra</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <iso:description>Soft sheaths that fit over and are fixed to the penis, through which urine is drained through outlet tube that can be connected to urine collection bags
Included are, e.g. uridoms.</iso:description>
        <rdfs:label>Penile sheaths</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <iso:description>Devices to direct urine from the body into, e.g. a toilet; can be used when standing</iso:description>
        <rdfs:label>Urine chutes</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <rdfs:label>Body-worn urinals for women</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <iso:description>Included are, e.g. mirrors, labial spreaders, knee-spreading devices, insertion aids, penis support.</iso:description>
        <rdfs:label>Assistive products for self-catheterization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.24.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#09.24.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#09.24"/>
        <iso:description>Products that are worn around the penis and held firmly on the pubis by belt and straps around the waist and coupled to a urinary drainage bag</iso:description>
        <rdfs:label>Body-worn urinals for men</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#09.27 -->

