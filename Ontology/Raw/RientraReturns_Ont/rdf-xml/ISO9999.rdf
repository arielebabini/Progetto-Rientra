        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.12"/>
        <iso:description>Interface components in direct contact with the user; they transmit the forces between the orthosis and the user that result from its function and may retain the orthosis in place
Included are, e.g. shells, pads, straps, foot orthoses, shoes.</iso:description>
        <rdfs:label>Interface components for lower limb orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.12.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.12.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.12"/>
        <iso:description>Structural components in direct contact the articulating and interface components and maintain the alignment of the orthosis
Included are, e.g. uprights, shells.</iso:description>
        <rdfs:label>Structural components for lower limb orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.12.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.12.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.12"/>
        <iso:description>Cosmetic components that provide shape, colour and texture to orthoses
Included are, e.g. fillers, covers, sleeves.</iso:description>
        <rdfs:label>Finishing (cosmetic) components for lower limb orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06"/>
        <iso:description>Devices designed to compensate a loss of motor function by electrical stimulation (FES) Included are, e.g. functional electrical stimulators, hybrid orthotic systems used in combination 
with mechanical orthoses in hybrid orthotic systems.</iso:description>
        <rdfs:label>Functional neuromuscular stimulators and hybrid orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06"/>
        <iso:description>A collection of compatible components that can be integrated to produce a range of different upper limb prostheses 
Included are, e.g. cosmetic upper limb prostheses.</iso:description>
        <rdfs:label>Upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace part of the upper limb distal to the wrist joint after amputation or, due to congenital limb deficiency
Included are, e.g. finger prostheses.</iso:description>
        <rdfs:label>Partial hand prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace part of the upper limb at the wrist joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Wrist disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace part of the upper limb between the wrist and elbow joints after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Transradial prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace part of the upper limb at the elbow joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Elbow disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace part of the upper limb between the shoulder and elbow joints after amputation o r, due to congenital limb deficiency</iso:description>
        <rdfs:label>Transhumeral prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace the upper limb at the shoulder joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Shoulder disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Devices that replace the upper limb at the scapulo-thoracic and sterno-clavicular joints after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Scapulothoracic disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb; prosthetic hands are designed to substitute for some of the functions of the normal hand and can be static, passive, active or combined passive/active; the prosthetic hands can be externally powered or body powered</iso:description>
        <rdfs:label>Prosthetic hands and prosthetic digits</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.25 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.25">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb like split hooks to employ a pincer action</iso:description>
        <rdfs:label>Split hooks and other terminal devices to employ a pincer action</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.26 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.26">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that perform a wide range of individual functions; the device can be passive, adjustable or active</iso:description>
        <rdfs:label>Specialized appliances or tools for prosthetic hands</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that substitute for some of the functions of the normal wrist by means of controlled motions</iso:description>
        <rdfs:label>Wrist units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that substitute for some of the functions of the normal elbow by means of controlled motions</iso:description>
        <rdfs:label>Elbow units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that substitute for some of the functions of the normal shoulder by means of controlled motions</iso:description>
        <rdfs:label>Shoulder units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.39">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that constrain unwanted motion of the human joint(s)
Included are, e.g. wrist joints, elbow joints, shoulder joints.</iso:description>
        <rdfs:label>External (side) joints for upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.40 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.40">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses that substitute for any restriction in the range of internal/external rotation of the shoulder due to the socket of the prosthesis</iso:description>
        <rdfs:label>Humeral rotation units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.41 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.41">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Functional components of upper limb prostheses between shoulder and elbow joints in a shoulder disarticulation prosthesis to improve the effective flexion range of the elbow</iso:description>
        <rdfs:label>Additional flexion units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Interface components of upper limb prostheses that are in direct contact with the wearer for achieving support, stabilization and suspension; may contain elements that contribute to the activation and/or control of functional components Included are, e.g. sockets for partial hand amputation, wrist disarticulation, transradial (below-elbow) amputation, elbow disarticulation, transhumeral (above-elbow) amputation, shoulder disarticulation, forequarter amputation.</iso:description>
        <rdfs:label>Sockets for upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>achieving support, stabilization and suspension; may contain elements that contribute to the activation and/or control of functional components Included are, e.g. liners to be placed in sockets for partial hand amputation, wrist disarticulation, transradial (below-elbow) amputation, elbow disarticulation, transhumeral (above-elbow)
amputation, shoulder disarticulation, forequarter amputation.</iso:description>
        <rdfs:label>Liners for upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.48 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.48">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Suspensory components that are used to maintain the prosthesis relative to the body Included are, e.g. suspension components for the principal suspension sites, pelvis, trunk, shoulder(s), upper arm, humeral condyles, radial/ulnar styloids</iso:description>
        <rdfs:label>Suspensory components</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.51 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.51">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Alignment components that permit changes in the position of the components of a prosthesis relative to one another
Included are, e.g. alignment components that are part of the structure of the prosthesis or can be removed and replaced by another structural component.</iso:description>
        <rdfs:label>Alignment components of upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.54 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.54">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Structural components that connect the interface, functional and alignment components and maintain the integrity of the prosthesis.
Included are, e.g. endoskeletal and exoskeletal components for prosthetic construction</iso:description>
        <rdfs:label>Structural components of upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.18.57 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.18.57">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.18"/>
        <iso:description>Cosmetic components that simulate the appearance and feel of the normal limb
Included are, e.g. shells, fillers, skins, stockings, gloves.</iso:description>
        <rdfs:label>Finishing (cosmetic) components of upper limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06"/>
        <iso:description>A collection of compatible components that can be integrated to produce a range of different lower limb prostheses
Included are, e.g. cosmetic lower limb prostheses.</iso:description>
        <rdfs:label>Lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.03">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace part of the lower limb distal to the ankle joint after amputation or, due to congenital limb deficiency
Included are, e.g. toe prostheses.</iso:description>
        <rdfs:label>Partial foot prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.06 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.06">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace part of the lower limb at the ankle joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Ankle disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.09 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.09">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace part of the lower limb between the knee joint and the ankle joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Transtibial prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.12 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.12">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace part of the lower limb at the knee joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Knee disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.15 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.15">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace part of the lower limb between the hip joint and the knee joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Transfemoral prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.18 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.18">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace the lower limb at the hip joint after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Hip disarticulation prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.21 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.21">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices that replace the lower limb together with part or all of the hemipelvis after amputation or, due to congenital limb deficiency</iso:description>
        <rdfs:label>Transpelvic prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.27 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.27">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that substitute for some of the functions of the normal ankle and foot by means of controlled motions
Included are, e.g. separate ankle units, foot units.</iso:description>
        <rdfs:label>Ankle-foot units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that allow transverse plane rotation, thus, reducing the torque submitted</iso:description>
        <rdfs:label>Axial rotators (Torque reducers)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.31 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.31">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb which reduce the impact load resulting from initial contact by allowing longitudinal motion (shortening)</iso:description>
        <rdfs:label>Load attenuators (Shock absorbers)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.32 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.32">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb; prosthetic units that allow transverse plane rotation of the segment of the prosthesis distal to the turntable; may incorporate a lock that is automatically locked and manually unlocked in the walking position</iso:description>
        <rdfs:label>Prosthetic turntables</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.33">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that substitute for some of the functions of the normal knee by means of controlled motions</iso:description>
        <rdfs:label>Knee units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.36 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.36">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that substitute for some of the functions of the normal hip by means of controlled motions</iso:description>
        <rdfs:label>Hip units</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.37 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.37">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Functional components of lower limb prostheses that substitute for some of the dynamic and sensory attributes of the normal limb and that constrain unwanted motion of the human joint(s)
Included are, e.g. hip joints, knee joints, ankle joints.</iso:description>
        <rdfs:label>External (side) joints for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.40 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.40">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Interface components of lower limb prostheses for achieving support, stabilization and suspension; may contain elements that contribute to the activation and/or control of functional components 
Included are, e.g. prefabricated and custom-made liners to be placed in sockets for partial foot amputation, ankle disarticulation, transtibial (below knee) amputation, knee disarticulation, transfemoral (above-knee) amputation, hip disarticulation, transpelvic amputation.</iso:description>
        <rdfs:label>Liners for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.41 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.41">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Interface components of lower limb prostheses that are in direct contact with the wearer for achieving support, stabilization and suspension; may contain elements that contribute to the activation and/or control of functional components 
Included are, e.g. prefabricated and custom-made sockets for partial foot amputation, ankle
disarticulation, transtibial (below knee) amputation, knee disarticulation, transfemoral
(above-knee) amputation, hip disarticulation, transpelvic amputation.</iso:description>
        <rdfs:label>Sockets for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.42 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.42">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Interface components used to maintain the prosthesis relative to the body
Included are, e.g. suspension components for the principal suspension sites, pelvis, thigh, femoral condyles, and/or malleoli</iso:description>
        <rdfs:label>Suspensory components for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.45 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.45">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Alignment components that permit changes in the position of the components of a prosthesis relative to one another 
Included are, e.g. alignment components that are part of the structure of the prosthesis or
can be removed and replaced by another structural component.</iso:description>
        <rdfs:label>Alignment components for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.46 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.46">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Structural components that connect the interface, functional and alignment components and maintain the integrity of the prosthesis
Included are, e.g. endoskeletal and exoskeletal components for prosthetic construction.</iso:description>
        <rdfs:label>Structural components for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.47 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.47">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Cosmetic components that simulate the appearance and feel of the normal limb
Included are, e.g. shells, fillers, skins, stockings, foot covers.</iso:description>
        <rdfs:label>Finishing (cosmetic) components for lower limb prostheses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.24.48 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.24.48">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06.24"/>
        <iso:description>Devices used for the early mobilization of lower limb amputees prior to the supply of a definitive prosthesis</iso:description>
        <rdfs:label>Temporary prostheses for lower limb amputees</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.30 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.30">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06"/>
        <iso:description>Devices used to replace totally, or in part, the appearance and function of an absent body segment other than limbs</iso:description>
        <rdfs:label>Prostheses other than limb prostheses</rdfs:label>
    </owl:Class>
    


