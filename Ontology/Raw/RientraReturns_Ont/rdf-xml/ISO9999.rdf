    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.24">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.24"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <rdfs:label>Assistive products for distant communication</rdfs:label>
    </owl:Class>
    


