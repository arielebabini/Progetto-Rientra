        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#06"/>
        <iso:description>Orthoses that encompass the whole or part of the abdomen</iso:description>
        <rdfs:label>Abdominal orthoses</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#06.04.03 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#06.04.03">
