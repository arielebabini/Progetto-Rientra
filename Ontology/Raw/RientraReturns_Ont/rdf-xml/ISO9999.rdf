    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.31">
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <rdfs:label>Assistive products for learning languages</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.33 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.33">
        <owl:equivalentClass rdf:resource="http://www.stiima.cnr.it/glic#22.33"/>
        <rdfs:subClassOf rdf:resource="http://www.stiima.cnr.it/RRISO#22"/>
        <rdfs:label>Computers and terminals</rdfs:label>
    </owl:Class>
    


    <!-- http://www.stiima.cnr.it/RRISO#22.39 -->

    <owl:Class rdf:about="http://www.stiima.cnr.it/RRISO#22.39">
