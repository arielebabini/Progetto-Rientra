###  http://www.stiima.cnr.it/RientraOnt3#hasGenericMatchValue
RientraOnt3:hasGenericMatchValue rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain RientraOnt3:Match ;
                                 rdfs:range xsd:float .


###  http://www.stiima.cnr.it/RientraOnt3#hasSpecificCriticality
RientraOnt3:hasSpecificCriticality rdf:type owl:DatatypeProperty ;
                                   rdfs:domain [ rdf:type owl:Class ;
                                                 owl:unionOf ( SkAb:Abilities
                                                               SkAb:Skills
                                                             )
                                               ] ;
