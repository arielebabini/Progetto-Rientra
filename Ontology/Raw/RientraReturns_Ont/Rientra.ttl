                                     rdfs:subClassOf JobList:Job .


###  http://www.stiima.cnr.it/JobList#Bookkeping_accounting_and_auditing_clerks
JobList:Bookkeping_accounting_and_auditing_clerks rdf:type owl:Class ;
                                                  rdfs:subClassOf JobList:Job .


###  http://www.stiima.cnr.it/JobList#Cabinet_makers_and_bench_carpenters
JobList:Cabinet_makers_and_bench_carpenters rdf:type owl:Class ;
                                            rdfs:subClassOf JobList:Job ;
                                            JobList:SOC_Code "51-7011.00" ;
                                            O1:Net_job_titles "Sample of reported job titles: Cabinet Assembler, Cabinet Builder, Cabinet Installer, Cabinetmaker, Cutter, Double End Tenon Operator, Frame Builder, Framer, Machine Operator, Woodworker" ;
                                            O1:Net_short_description "Cut, shape, and assemble wooden articles or set up and operate a variety of woodworking machines, such as power saws, jointers, and mortisers to surface, cut, or shape lumber or to fabricate parts for wood products." ;
                                            rdfs:label "Cabinetmakers and Bench Carpenters" .


###  http://www.stiima.cnr.it/JobList#Construction_laborers
JobList:Construction_laborers rdf:type owl:Class ;
                              rdfs:subClassOf JobList:Job ;
                              JobList:SOC_Code "47-2061.00" ;
                              O1:Net_job_titles "Sample of reported job titles: Bituminous Asphalt Technician, Construction Laborer, Construction Worker, Drop Crew Laborer, Equipment Operator (EO), Form Setter, Post Framer, Scaffolding Operator, Site Work Laborer, Toolman" ;
                              O1:Net_short_description "Perform tasks involving physical labor at construction sites. May operate hand and power tools of all types: air hammers, earth tampers, cement mixers, small mechanical hoists, surveying and measuring equipment, and a variety of other equipment and instruments. May clean and prepare sites, dig trenches, set braces to support the sides of excavations, erect scaffolding, and clean up rubble, debris and other waste materials. May assist other craft workers." ;
                              rdfs:label "Construction laborers" .


###  http://www.stiima.cnr.it/JobList#File_clerks
JobList:File_clerks rdf:type owl:Class ;
                    rdfs:subClassOf JobList:Job ;
                    JobList:SOC_Code "43-4071.00" ;
                    O1:Net_job_titles "Sample of reported job titles: Claims Clerk, Clerk, Documentation Specialist, File Clerk, Human Resources Assistant (HR Assistant), Manufacturing Clerk, Medical Records Clerk, Office Assistant, Police Records Clerk, Records Clerk" ;
                    O1:Net_short_description "File correspondence, cards, invoices, receipts, and other records in alphabetical or numerical order or according to the filing system used. Locate and remove material from file when requested." ;
                    rdfs:label "File Clerks" .


###  http://www.stiima.cnr.it/JobList#Gem_and_diamond_workers
JobList:Gem_and_diamond_workers rdf:type owl:Class ;
                                rdfs:subClassOf JobList:Job ;
                                JobList:SOC_Code "51-9071.06" ;
                                O1:Net_job_titles "Sample of reported job titles: Diamond Cutter, Diamond Grader, Diamond Picker, Diamond Polisher, Diamond Sawer, Diamond Setter, Facetor, Gemologist, Lapidarist, Quality Control Specialist" ;
                                O1:Net_short_description "Fabricate, finish, or evaluate the quality of gems and diamonds used in jewelry or industrial tools." ;
                                rdfs:label "Gem and Diamond Workers" .


