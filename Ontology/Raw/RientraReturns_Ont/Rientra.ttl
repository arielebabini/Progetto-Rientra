JobList:Billing_cost_and_rate_clerks JobList:SOC_Code "43-3021.02" ;
                                     O1:Net_job_titles "Sample of reported job titles: Accounting Assistant, Accounting Clerk, Accounts Payable Clerk, Accounts Receivable Clerk, Administrative Assistant, Biller, Billing Clerk, Billing Coordinator, Billing Specialist, Office Manager" ;
                                     O1:Net_short_description "Compile data, compute fees and charges, and prepare invoices for billing purposes. Duties include computing costs and calculating rates for goods, services, and shipment of goods; posting data; and keeping other relevant records. May involve use of computer or typewriter, calculator, and adding and bookkeeping machines." ;
                                     rdfs:label "Billing, Cost, and Rate Clerks" .


JobList:Bookkeping_accounting_and_auditing_clerks JobList:SOC_Code "43-3031.00" ;
                                                  O1:Net_job_titles "Sample of reported job titles: Account Clerk, Accounting Assistant, Accounting Associate, Accounting Clerk, Accounting Specialist, Accounting Technician, Accounts Payable Clerk, Accounts Payable Specialist, Accounts Payables Clerk, Accounts Receivable Clerk" ;
                                                  O1:Net_short_description "Compute, classify, and record numerical data to keep financial records complete. Perform any combination of routine calculating, posting, and verifying duties to obtain primary financial data for use in maintaining accounting records. May also check the accuracy of figures, calculations, and postings pertaining to business transactions recorded by other workers." ;
                                                  rdfs:label "Bookkeeping, Accounting, and Auditing Clerks" .


JobList:Insurance_claims_clerks JobList:SOC_Code "43-9041.01" ;
                                O1:Net_job_titles "Sample of reported job titles: Call Center Representative, Claim Processing Specialist, Claim Service Representative, Claim Technician, Claims Clerk, Claims Customer Service Representative (Claims CSR), Claims Processor, Claims Representative, Claims Service Representative, Claims Technician" ;
                                O1:Net_short_description "Obtain information from insured or designated persons for purpose of settling claim with insurance carrier." ;
                                rdfs:label "Insurance Claims Clerks" .


JobList:Insurance_policy_processing_clerks JobList:SOC_Code "43-9041.02" ;
                                           O1:Net_job_titles "Process applications for, changes to, reinstatement of, and cancellation of insurance policies. Duties include reviewing insurance applications to ensure that all questions have been answered, compiling data on insurance policy changes, changing policy records to conform to insured party's specifications, compiling data on lapsed insurance policies to determine automatic reinstatement according to company policies, canceling insurance policies as requested by agents, and verifying the accuracy of insurance company records." ;
                                           O1:Net_short_description "Sample of reported job titles: Account Administrator, Agency Service Representative, Client Process Specialist, Enrollment Representative, Insurance Analyst, Policy Analyst, Policy Service Coordinator, Policy Services Representative, Premium Representative, Processing Clerk" ;
                                           rdfs:label "Insurance Policy Processing Clerks" .


JobList:Landscaping_and_Groundskeeping_Workers JobList:SOC_Code "37-3011.00" ;
                                               O1:Net_job_titles "Sample of reported job titles: Gardener, Greenskeeper, Grounds Maintenance Worker, Grounds Person, Grounds Worker, Grounds/Maintenance Specialist, Groundskeeper, Landscape Specialist, Landscape Technician, Outside Maintenance Worker" ;
                                               O1:Net_short_description "Landscape or maintain grounds of property using hand or power tools or equipment. Workers typically perform a variety of tasks, which may include any combination of the following: sod laying, mowing, trimming, planting, watering, fertilizing, digging, raking, sprinkler installation, and installation of mortarless segmental concrete masonry wall units." ;
                                               rdfs:label "Landscaping and Groundskeeping Workers" .


JobList:Postal_service_clerks JobList:SOC_Code "43-5051.00" ;
                              O1:Net_job_titles "Sample of reported job titles: Bulk Mail Technician, Clerk, Distribution Clerk, Part Time Flexible Clerk (PTF Clerk), Postal Clerk, Sales & Service Associate (SSA), Sales and Distribution Clerk, Sales and Service Associate (SSA), Window Clerk, Window/Distribution Clerk" ;
                              O1:Net_short_description "Perform any combination of tasks in a post office, such as receive letters and parcels; sell postage and revenue stamps, postal cards, and stamped envelopes; fill out and sell money orders; place mail in pigeon holes of mail rack or in bags; and examine mail for correct postage." ;
                              rdfs:label "Postal Service Clerks" .


SkAb:ActiveLearning O:Net_definition "Understanding the implications of new information for both current and future problem-solving and decision-making." .


SkAb:ActiveListening O:Net_definition "Giving full attention to what other people are saying, taking time to understand the points being made, asking questions as appropriate, and not interrupting at inappropriate times." .


SkAb:ArmHandSteadiness O:Net_definition "The ability to keep your hand and arm steady while moving your arm or while holding your arm and hand in one position." .


SkAb:AuditoryAttention O:Net_definition "The ability to focus on a single source of sound in the presence of other distracting sounds." .


SkAb:CategoryFlexibility O:Net_definition "The ability to generate or use different sets of rules for combining or grouping things in different ways." .


SkAb:ComplexProblemSolving O:Net_definition "Identifying complex problems and reviewing related information to develop and evaluate options and implement solutions." .


SkAb:ControlPrecision O:Net_definition "The ability to quickly and repeatedly adjust the controls of a machine or a vehicle to exact positions." .


SkAb:Coordination O:Net_definition "Adjusting actions in relation to others' actions." .


SkAb:CriticalThinking O:Net_definition "Using logic and reasoning to identify the strengths and weaknesses of alternative solutions, conclusions or approaches to problems." .


SkAb:DeductiveReasoning O:Net_definition "The ability to apply general rules to specific problems to produce answers that make sense." .


SkAb:DepthPerception O:Net_definition "The ability to judge which of several objects is closer or farther away from you, or to judge the distance between you and an object." .


SkAb:DynamicStrenght O:Net_definition "The ability to exert muscle force repeatedly or continuously over time. This involves muscular endurance and resistance to muscle fatigue." .


SkAb:ExplosiveStrenght O:Net_definition "The ability to use short bursts of muscle force to propel oneself (as in jumping or sprinting), or to throw an object." .


SkAb:ExtentFlexibility O:Net_definition "The ability to bend, stretch, twist, or reach with your body, arms, and/or legs." .


SkAb:FarVision O:Net_definition "The ability to see details at a distance." .


SkAb:FingerDexterity O:Net_definition "The ability to make precisely coordinated movements of the fingers of one or both hands to grasp, manipulate, or assemble very small objects." .


SkAb:FlexibilityOfClosure O:Net_definition "The ability to identify or detect a known pattern (a figure, object, word, or sound) that is hidden in other distracting material." .


SkAb:FluencyOfIdeas O:Net_definition "The ability to come up with a number of ideas about a topic (the number of ideas is important, not their quality, correctness, or creativity)." .


SkAb:GlareSensitivity O:Net_definition "The ability to see objects in the presence of glare or bright lighting." .


SkAb:GrossBodyCoordination O:Net_definition "The ability to coordinate the movement of your arms, legs, and torso together when the whole body is in motion." .


SkAb:GrossBodyEquilibrium O:Net_definition "The ability to keep or regain your body balance or stay upright when in an unstable position." .


SkAb:HearingSensitivity O:Net_definition "The ability to detect or tell the differences between sounds that vary in pitch and loudness." .


SkAb:InductiveReasoning O:Net_definition "The ability to combine pieces of information to form general rules or conclusions (includes finding a relationship among seemingly unrelated events)." .


SkAb:InformationOrdering O:Net_definition "The ability to arrange things or actions in a certain order or pattern according to a specific rule or set of rules (e.g., patterns of numbers, letters, words, pictures, mathematical operations)." .


SkAb:Instructing O:Net_definition "Teaching others how to do something." .


SkAb:JudgmentAndDecisionMaking O:Net_definition "Considering the relative costs and benefits of potential actions to choose the most appropriate one." .


SkAb:LearningStrategies O:Net_definition "Selecting and using training/instructional methods and procedures appropriate for the situation when learning or teaching new things." .


SkAb:ManualDexterity O:Net_definition "The ability to quickly move your hand, your hand together with your arm, or your two hands to grasp, manipulate, or assemble objects." .


SkAb:MathematicalReasoning O:Net_definition "The ability to choose the right mathematical methods or formulas to solve a problem." .


SkAb:Mathematics O:Net_definition "Using mathematics to solve problems." .


SkAb:Memorization O:Net_definition "The ability to remember information such as words, numbers, pictures, and procedures." .


SkAb:Monitoring O:Net_definition "Monitoring/Assessing performance of yourself, other individuals, or organizations to make improvements or take corrective action." .


SkAb:MultilimbCoordination O:Net_definition "The ability to coordinate two or more limbs (for example, two arms, two legs, or one leg and one arm) while sitting, standing, or lying down. It does not involve performing the activities while the whole body is in motion." .


SkAb:NearVision O:Net_definition "The ability to see details at close range (within a few feet of the observer)." .


SkAb:Negotiation O:Net_definition "Bringing others together and trying to reconcile differences." .


SkAb:NightVision O:Net_definition "The ability to see under low light conditions." .


SkAb:NumberFacility O:Net_definition "The ability to add, subtract, multiply, or divide quickly and correctly." .


SkAb:OralComprehension O:Net_definition "The ability to listen to and understand information and ideas presented through spoken words and sentences." .


SkAb:OralExpression O:Net_definition "The ability to communicate information and ideas in speaking so others will understand." .


SkAb:Originality O:Net_definition "The ability to come up with unusual or clever ideas about a given topic or situation, or to develop creative ways to solve a problem." .


SkAb:PerceptualSpeed O:Net_definition "The ability to quickly and accurately compare similarities and differences among sets of letters, numbers, objects, pictures, or patterns. The things to be compared may be presented at the same time or one after the other. This ability also includes comparing a presented object with a remembered object." .


SkAb:PeripheralVision O:Net_definition "The ability to see objects or movement of objects to one's side when the eyes are looking ahead." .


SkAb:Persuasion O:Net_definition "Persuading others to change their minds or behavior." .


SkAb:ProblemSensitivity O:Net_definition "The ability to tell when something is wrong or is likely to go wrong. It does not involve solving the problem, only recognizing there is a problem." .


SkAb:RateControl O:Net_definition "The ability to time your movements or the movement of a piece of equipment in anticipation of changes in the speed and/or direction of a moving object or scene." .


SkAb:ReactionTime O:Net_definition "The ability to quickly respond (with the hand, finger, or foot) to a signal (sound, light, picture) when it appears." .


SkAb:ReadingComprehension O:Net_definition "Understanding written sentences and paragraphs in work related documents." .


SkAb:ResponseOrientation O:Net_definition "The ability to choose quickly between two or more movements in response to two or more different signals (lights, sounds, pictures). It includes the speed with which the correct response is started with the hand, foot, or other body part." .


SkAb:Science O:Net_definition "Using scientific rules and methods to solve problems." .


SkAb:SelectiveAttention O:Net_definition "The ability to concentrate on a task over a period of time without being distracted." .


SkAb:ServiceOrientation O:Net_definition "Actively looking for ways to help people." .


SkAb:SoundLocalization O:Net_definition "The ability to tell the direction from which a sound originated." .


SkAb:SpatialOrientation O:Net_definition "The ability to know your location in relation to the environment or to know where other objects are in relation to you." .


SkAb:Speaking O:Net_definition "Talking to others to convey information effectively." .


SkAb:SpeechClarity O:Net_definition "The ability to speak clearly so others can understand you." .


SkAb:SpeechRecognition O:Net_definition "The ability to identify and understand the speech of another person." .


SkAb:SpeedOfClosure O:Net_definition "The ability to quickly make sense of, combine, and organize information into meaningful patterns." .


SkAb:SpeedOfLimbMovement O:Net_definition "The ability to quickly move the arms and legs." .


SkAb:Stamina O:Net_definition "The ability to exert yourself physically over long periods of time without getting winded or out of breath." .


SkAb:StaticStrenght O:Net_definition "The ability to exert maximum muscle force to lift, push, pull, or carry objects." .


SkAb:SystemAnalysis O:Net_definition "Determining how a system should work and how changes in conditions, operations, and the environment will affect outcomes." .


SkAb:SystemEvaluation O:Net_definition "Identifying measures or indicators of system performance and the actions needed to improve or correct performance, relative to the goals of the system." .


SkAb:TimeManagement O:Net_definition "Managing one's own time and the time of others." .


SkAb:TimeSharing O:Net_definition "The ability to shift back and forth between two or more activities or sources of information (such as speech, sounds, touch, or other sources)." .


SkAb:TrunkStrenght O:Net_definition "The ability to use your abdominal and lower back muscles to support part of the body repeatedly or continuously over time without 'giving out' or fatiguing." .


SkAb:VisualColorDiscrimination O:Net_definition "The ability to match or detect differences between colors, including shades of color and brightness." .


SkAb:Visualization O:Net_definition "The ability to imagine how something will look after it is moved around or when its parts are moved or rearranged." .


SkAb:WristFingerSpeed O:Net_definition "The ability to make fast, simple, repeated movements of the fingers, hands, and wrists." .


SkAb:Writing O:Net_definition "Communicating effectively in writing as appropriate for the needs of the audience." .


SkAb:WrittenComprehension O:Net_definition "The ability to read and understand information and ideas presented in writing." .


SkAb:WrittenExpression O:Net_definition "The ability to communicate information and ideas in writing so others will understand." .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ICF-exc-coreset:Activities_and_participation
                ICF-exc-coreset:Body_functions
                ICF-exc-coreset:Body_structures
              )
] .


#################################################################
#    Rules
#################################################################

<urn:swrl#p> rdf:type swrl:Variable .

<urn:swrl#m> rdf:type swrl:Variable .

<urn:swrl#j> rdf:type swrl:Variable .

<urn:swrl:var#icf> rdf:type swrl:Variable .

<urn:swrl:var#des> rdf:type swrl:Variable .

<urn:swrl:var#hc> rdf:type swrl:Variable .

<urn:swrl:var#skab> rdf:type swrl:Variable .

<urn:swrl:var#job> rdf:type swrl:Variable .

<urn:swrl:var#p> rdf:type swrl:Variable .

<urn:swrl:var#jde> rdf:type swrl:Variable .

<urn:swrl:var#res> rdf:type swrl:Variable .

<urn:swrl:var#x> rdf:type swrl:Variable .

<urn:swrl#jd> rdf:type swrl:Variable .

<urn:swrl#sa> rdf:type swrl:Variable .

<urn:swrl#x> rdf:type swrl:Variable .

[ rdf:type swrl:Imp ;
   swrl:body [ rdf:type swrl:AtomList ;
               rdf:first [ rdf:type swrl:ClassAtom ;
                           swrl:classPredicate ICF-exc-coreset:ICF ;
                           swrl:argument1 <urn:swrl:var#icf>
                         ] ;
               rdf:rest [ rdf:type swrl:AtomList ;
                          rdf:first [ rdf:type swrl:ClassAtom ;
                                      swrl:classPredicate RientraHC:HC_Descriptor ;
                                      swrl:argument1 <urn:swrl:var#des>
                                    ] ;
                          rdf:rest [ rdf:type swrl:AtomList ;
                                     rdf:first [ rdf:type swrl:ClassAtom ;
                                                 swrl:classPredicate RientraHC:Health_Condition ;
                                                 swrl:argument1 <urn:swrl:var#hc>
                                               ] ;
