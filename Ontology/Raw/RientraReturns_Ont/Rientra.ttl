###  http://www.stiima.cnr.it/JobList#Job
JobList:Job rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty JobList:requires ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass JobList:Job_Descriptor
                                ] .


###  http://www.stiima.cnr.it/JobList#Job_Descriptor
JobList:Job_Descriptor rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty JobList:concerns ;
                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass [ rdf:type owl:Class ;
                                                           owl:unionOf ( SkAb:Abilities
                                                                         SkAb:Skills
                                                                       )
                                                         ]
