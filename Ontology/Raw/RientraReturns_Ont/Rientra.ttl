@prefix : <http://www.stiima.cnr.it/RientraOnt3Merged#> .
@prefix O: <http://www.stiima.cnr.it/SkAb#O*> .
@prefix O1: <http://www.stiima.cnr.it/JobList#O*> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rie: <http://www.stiima.cnr.it/RientraOnt3Merged#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix SkAb: <http://www.stiima.cnr.it/SkAb#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix JobList: <http://www.stiima.cnr.it/JobList#> .
@prefix RientraHC: <http://www.stiima.cnr.it/RientraHC#> .
@prefix RientraOnt3: <http://www.stiima.cnr.it/RientraOnt3#> .
@prefix translatesO: <http://www.stiima.cnr.it/SkAb#translatesO*> .
@prefix FOAF-excerpt: <http://www.stiima.cnr.it/FOAF-excerpt#> .
@prefix JobDescription: <http://www.stiima.cnr.it/JobDescription#> .
@prefix ICF-exc-coreset: <http://www.stiima.cnr.it/ICF-exc-coreset#> .
@prefix Person-CommonBox: <http://www.stiima.cnr.it/Person-CommonBox#> .
@base <http://www.stiima.cnr.it/RientraOnt3Merged#> .

<http://www.stiima.cnr.it/RientraReturns> rdf:type owl:Ontology ;
                                           rdfs:comment """A box importing:
- JobList
- SkAb for the full description and translation of Jobs with ICF.

Developed for \"Rientr@\" ontology by STIIMA-CNR.""" ,
                                                        """Added professions:
- Dancers
- Travel guides
- Receptionists and Information Clerks
- Insurance policy processing Clerks
- Insurance Claims Clerks
- Billing, cost and rate Clerks
- Bookkeeping, Accounting, and Auditing Clerks

On February 2022.""" ,
                                                        """An excerpt od Friend Of a Friend (FOAF) ontology for people's description.
Developed for \"Rientr@\" ontology by STIIMA-CNR.

Full FOAF: http://xmlns.com/foaf/spec/""" ,
                                                        "Based on Standard Occupation Classification (2016 version) available on O*NET web site: https://www.onetonline.org/" ,
                                                        """Common Box for Person description importing:
- Health Condition (RientraHC)
- FOAF (FOAF-excerpt)
- ICF (excerpt and core sets)""" ,
                                                        """Developed on: 29 November 2021.
Latest revision: 30 april 2024.
Version: 3.1.""" ,
                                                        """Excerpt of ICF developend for the \"Rientr@\" project by STIIMA-CNR.
It contains the classes composing:
- Traumatic Brain Injury comprehensive core set
- Spinal Cord Injury (Long Term/Chronic) comprehensive core set
- Stroke comprehensive core set
- Vocational Rehabilitation comprehensive core set
- Codes description, Inclusion and Exclusions added

Full ICF ontology: https://www.bioportal.bioontology.org/ontologies/ICF (updated May 2012).""" ,
                                                        """Excerpt of O*NET \"Skills\" and \"Abilities\" for descriptions of jobs.
Developed for \"Rientr@\" ontology by STIIMA-CNR.""" ,
                                                        """Health Condition Ontology for modelling wheelchair users' health conditions.
Developed for \"Rientr@\" ontology by STIIMA-CNR.""" ,
                                                        """List of jobs to be matched with the wheelchair users.
Developed for \"Rientr@\" ontology by STIIMA-CNR.""" ,
                                                        """Revised on 08 June 2020.
Translation of O*NET in ICF deeply revised (elimination of the \"translator\" individuals and classes):
- SWRL \"matrix\" revision: specific scores for Skills and Abilities according to the new version of the matrix (Risk factor);
- 8 new SWRL rules deployed.""" ,
                                                        """Rientra Ontology importing:

1. Person ontology (Common Box), which imports:
      a) Health Conditions (RientraHC)
      b) FOAF (FOAF excerpt)
      c) ICF (excerpt and core sets)

2. Job Description (Common Box), which imports:
      d) Job List
      e) Skills and Abilities (SkAb)""" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.stiima.cnr.it/ICF-exc-coreset#description
ICF-exc-coreset:description rdf:type owl:AnnotationProperty .


###  http://www.stiima.cnr.it/ICF-exc-coreset#descrizioneITA
ICF-exc-coreset:descrizioneITA rdf:type owl:AnnotationProperty .


###  http://www.stiima.cnr.it/ICF-exc-coreset#nomeIta
ICF-exc-coreset:nomeIta rdf:type owl:AnnotationProperty .


###  http://www.stiima.cnr.it/JobList#SOC_Code
JobList:SOC_Code rdf:type owl:AnnotationProperty .


###  http://www.stiima.cnr.it/JobList#O*Net_job_titles
O1:Net_job_titles rdf:type owl:AnnotationProperty .


###  http://www.stiima.cnr.it/JobList#O*Net_short_description
O1:Net_short_description rdf:type owl:AnnotationProperty .


###  http://www.stiima.cnr.it/SkAb#O*Net_definition
O:Net_definition rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.stiima.cnr.it/JobDescription#isImportantFor
JobDescription:isImportantFor rdf:type owl:ObjectProperty ;
                              rdfs:domain SkAb:Abilities ,
                                          SkAb:Skills ;
                              rdfs:range JobList:Job .


###  http://www.stiima.cnr.it/JobDescription#isLessImportantFor
JobDescription:isLessImportantFor rdf:type owl:ObjectProperty ;
                                  rdfs:domain SkAb:Abilities ,
                                              SkAb:Skills ;
                                  rdfs:range JobList:Job .


###  http://www.stiima.cnr.it/JobDescription#isSlightlyCriticalFor
JobDescription:isSlightlyCriticalFor rdf:type owl:ObjectProperty ;
                                     rdfs:domain SkAb:Abilities ,
                                                 SkAb:Skills .


###  http://www.stiima.cnr.it/JobDescription#isSomewhatImportantFor
JobDescription:isSomewhatImportantFor rdf:type owl:ObjectProperty ;
                                      rdfs:domain SkAb:Abilities ,
                                                  SkAb:Skills ;
                                      rdfs:range JobList:Job .


###  http://www.stiima.cnr.it/JobDescription#isVeryImportantFor
JobDescription:isVeryImportantFor rdf:type owl:ObjectProperty ;
                                  rdfs:domain SkAb:Abilities ,
                                              SkAb:Skills ;
                                  rdfs:range JobList:Job .


###  http://www.stiima.cnr.it/JobList#concerns
JobList:concerns rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain JobList:Job_Descriptor ;
                 rdfs:range SkAb:Abilities ,
                            SkAb:Skills .


###  http://www.stiima.cnr.it/JobList#requires
JobList:requires rdf:type owl:ObjectProperty ;
                 rdfs:domain JobList:Job ;
                 rdfs:range JobList:Job_Descriptor .


###  http://www.stiima.cnr.it/RientraHC#involvesICFCode
RientraHC:involvesICFCode rdf:type owl:ObjectProperty ;
                          rdfs:domain RientraHC:HC_Descriptor ;
                          rdfs:range ICF-exc-coreset:ICF .


###  http://www.stiima.cnr.it/RientraHC#isDescribedBy
RientraHC:isDescribedBy rdf:type owl:ObjectProperty ;
                        rdfs:domain RientraHC:Health_Condition ;
                        rdfs:range RientraHC:HC_Descriptor .


###  http://www.stiima.cnr.it/RientraHC#isInHealthCondition
RientraHC:isInHealthCondition rdf:type owl:ObjectProperty ;
                              rdfs:domain FOAF-excerpt:Person ;
                              rdfs:range RientraHC:Health_Condition .


###  http://www.stiima.cnr.it/RientraOnt3#hasExtremeCriticalityIn
RientraOnt3:hasExtremeCriticalityIn rdf:type owl:ObjectProperty ;
                                    owl:inverseOf RientraOnt3:isExtremelyCriticalFor .


###  http://www.stiima.cnr.it/RientraOnt3#hasMatch
RientraOnt3:hasMatch rdf:type owl:ObjectProperty ;
                     rdfs:domain FOAF-excerpt:Person ;
                     rdfs:range RientraOnt3:Match .


###  http://www.stiima.cnr.it/RientraOnt3#hasModerateCriticalityIn
RientraOnt3:hasModerateCriticalityIn rdf:type owl:ObjectProperty ;
                                     owl:inverseOf RientraOnt3:isModeratelyCriticalFor .


###  http://www.stiima.cnr.it/RientraOnt3#hasNoCriticalityIn
RientraOnt3:hasNoCriticalityIn rdf:type owl:ObjectProperty ;
                               owl:inverseOf RientraOnt3:isNotCriticalFor .


###  http://www.stiima.cnr.it/RientraOnt3#hasRelevantCriticalityIn
RientraOnt3:hasRelevantCriticalityIn rdf:type owl:ObjectProperty ;
                                     owl:inverseOf RientraOnt3:isRelevantlyCriticalFor .


###  http://www.stiima.cnr.it/RientraOnt3#hasSlightCriticalityIn
RientraOnt3:hasSlightCriticalityIn rdf:type owl:ObjectProperty ;
                                   owl:inverseOf RientraOnt3:isSlightlyCriticalFor .


###  http://www.stiima.cnr.it/RientraOnt3#isEvaluatedForJob
RientraOnt3:isEvaluatedForJob rdf:type owl:ObjectProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain FOAF-excerpt:Person ;
                              rdfs:range JobList:Job ;
                              rdfs:comment "Connects a person to a profession for which the person's health condition is being evaluated." .


###  http://www.stiima.cnr.it/RientraOnt3#isExtremelyCriticalFor
RientraOnt3:isExtremelyCriticalFor rdf:type owl:ObjectProperty ;
                                   rdfs:domain SkAb:Abilities ,
                                               SkAb:Skills ;
                                   rdfs:range FOAF-excerpt:Person ;
                                   rdfs:comment "Describe which O*NET-SOC Skill or Ability is extremely critical for a person being evaluated in a specific profession." .


###  http://www.stiima.cnr.it/RientraOnt3#isModeratelyCriticalFor
RientraOnt3:isModeratelyCriticalFor rdf:type owl:ObjectProperty ;
                                    rdfs:domain SkAb:Abilities ,
                                                SkAb:Skills ;
                                    rdfs:range FOAF-excerpt:Person ;
                                    rdfs:comment "Describe which O*NET-SOC Skill or Ability has a moderate criticality for a person being evaluated in a specific profession." .


###  http://www.stiima.cnr.it/RientraOnt3#isNotCriticalFor
RientraOnt3:isNotCriticalFor rdf:type owl:ObjectProperty ;
                             rdfs:domain SkAb:Abilities ,
                                         SkAb:Skills ;
                             rdfs:range FOAF-excerpt:Person ;
                             rdfs:comment "Describe which O*NET-SOC Skill or Ability presents no criticality for a person being evaluated in a specific profession." .


###  http://www.stiima.cnr.it/RientraOnt3#isRelevantlyCriticalFor
RientraOnt3:isRelevantlyCriticalFor rdf:type owl:ObjectProperty ;
                                    rdfs:domain SkAb:Abilities ,
                                                SkAb:Skills ;
                                    rdfs:range FOAF-excerpt:Person ;
                                    rdfs:comment "Describe which O*NET-SOC Skill or Ability has a relevant criticality for a person being evaluated in a specific profession." .


###  http://www.stiima.cnr.it/RientraOnt3#isSlightlyCriticalFor
RientraOnt3:isSlightlyCriticalFor rdf:type owl:ObjectProperty ;
                                  rdfs:domain SkAb:Abilities ,
                                              SkAb:Skills ;
                                  rdfs:range FOAF-excerpt:Person ;
                                  rdfs:comment "Describe which O*NET-SOC Skill or Ability is slightly critical for a person being evaluated in a specific profession." .


###  http://www.stiima.cnr.it/RientraOnt3#matchedJob
RientraOnt3:matchedJob rdf:type owl:ObjectProperty ;
                       rdfs:domain RientraOnt3:Match ;
                       rdfs:range JobList:Job .


###  http://www.stiima.cnr.it/SkAb#isTranslatedWithICFCode
SkAb:isTranslatedWithICFCode rdf:type owl:ObjectProperty ;
                             owl:inverseOf translatesO:NET-SOC_SkAb ;
                             rdfs:domain SkAb:Abilities ,
                                         SkAb:Skills ;
                             rdfs:range ICF-exc-coreset:ICF .


###  http://www.stiima.cnr.it/SkAb#translatesO*NET-SOC_SkAb
translatesO:NET-SOC_SkAb rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.stiima.cnr.it/FOAF-excerpt#TIN
FOAF-excerpt:TIN rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain FOAF-excerpt:Person ;
                 rdfs:range xsd:string .


###  http://www.stiima.cnr.it/FOAF-excerpt#ZIPcode
FOAF-excerpt:ZIPcode rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain FOAF-excerpt:Person ;
                     rdfs:range xsd:int .


###  http://www.stiima.cnr.it/FOAF-excerpt#birthday
FOAF-excerpt:birthday rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain FOAF-excerpt:Person ;
                      rdfs:range xsd:dateTime .


###  http://www.stiima.cnr.it/FOAF-excerpt#city
FOAF-excerpt:city rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain FOAF-excerpt:Person ;
                  rdfs:range xsd:string .


###  http://www.stiima.cnr.it/FOAF-excerpt#country
FOAF-excerpt:country rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain FOAF-excerpt:Person ;
                     rdfs:range xsd:string .


###  http://www.stiima.cnr.it/FOAF-excerpt#first_name
FOAF-excerpt:first_name rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain FOAF-excerpt:Person ;
                        rdfs:range xsd:string .


###  http://www.stiima.cnr.it/FOAF-excerpt#surname
FOAF-excerpt:surname rdf:type owl:DatatypeProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain FOAF-excerpt:Person ;
                     rdfs:range xsd:string .


###  http://www.stiima.cnr.it/JobList#hasScore
JobList:hasScore rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain JobList:Job_Descriptor ;
                 rdfs:range xsd:int .


###  http://www.stiima.cnr.it/RientraHC#AP1qual
RientraHC:AP1qual rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain RientraHC:HC_Descriptor ;
                  rdfs:range [ rdf:type rdfs:Datatype ;
                               owl:oneOf [ rdf:type rdf:List ;
                                           rdf:first 0 ;
                                           rdf:rest [ rdf:type rdf:List ;
                                                      rdf:first 1 ;
                                                      rdf:rest [ rdf:type rdf:List ;
                                                                 rdf:first 2 ;
                                                                 rdf:rest [ rdf:type rdf:List ;
                                                                            rdf:first 3 ;
                                                                            rdf:rest [ rdf:type rdf:List ;
                                                                                       rdf:first 4 ;
                                                                                       rdf:rest [ rdf:type rdf:List ;
                                                                                                  rdf:first 8 ;
                                                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                                                             rdf:first 9 ;
                                                                                                             rdf:rest rdf:nil
                                                                                                           ]
                                                                                                ]
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ]
                             ] .


